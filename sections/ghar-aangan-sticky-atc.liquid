{%- if request.page_type == 'product' and product.available -%}
  {%- assign current_variant = product.selected_or_first_available_variant -%}
  
  {%- style -%}
    .ga-sticky-atc-bar {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      background: #ffffff;
      box-shadow: 0 -4px 20px rgba(26, 51, 44, 0.12);
      border-top: 1.5px solid var(--ga-gold-cream, #cda250);
      z-index: 9999;
      transform: translateY(110%);
      transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
      padding: 0.9rem 1.6rem;
      pointer-events: none;
    }

    .ga-sticky-atc-bar.is-visible {
      transform: translateY(0);
      pointer-events: auto;
    }

    .ga-sticky-atc-container {
      max-width: 1200px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1.2rem;
    }

    .ga-sticky-atc-left {
      display: flex;
      align-items: center;
      gap: 1.2rem;
      min-width: 0;
    }

    .ga-sticky-atc-img {
      width: 4.4rem;
      height: 4.4rem;
      object-fit: cover;
      border-radius: 6px;
      border: 1px solid rgba(26, 51, 44, 0.1);
      flex-shrink: 0;
      background: #faf8f5;
    }

    .ga-sticky-atc-meta {
      display: flex;
      flex-direction: column;
      min-width: 0;
    }

    .ga-sticky-atc-title {
      font-family: var(--ga-font-family-serif, serif);
      font-size: 1.4rem;
      font-weight: 600;
      color: var(--ga-forest-green, #1a332c);
      margin: 0;
      line-height: 1.2;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      max-width: 320px;
    }

    .ga-sticky-atc-price-row {
      display: flex;
      align-items: center;
      gap: 0.8rem;
      margin-top: 0.2rem;
    }

    .ga-sticky-atc-price {
      font-size: 1.45rem;
      font-weight: 700;
      color: var(--ga-forest-green, #1a332c);
    }

    .ga-sticky-atc-tag {
      font-size: 1.05rem;
      font-weight: 700;
      color: #16a34a;
      background: rgba(22, 163, 74, 0.1);
      padding: 0.1rem 0.6rem;
      border-radius: 10px;
      white-space: nowrap;
    }

    .ga-sticky-atc-actions {
      display: flex;
      align-items: center;
      gap: 0.8rem;
      flex-shrink: 0;
    }

    .ga-sticky-atc-select {
      font-family: var(--ga-font-family-sans, sans-serif);
      font-size: 1.25rem;
      padding: 0.8rem 2.8rem 0.8rem 1.2rem;
      border: 1.5px solid rgba(26, 51, 44, 0.15);
      border-radius: 6px;
      background: #faf8f5;
      color: #1a332c;
      font-weight: 600;
      cursor: pointer;
      appearance: none;
      -webkit-appearance: none;
      background-image: url("data:image/svg+xml;utf8,<svg fill='%231a332c' height='20' viewBox='0 0 24 24' width='20' xmlns='http://www.w3.org/2000/svg'><path d='M7 10l5 5 5-5z'/></svg>");
      background-repeat: no-repeat;
      background-position: right 0.8rem center;
    }

    .ga-sticky-btn-buy {
      background-color: var(--ga-forest-green, #1a332c) !important;
      color: #ffffff !important;
      font-family: var(--ga-font-family-sans, sans-serif);
      font-weight: 700;
      font-size: 1.3rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      padding: 1.1rem 2.2rem;
      border-radius: 6px;
      border: 1px solid var(--ga-forest-green, #1a332c);
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      transition: all 0.2s ease;
      white-space: nowrap;
      box-shadow: 0 4px 12px rgba(26, 51, 44, 0.2);
    }

    .ga-sticky-btn-buy:hover {
      background-color: #284c42 !important;
      transform: translateY(-1px);
    }

    @media screen and (max-width: 640px) {
      .ga-sticky-atc-bar {
        padding: 0.7rem 1rem;
      }
      .ga-sticky-atc-title {
        max-width: 140px;
        font-size: 1.25rem;
      }
      .ga-sticky-atc-tag {
        display: none;
      }
      .ga-sticky-atc-price {
        font-size: 1.35rem;
      }
      .ga-sticky-atc-select {
        display: none; /* Hide secondary select on small phones to maximize Buy Now thumb tap target */
      }
      .ga-sticky-btn-buy {
        padding: 1.1rem 1.8rem;
        font-size: 1.25rem;
        flex-grow: 1;
        justify-content: center;
      }
    }
  {%- endstyle -%}

  <div id="GharAanganStickyBar" class="ga-sticky-atc-bar">
    <div class="ga-sticky-atc-container">
      <div class="ga-sticky-atc-left">
        {%- if product.featured_image != blank -%}
          <img class="ga-sticky-atc-img" src="{{ product.featured_image | image_url: width: 100 }}" alt="{{ product.title | escape }}" width="44" height="44" loading="lazy">
        {%- endif -%}
        <div class="ga-sticky-atc-meta">
          <span class="ga-sticky-atc-title">{{ product.title }}</span>
          <div class="ga-sticky-atc-price-row">
            <span class="ga-sticky-atc-price" id="GaStickyPrice">{{ current_variant.price | money }}</span>
            <span class="ga-sticky-atc-tag">Prepaid: FREE Express</span>
          </div>
        </div>
      </div>

      <div class="ga-sticky-atc-actions">
        <input type="hidden" id="GaStickyVariantId" value="{{ current_variant.id }}">
        
        {%- if product.variants.size > 1 -%}
          <select class="ga-sticky-atc-select" id="GaStickyVariantSelector" aria-label="Select variant">
            {%- for variant in product.variants -%}
              <option 
                value="{{ variant.id }}" 
                data-price="{{ variant.price | money }}"
                {% if variant == current_variant %}selected="selected"{% endif %}
                {% unless variant.available %}disabled="disabled"{% endunless %}
              >
                {{ variant.title }} ({{ variant.price | money }})
              </option>
            {%- endfor -%}
          </select>
        {%- endif -%}

        <button 
          type="button" 
          class="ga-sticky-btn-buy" 
          id="GaStickyBuyBtn"
          onclick="(function(btn){
            var variantId = document.getElementById('GaStickyVariantId').value;
            btn.classList.add('is-loading');
            btn.innerHTML = '<span>⚡ Opening Checkout...</span>';
            if (window.GharAanganAnalytics) {
              window.GharAanganAnalytics.trackEvent('cro_sticky_buy_click', {
                variant_id: variantId
              });
            }
            fetch('/cart/add.js', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ items: [{ id: parseInt(variantId), quantity: 1 }] })
            }).then(function() {
              window.location.href = '/checkout';
            }).catch(function() {
              window.location.href = '/checkout';
            });
          })(this);"
        >
          <span>⚡ BUY NOW</span>
        </button>
      </div>
    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const stickyBar = document.getElementById('GharAanganStickyBar');
      const variantSelector = document.getElementById('GaStickyVariantSelector');
      const hiddenInput = document.getElementById('GaStickyVariantId');
      const priceDisplay = document.getElementById('GaStickyPrice');

      if (variantSelector) {
        variantSelector.addEventListener('change', function(e) {
          const opt = e.target.options[e.target.selectedIndex];
          if (hiddenInput) hiddenInput.value = e.target.value;
          if (priceDisplay && opt.getAttribute('data-price')) {
            priceDisplay.textContent = opt.getAttribute('data-price');
          }
        });
      }

      // Show sticky bar once scrolled past the above-the-fold purchase area
      const targetAnchor = document.querySelector('.hdt-main-product-wrap, .ga-buy-buttons-enhanced, form[action*="/cart/add"]');
      if (targetAnchor && stickyBar) {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (!entry.isIntersecting) {
              stickyBar.classList.add('is-visible');
            } else {
              stickyBar.classList.remove('is-visible');
            }
          });
        }, { threshold: 0.1 });
        observer.observe(targetAnchor);
      } else if (stickyBar) {
        window.addEventListener('scroll', function() {
          if (window.scrollY > 450) {
            stickyBar.classList.add('is-visible');
          } else {
            stickyBar.classList.remove('is-visible');
          }
        }, { passive: true });
      }
    });
  </script>
{%- endif -%}

{% schema %}
{
  "name": "GA Sticky ATC Bar",
  "tag": "section",
  "class": "section-sticky-atc",
  "settings": [],
  "presets": [
    {
      "name": "GA Sticky ATC Bar"
    }
  ]
}
{% endschema %}
