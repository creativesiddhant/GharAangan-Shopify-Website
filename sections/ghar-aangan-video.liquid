<!-- sections/ghar-aangan-video.liquid -->
{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .ga-video-section-header {
    text-align: center;
    max-width: 70rem;
    margin: 0 auto clamp(2.5rem, 5vw, 4.5rem) auto;
    padding: 0 2rem;
  }

  .ga-video-section-header .ga-body {
    margin-top: 1.2rem;
    font-size: 1.55rem;
    line-height: 1.65;
    color: var(--ga-dark-text);
    font-weight: 300;
  }

  .ga-video-outer {
    width: 100%;
    padding: 0 2rem;
    display: flex;
    justify-content: center;
  }

  .ga-video-wrapper {
    width: 100%;
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    border: 1.5px solid var(--ga-gold-cream);
    box-shadow: var(--ga-card-shadow);
    transition: var(--ga-transition-smooth);
    background-color: #0c1412;
  }

  .ga-video-wrapper:hover {
    transform: translateY(-6px);
    box-shadow: 0 25px 45px rgba(26, 51, 44, 0.08);
    border-color: var(--ga-forest-green);
  }

  /* Aspect Ratios */
  .ga-video-ratio-16_9 {
    aspect-ratio: 16 / 9;
  }
  .ga-video-ratio-9_16 {
    aspect-ratio: 9 / 16;
  }
  .ga-video-ratio-4_3 {
    aspect-ratio: 4 / 3;
  }
  .ga-video-ratio-1_1 {
    aspect-ratio: 1 / 1;
  }

  /* Desktop Widths */
  .ga-video-width-small {
    max-width: 380px;
  }
  .ga-video-width-medium {
    max-width: 580px;
  }
  .ga-video-width-large {
    max-width: 900px;
  }
  .ga-video-width-full {
    max-width: 1200px;
  }

  /* Make sure video scales inside the aspect ratio wrapper */
  .ga-video-wrapper iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: none;
    pointer-events: none; /* Prevents direct clicking on YouTube player to keep custom control styling active */
  }

  /* Glassmorphism Control Bar Overlay */
  .ga-video-controls {
    position: absolute;
    bottom: 20px;
    right: 20px;
    display: flex;
    gap: 8px;
    z-index: 10;
    background: rgba(26, 51, 44, 0.78);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.12);
    padding: 8px 12px;
    border-radius: 30px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
    opacity: 0.85;
    transform: translateY(0);
    transition: var(--ga-transition-smooth);
  }

  /* Subtle micro-animation to show and highlight controls on desktop hover */
  @media screen and (min-width: 990px) {
    .ga-video-controls {
      opacity: 0;
      transform: translateY(8px);
    }
    .ga-video-wrapper:hover .ga-video-controls {
      opacity: 0.95;
      transform: translateY(0);
    }
  }

  .ga-video-control-btn {
    background: none;
    border: none;
    color: #ffffff;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .ga-video-control-btn:hover {
    background: rgba(255, 255, 255, 0.15);
    color: var(--ga-gold-ghee);
    transform: scale(1.12);
  }

  .ga-video-control-btn svg {
    width: 18px;
    height: 18px;
    fill: currentColor;
  }
{%- endstyle -%}

<div id="ga-video-section-{{ section.id }}" class="section-{{ section.id }}-padding" style="background-color: {{ section.settings.background_color }};">
  <div class="page-width">
    {%- if section.settings.header_title != blank or section.settings.header_subtitle != blank -%}
      <div class="ga-video-section-header">
        {%- if section.settings.header_subtitle != blank -%}
          <span class="ga-subtitle">{{ section.settings.header_subtitle | escape }}</span>
        {%- endif -%}
        {%- if section.settings.header_title != blank -%}
          <h2 class="ga-title">{{ section.settings.header_title | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.header_description != blank -%}
          <p class="ga-body">{{ section.settings.header_description | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="ga-video-outer">
      <div class="ga-video-wrapper ga-video-ratio-{{ section.settings.video_aspect_ratio }} ga-video-width-{{ section.settings.video_width_desktop }}">
        {%- if section.settings.video_url != blank -%}
          {%- if section.settings.video_url.type == 'youtube' -%}
            <iframe
              id="iframe-{{ section.id }}"
              src="https://www.youtube.com/embed/{{ section.settings.video_url.id }}?enablejsapi=1&autoplay=1&mute=1&loop=1&playlist={{ section.settings.video_url.id }}&controls=0&playsinline=1&rel=0&modestbranding=1&origin=https://{{ request.host }}"
              allow="autoplay; encrypted-media"
              allowfullscreen
            ></iframe>
            
            <!-- Premium Floating controls -->
            <div class="ga-video-controls">
              <!-- Play / Pause Button -->
              <button class="ga-video-control-btn ga-btn-play-pause" aria-label="Pause Video">
                <!-- Pause Icon (Default playing) -->
                <svg viewBox="0 0 24 24"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
              </button>
              
              <!-- Mute / Unmute Button -->
              <button class="ga-video-control-btn ga-btn-mute-unmute" aria-label="Unmute Video">
                <!-- Mute Icon (Default muted) -->
                <svg viewBox="0 0 24 24"><path d="M16.5 12c0-1.77-1.02-3.29-2.5-4.03v2.21l2.45 2.45c.03-.21.05-.42.05-.63zm2.5 0c0 .94-.2 1.82-.54 2.64l1.51 1.51C20.63 14.91 21 13.5 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3L3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06c1.38-.31 2.63-.95 3.69-1.81L19.73 21 21 19.73l-9-9L4.27 3zM12 4L9.91 6.09 12 8.18V4z"/></svg>
              </button>
            </div>
          {%- endif -%}
        {%- else -%}
          <!-- Fallback placeholder design -->
          <div style="display:flex;align-items:center;justify-content:center;height:100%;color:#fff;font-family:var(--ga-font-family-sans);font-weight:400;font-size:1.6rem;">
            Please configure a YouTube Video URL
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const section = document.getElementById('ga-video-section-{{ section.id }}');
    if (!section) return;

    const iframe = section.querySelector('iframe');
    const playBtn = section.querySelector('.ga-btn-play-pause');
    const muteBtn = section.querySelector('.ga-btn-mute-unmute');

    if (!iframe) return;

    let isPlaying = true;
    let isMuted = true;

    // Helper to send events to YouTube IFrame API via postMessage
    function sendCommand(func, args = '') {
      if (iframe.contentWindow) {
        iframe.contentWindow.postMessage(JSON.stringify({
          event: 'command',
          func: func,
          args: args
        }), '*');
      }
    }

    if (playBtn) {
      playBtn.addEventListener('click', function() {
        if (isPlaying) {
          sendCommand('pauseVideo');
          playBtn.innerHTML = `<svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>`;
          playBtn.setAttribute('aria-label', 'Play Video');
          isPlaying = false;
        } else {
          sendCommand('playVideo');
          playBtn.innerHTML = `<svg viewBox="0 0 24 24"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>`;
          playBtn.setAttribute('aria-label', 'Pause Video');
          isPlaying = true;
        }
      });
    }

    if (muteBtn) {
      muteBtn.addEventListener('click', function() {
        if (isMuted) {
          sendCommand('unmute');
          muteBtn.innerHTML = `<svg viewBox="0 0 24 24"><path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"/></svg>`;
          muteBtn.setAttribute('aria-label', 'Mute Video');
          isMuted = false;
        } else {
          sendCommand('mute');
          muteBtn.innerHTML = `<svg viewBox="0 0 24 24"><path d="M16.5 12c0-1.77-1.02-3.29-2.5-4.03v2.21l2.45 2.45c.03-.21.05-.42.05-.63zm2.5 0c0 .94-.2 1.82-.54 2.64l1.51 1.51C20.63 14.91 21 13.5 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3L3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06c1.38-.31 2.63-.95 3.69-1.81L19.73 21 21 19.73l-9-9L4.27 3zM12 4L9.91 6.09 12 8.18V4z"/></svg>`;
          muteBtn.setAttribute('aria-label', 'Unmute Video');
          isMuted = true;
        }
      });
    }
  });
</script>

{% schema %}
{
  "name": "GA Premium Video",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Section Background",
      "default": "#faf8f5"
    },
    {
      "type": "text",
      "id": "header_subtitle",
      "label": "Section Subtitle",
      "default": "OUR ROOTS IN MOTION"
    },
    {
      "type": "text",
      "id": "header_title",
      "label": "Section Title",
      "default": "Experience Ghar Aangan"
    },
    {
      "type": "textarea",
      "id": "header_description",
      "label": "Section Description",
      "default": "Watch the journey of pure, handcrafted A2 Badri cow Bilona ghee directly from the high-altitude pastures of Uttarakhand."
    },
    {
      "type": "video_url",
      "id": "video_url",
      "accept": [
        "youtube"
      ],
      "label": "YouTube Video URL",
      "default": "https://www.youtube.com/watch?v=jLSVeNXRaRs"
    },
    {
      "type": "select",
      "id": "video_aspect_ratio",
      "label": "Video Aspect Ratio",
      "options": [
        {
          "value": "16_9",
          "label": "16:9 Landscape"
        },
        {
          "value": "9_16",
          "label": "9:16 Portrait / YouTube Short"
        },
        {
          "value": "4_3",
          "label": "4:3 Classic"
        },
        {
          "value": "1_1",
          "label": "1:1 Square"
        }
      ],
      "default": "9_16"
    },
    {
      "type": "select",
      "id": "video_width_desktop",
      "label": "Desktop Container Width",
      "options": [
        {
          "value": "small",
          "label": "Small (380px)"
        },
        {
          "value": "medium",
          "label": "Medium (580px)"
        },
        {
          "value": "large",
          "label": "Large (900px)"
        },
        {
          "value": "full",
          "label": "Full Width (1200px)"
        }
      ],
      "default": "medium"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "GA Premium Video"
    }
  ]
}
{% endschema %}
