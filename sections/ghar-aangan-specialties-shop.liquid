{%- liquid
  assign bg_color = section.settings.background_color | default: '#faf8f5'
  assign title = section.settings.title | default: 'Authentic Pahadi Specialties & Pure A2 Bilona Ghee'
  assign subtitle = section.settings.subtitle | default: '100% PURE BILONA A2 GHEE & HIMALAYAN SPECIALTIES'
  assign description = section.settings.description | default: 'Handcrafted over wood-fires from Himalayan Pahadi cattle alongside unpolished heirloom pulses, traditional Sil-Batta herbal salts, and watermill-milled ancient grains from Uttarakhand.'

  # Dynamic Category Counts
  assign ghee_count = 0
  assign dal_count = 0
  assign salt_count = 0
  assign millet_count = 0
  for block in section.blocks
    case block.settings.category
      when 'ghee'
        assign ghee_count = ghee_count | plus: 1
      when 'dal'
        assign dal_count = dal_count | plus: 1
      when 'salt'
        assign salt_count = salt_count | plus: 1
      when 'millet'
        assign millet_count = millet_count | plus: 1
    endcase
  endfor
  assign total_count = section.blocks.size
-%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ bg_color }};
    padding-top: {{ section.settings.padding_top | default: 70 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 75 }}px;
    position: relative;
  }

  .ga-spec-container {
    max-width: 1320px;
    margin: 0 auto;
    padding: 0 20px;
  }

  @media (max-width: 767px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | default: 70 | times: 0.7 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | default: 75 | times: 0.7 | round }}px;
    }
    .ga-spec-container {
      padding: 0 16px;
    }
  }

  /* Header */
  .ga-spec-header {
    text-align: center;
    max-width: 840px;
    margin: 0 auto 36px;
  }

  .ga-spec-subtitle {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 11.5px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: #8c734b;
    font-weight: 800;
    margin-bottom: 8px;
    background: #f4eee1;
    padding: 5px 14px;
    border-radius: 30px;
    border: 1px solid #e7dcce;
  }

  .ga-spec-title {
    font-family: var(--ga-font-family-serif, 'Playfair Display', Georgia, serif);
    font-size: clamp(26px, 3.8vw, 42px);
    font-weight: 800;
    color: #1a332c;
    line-height: 1.2;
    margin: 12px 0 12px;
    letter-spacing: -0.5px;
  }

  .ga-spec-desc {
    font-size: clamp(14px, 1.2vw, 16px);
    color: #4a5550;
    line-height: 1.6;
    margin: 0;
  }

  /* Tabs Filter */
  .ga-spec-tabs-wrap {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 10px;
    margin-bottom: 36px;
    flex-wrap: wrap;
  }

  .ga-spec-tab-btn {
    appearance: none;
    border: 1.5px solid #dcd3c3;
    background: #ffffff;
    color: #1a332c;
    padding: 10px 20px;
    border-radius: 40px;
    font-size: 13.5px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.25s ease;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    box-shadow: 0 2px 6px rgba(0,0,0,0.02);
  }

  .ga-spec-tab-btn:hover {
    border-color: #1a332c;
    background: #fdfbf7;
    transform: translateY(-1px);
  }

  .ga-spec-tab-btn.is-active {
    background: #1a332c;
    color: #ffffff;
    border-color: #1a332c;
    box-shadow: 0 4px 14px rgba(26, 51, 44, 0.2);
  }

  .ga-spec-tab-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgba(26, 51, 44, 0.1);
    color: inherit;
    font-size: 11px;
    border-radius: 20px;
    padding: 1px 7px;
    font-weight: 800;
  }

  .ga-spec-tab-btn.is-active .ga-spec-tab-count {
    background: rgba(255, 255, 255, 0.25);
    color: #ffffff;
  }

  /* Grid Layout: Bigger and Beautiful */
  .ga-spec-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 26px;
  }

  @media (max-width: 1100px) {
    .ga-spec-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }
  }

  @media (max-width: 680px) {
    .ga-spec-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }
  }

  /* Card */
  .ga-spec-card {
    background: #ffffff;
    border: 1.5px solid #eae3d5;
    border-radius: 18px;
    padding: 20px;
    display: flex;
    flex-direction: column;
    position: relative;
    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 5px 18px rgba(26, 51, 44, 0.04);
  }

  .ga-spec-card:hover {
    border-color: #c8933b;
    transform: translateY(-4px);
    box-shadow: 0 14px 34px rgba(26, 51, 44, 0.11);
  }

  .ga-spec-card.is-featured {
    border: 2px solid #1a332c;
    background: #fffdfa;
    box-shadow: 0 8px 24px rgba(26, 51, 44, 0.08);
  }

  .ga-spec-card.is-hidden {
    display: none !important;
  }

  /* Badges */
  .ga-spec-badge-left {
    position: absolute;
    top: 14px;
    left: 14px;
    background: #1a332c;
    color: #ffffff;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.6px;
    text-transform: uppercase;
    padding: 5px 12px;
    border-radius: 20px;
    z-index: 3;
    box-shadow: 0 2px 8px rgba(0,0,0,0.15);
  }

  .ga-spec-card.is-featured .ga-spec-badge-left {
    background: #c8933b;
    color: #ffffff;
  }

  .ga-spec-badge-right {
    position: absolute;
    top: 14px;
    right: 14px;
    background: #b91c1c;
    color: #ffffff;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    padding: 5px 10px;
    border-radius: 20px;
    z-index: 3;
    box-shadow: 0 2px 8px rgba(185, 28, 28, 0.2);
  }

  /* Media / Image Wrap */
  .ga-spec-media-link {
    display: block;
    width: 100%;
    height: 250px;
    border-radius: 14px;
    background: linear-gradient(180deg, #faf7f2 0%, #f4ede2 100%);
    position: relative;
    overflow: hidden;
    margin-bottom: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 14px;
  }

  @media (max-width: 767px) {
    .ga-spec-media-link {
      height: 240px;
    }
  }

  .ga-spec-img {
    max-height: 100%;
    max-width: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
    filter: drop-shadow(0 6px 12px rgba(0,0,0,0.06));
  }

  .ga-spec-card:hover .ga-spec-img {
    transform: scale(1.07);
  }

  .ga-spec-placeholder-icon {
    width: 70px;
    height: 70px;
    color: #b7a488;
  }

  /* Metadata */
  .ga-spec-meta-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 8px;
    font-size: 11.5px;
  }

  .ga-spec-origin-tag {
    color: #8c734b;
    font-weight: 750;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .ga-spec-rating {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    color: #c8933b;
    font-weight: 750;
  }

  .ga-spec-rating svg {
    width: 12px;
    height: 12px;
    fill: #c8933b;
  }

  /* Title */
  .ga-spec-title-link {
    text-decoration: none !important;
    color: #1a332c !important;
    display: block;
    margin-bottom: 8px;
  }

  .ga-spec-prod-name {
    font-family: var(--ga-font-family-serif, 'Playfair Display', Georgia, serif);
    font-size: 19px;
    font-weight: 700;
    color: #1a332c;
    line-height: 1.3;
    margin: 0;
    transition: color 0.2s ease;
  }

  .ga-spec-card:hover .ga-spec-prod-name {
    color: #c8933b;
  }

  /* Highlight text */
  .ga-spec-highlight {
    font-size: 13px;
    color: #555b57;
    line-height: 1.5;
    margin-bottom: 14px;
    min-height: 38px;
  }

  /* Variant Picker Pills */
  .ga-spec-variant-row {
    margin-bottom: 14px;
  }

  .ga-spec-variant-label {
    display: block;
    font-size: 11px;
    font-weight: 750;
    color: #736752;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 6px;
  }

  .ga-spec-variant-pills {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .ga-spec-var-btn {
    appearance: none;
    background: #fbf9f5;
    border: 1.5px solid #dcd3c3;
    color: #2e3b35;
    padding: 6px 14px;
    border-radius: 8px;
    font-size: 12px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s ease;
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .ga-spec-var-btn:hover {
    border-color: #1a332c;
    background: #ffffff;
  }

  .ga-spec-var-btn.is-selected {
    background: #1a332c;
    color: #ffffff;
    border-color: #1a332c;
    box-shadow: 0 2px 8px rgba(26, 51, 44, 0.18);
  }

  .ga-spec-single-size-badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    background: #f4eee1;
    border: 1px solid #e1d6c3;
    color: #635032;
    padding: 5px 12px;
    border-radius: 8px;
    font-size: 11.5px;
    font-weight: 750;
  }

  /* Price Box */
  .ga-spec-price-box {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 12px;
    padding-top: 10px;
    border-top: 1px dashed #eae3d5;
  }

  .ga-spec-price-group {
    display: flex;
    align-items: baseline;
    gap: 8px;
  }

  .ga-spec-price {
    font-size: 22px;
    font-weight: 800;
    color: #1a332c;
    line-height: 1;
  }

  .ga-spec-compare {
    font-size: 13.5px;
    color: #8a918e;
    text-decoration: line-through;
  }

  .ga-spec-saving-pill {
    font-size: 11px;
    font-weight: 750;
    color: #166534;
    background: #dcfce7;
    padding: 3px 8px;
    border-radius: 6px;
  }

  /* Trust perks pill */
  .ga-spec-perks {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: #f7faf8;
    border: 1px solid #e1ede6;
    border-radius: 8px;
    padding: 6px 10px;
    margin-bottom: 16px;
    font-size: 11px;
    font-weight: 700;
    color: #1e3a31;
  }

  .ga-spec-perk-item {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .ga-spec-perk-item svg {
    color: #16a34a;
    width: 12px;
    height: 12px;
    flex-shrink: 0;
  }

  /* Actions */
  .ga-spec-actions {
    display: flex;
    gap: 10px;
    margin-top: auto;
  }

  .ga-spec-btn-atc {
    flex: 1;
    appearance: none;
    border: none;
    background: #1a332c;
    color: #ffffff !important;
    text-decoration: none !important;
    padding: 12px 14px;
    border-radius: 9px;
    font-size: 13.5px;
    font-weight: 750;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    transition: all 0.25s ease;
    box-shadow: 0 3px 10px rgba(26, 51, 44, 0.12);
  }

  .ga-spec-btn-atc:hover {
    background: #2b4f44;
    transform: translateY(-1px);
    box-shadow: 0 6px 16px rgba(26, 51, 44, 0.2);
  }

  .ga-spec-btn-atc.is-loading {
    opacity: 0.75;
    cursor: wait;
    pointer-events: none;
  }

  .ga-spec-btn-view {
    appearance: none;
    border: 1.5px solid #1a332c;
    background: #ffffff;
    color: #1a332c !important;
    text-decoration: none !important;
    padding: 12px 14px;
    border-radius: 9px;
    font-size: 13.5px;
    font-weight: 750;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
  }

  .ga-spec-btn-view:hover {
    background: #1a332c;
    color: #ffffff !important;
  }

  /* Section Bottom Banner */
  .ga-spec-footer-banner {
    margin-top: 48px;
    background: #ffffff;
    border: 1.5px solid #eae3d5;
    border-radius: 16px;
    padding: 24px 28px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
    box-shadow: 0 4px 18px rgba(0,0,0,0.03);
  }

  .ga-spec-footer-items {
    display: flex;
    align-items: center;
    gap: 28px;
    flex-wrap: wrap;
  }

  .ga-spec-footer-item {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 13.5px;
    font-weight: 700;
    color: #1a332c;
  }

  .ga-spec-footer-icon {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: #f5efe3;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #8c734b;
    font-size: 16px;
    flex-shrink: 0;
  }

  .ga-spec-footer-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #1a332c;
    color: #ffffff !important;
    text-decoration: none !important;
    padding: 11px 22px;
    border-radius: 9px;
    font-size: 13.5px;
    font-weight: 750;
    transition: all 0.2s ease;
  }

  .ga-spec-footer-cta:hover {
    background: #2b4f44;
    transform: translateY(-1px);
  }

  @media (max-width: 767px) {
    .ga-spec-footer-banner {
      flex-direction: column;
      align-items: stretch;
      padding: 18px;
    }
    .ga-spec-footer-items {
      gap: 16px;
    }
    .ga-spec-footer-cta {
      justify-content: center;
    }
  }
{%- endstyle -%}

<div class="ga-spec-section-wrapper" id="ga-specialties-shop">
  <div class="ga-spec-container">
    <!-- Section Header -->
    <div class="ga-spec-header">
      <span class="ga-spec-subtitle">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path></svg>
        {{ subtitle }}
      </span>
      <h2 class="ga-spec-title">{{ title }}</h2>
      <p class="ga-spec-desc">{{ description }}</p>
    </div>

    <!-- Category Filter Tabs -->
    <div class="ga-spec-tabs-wrap" role="tablist" aria-label="Product categories">
      <button type="button" class="ga-spec-tab-btn is-active" data-filter="all" role="tab" aria-selected="true">
        <span>All Products</span>
        <span class="ga-spec-tab-count">{{ total_count }}</span>
      </button>
      {%- if ghee_count > 0 -%}
        <button type="button" class="ga-spec-tab-btn" data-filter="ghee" role="tab" aria-selected="false">
          <span>🧈 Pure A2 Bilona Ghee</span>
          <span class="ga-spec-tab-count">{{ ghee_count }}</span>
        </button>
      {%- endif -%}
      {%- if dal_count > 0 -%}
        <button type="button" class="ga-spec-tab-btn" data-filter="dal" role="tab" aria-selected="false">
          <span>🏔️ Heirloom Pahadi Dals</span>
          <span class="ga-spec-tab-count">{{ dal_count }}</span>
        </button>
      {%- endif -%}
      {%- if salt_count > 0 -%}
        <button type="button" class="ga-spec-tab-btn" data-filter="salt" role="tab" aria-selected="false">
          <span>🧂 Sil-Batta Pisyu Loon</span>
          <span class="ga-spec-tab-count">{{ salt_count }}</span>
        </button>
      {%- endif -%}
      {%- if millet_count > 0 -%}
        <button type="button" class="ga-spec-tab-btn" data-filter="millet" role="tab" aria-selected="false">
          <span>🌾 Mountain Millets & Flour</span>
          <span class="ga-spec-tab-count">{{ millet_count }}</span>
        </button>
      {%- endif -%}
    </div>

    <!-- Products Grid -->
    <div class="ga-spec-grid" id="ga-spec-products-grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign prod_handle = block.settings.product_handle
          assign pr = all_products[prod_handle]
          assign fallback_title = block.settings.title
          assign fallback_url = '/products/' | append: prod_handle
          assign product_title = pr.title | default: fallback_title
          assign product_url = pr.url | default: fallback_url
          assign primary_img = block.settings.image | default: pr.featured_image
          assign badge_text = block.settings.badge_text
          assign origin_tag = block.settings.origin_tag | default: 'Uttarakhand Himalayas'
          assign category = block.settings.category | default: 'ghee'
          assign highlight = block.settings.highlight
          assign is_featured = block.settings.is_featured
          if badge_text contains 'POPULAR'
            assign is_featured = true
          endif

          # Pricing logic
          assign first_variant = pr.selected_or_first_available_variant | default: pr.variants.first
          assign price = first_variant.price | default: block.settings.default_price | default: 20000
          assign compare_price = first_variant.compare_at_price | default: block.settings.default_compare_price | default: 24900
          assign discount_pct = 0
          if compare_price > price
            assign savings_amount = compare_price | minus: price
            assign discount_pct = savings_amount | times: 100 | divided_by: compare_price
          endif
        -%}

        <div class="ga-spec-card{% if is_featured %} is-featured{% endif %}" data-category="{{ category }}" {{ block.shopify_attributes }}>
          {%- if badge_text != blank -%}
            <span class="ga-spec-badge-left">{{ badge_text }}</span>
          {%- endif -%}

          <span class="ga-spec-badge-right" data-spec-badge-save>
            {%- if discount_pct > 0 -%}
              SAVE {{ discount_pct }}%
            {%- else -%}
              100% PURE
            {%- endif -%}
          </span>

          <!-- Product Image Link -->
          <a href="{{ product_url }}" class="ga-spec-media-link" aria-label="{{ product_title | escape }}">
            {%- if primary_img != blank -%}
              {{ primary_img | image_url: width: 600 | image_tag: loading: 'lazy', class: 'ga-spec-img', alt: product_title }}
            {%- else -%}
              <svg class="ga-spec-placeholder-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path></svg>
            {%- endif -%}
          </a>

          <!-- Origin & Ratings -->
          <div class="ga-spec-meta-row">
            <span class="ga-spec-origin-tag">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
              {{ origin_tag }}
            </span>
            <span class="ga-spec-rating">
              <svg viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path></svg>
              4.9 (Pure)
            </span>
          </div>

          <!-- Product Title -->
          <a href="{{ product_url }}" class="ga-spec-title-link">
            <h3 class="ga-spec-prod-name">{{ product_title }}</h3>
          </a>

          <!-- Sensory / Nutritional Highlight -->
          <p class="ga-spec-highlight">{{ highlight }}</p>

          <!-- Variant Selector or Size Badge -->
          <div class="ga-spec-variant-row">
            {%- if pr.variants.size > 1 -%}
              <span class="ga-spec-variant-label">Select Pack Size:</span>
              <div class="ga-spec-variant-pills" role="radiogroup" aria-label="Available pack sizes">
                {%- for variant in pr.variants -%}
                  {%- liquid
                    assign v_saving = 0
                    if variant.compare_at_price > variant.price
                      assign v_save_amt = variant.compare_at_price | minus: variant.price
                      assign v_saving = v_save_amt | times: 100 | divided_by: variant.compare_at_price
                    endif
                  -%}
                  <button
                    type="button"
                    class="ga-spec-var-btn{% if forloop.first %} is-selected{% endif %}"
                    data-variant-id="{{ variant.id }}"
                    data-price="{{ variant.price | money }}"
                    data-compare="{{ variant.compare_at_price | money }}"
                    data-save-pct="{{ v_saving }}"
                    data-available="{{ variant.available }}"
                  >
                    {{ variant.title }}
                  </button>
                {%- endfor -%}
              </div>
            {%- else -%}
              <div class="ga-spec-single-size-badge">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path></svg>
                <span>{{ block.settings.single_size_label | default: 'Pure Himalayan Pack' }}</span>
              </div>
            {%- endif -%}
          </div>

          <!-- Price Row -->
          <div class="ga-spec-price-box">
            <div class="ga-spec-price-group">
              <span class="ga-spec-price" data-spec-price>{{ price | money }}</span>
              {%- if compare_price > price -%}
                <span class="ga-spec-compare" data-spec-compare>{{ compare_price | money }}</span>
              {%- else -%}
                <span class="ga-spec-compare" data-spec-compare style="display:none;"></span>
              {%- endif -%}
            </div>
            {%- if discount_pct > 0 -%}
              <span class="ga-spec-saving-pill" data-spec-saving-pill>Save {{ savings_amount | money }}</span>
            {%- else -%}
              <span class="ga-spec-saving-pill" data-spec-saving-pill style="display:none;"></span>
            {%- endif -%}
          </div>

          <!-- Trust & Shipping Perks -->
          <div class="ga-spec-perks">
            <span class="ga-spec-perk-item">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              {% if category == 'ghee' %}Traditional Bilona{% else %}100% Unadulterated{% endif %}
            </span>
            <span class="ga-spec-perk-item">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
              Free Delivery (Prepaid)
            </span>
          </div>

          <!-- Actions Form (AJAX Add to Cart + View Details) -->
          <form method="post" action="/cart/add" class="ga-spec-form" data-product-form>
            <input type="hidden" name="id" value="{{ first_variant.id | default: block.settings.default_variant_id }}">
            <input type="hidden" name="quantity" value="1">
            <div class="ga-spec-actions">
              <button type="submit" class="ga-spec-btn-atc" data-add-to-cart>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
                <span class="ga-atc-text">Add to Cart</span>
              </button>
              <a href="{{ product_url }}" class="ga-spec-btn-view">View</a>
            </div>
          </form>
        </div>
      {%- endfor -%}
    </div>

    <!-- Section Bottom Reassurance Banner -->
    <div class="ga-spec-footer-banner">
      <div class="ga-spec-footer-items">
        <div class="ga-spec-footer-item">
          <div class="ga-spec-footer-icon">🧈</div>
          <div>
            <div>100% Pure Bilona Method</div>
            <div style="font-size:11.5px;color:#666;font-weight:400;">Slow curd-churning in earthen pots over gentle wood-fires</div>
          </div>
        </div>
        <div class="ga-spec-footer-item">
          <div class="ga-spec-footer-icon">🌾</div>
          <div>
            <div>Unpolished Heirloom Harvest</div>
            <div style="font-size:11.5px;color:#666;font-weight:400;">Zero polish, chemical sprays, or artificial enhancements</div>
          </div>
        </div>
        <div class="ga-spec-footer-item">
          <div class="ga-spec-footer-icon">🚚</div>
          <div>
            <div>Direct Dispatch & COD</div>
            <div style="font-size:11.5px;color:#666;font-weight:400;">Packed safely and delivered Pan-India with Cash on Delivery</div>
          </div>
        </div>
      </div>
      <a href="/collections/all" class="ga-spec-footer-cta">
        <span>Explore All Products</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"></path></svg>
      </a>
    </div>
  </div>
</div>

<script>
  (function() {
    // 1. Category Filter Switching
    const root = document.getElementById('shopify-section-{{ section.id }}');
    if (!root) return;
    const tabs = root.querySelectorAll('.ga-spec-tab-btn');
    const cards = root.querySelectorAll('.ga-spec-card');

    tabs.forEach(tab => {
      tab.addEventListener('click', function() {
        tabs.forEach(t => {
          t.classList.remove('is-active');
          t.setAttribute('aria-selected', 'false');
        });
        this.classList.add('is-active');
        this.setAttribute('aria-selected', 'true');

        const filter = this.getAttribute('data-filter');
        cards.forEach(card => {
          if (filter === 'all' || card.getAttribute('data-category') === filter) {
            card.classList.remove('is-hidden');
          } else {
            card.classList.add('is-hidden');
          }
        });
      });
    });

    // 2. Variant Selector Pills
    cards.forEach(card => {
      const varBtns = card.querySelectorAll('.ga-spec-var-btn');
      const hiddenInput = card.querySelector('input[name="id"]');
      const priceElem = card.querySelector('[data-spec-price]');
      const compareElem = card.querySelector('[data-spec-compare]');
      const saveBadge = card.querySelector('[data-spec-badge-save]');
      const savingPill = card.querySelector('[data-spec-saving-pill]');
      const atcBtn = card.querySelector('[data-add-to-cart]');
      const atcText = card.querySelector('.ga-atc-text');

      varBtns.forEach(btn => {
        btn.addEventListener('click', function(e) {
          e.preventDefault();
          varBtns.forEach(b => b.classList.remove('is-selected'));
          this.classList.add('is-selected');

          const varId = this.getAttribute('data-variant-id');
          const price = this.getAttribute('data-price');
          const compare = this.getAttribute('data-compare');
          const savePct = parseInt(this.getAttribute('data-save-pct') || '0', 10);
          const isAvailable = this.getAttribute('data-available') === 'true';

          if (hiddenInput && varId) hiddenInput.value = varId;
          if (priceElem && price) priceElem.textContent = price;
          if (compareElem) {
            if (compare && compare !== '') {
              compareElem.textContent = compare;
              compareElem.style.display = 'inline';
            } else {
              compareElem.style.display = 'none';
            }
          }

          if (saveBadge) {
            saveBadge.textContent = savePct > 0 ? `SAVE ${savePct}%` : '100% PURE';
          }

          if (savingPill) {
            savingPill.style.display = savePct > 0 ? 'inline' : 'none';
          }

          if (atcBtn) {
            if (!isAvailable) {
              atcBtn.disabled = true;
              if (atcText) atcText.textContent = 'Sold Out';
            } else {
              atcBtn.disabled = false;
              if (atcText) atcText.textContent = 'Add to Cart';
            }
          }
        });
      });

      // 3. AJAX Add to Cart
      const form = card.querySelector('form[data-product-form]');
      if (form) {
        form.addEventListener('submit', function(e) {
          e.preventDefault();
          const submitBtn = form.querySelector('[data-add-to-cart]');
          const textSpan = form.querySelector('.ga-atc-text');
          const origText = textSpan ? textSpan.textContent : 'Add to Cart';

          if (submitBtn) submitBtn.classList.add('is-loading');
          if (textSpan) textSpan.textContent = 'Adding...';

          const formData = new FormData(form);

          fetch('/cart/add.js', {
            method: 'POST',
            body: formData
          })
          .then(res => {
            if (!res.ok) throw new Error('Cart add failed');
            return res.json();
          })
          .then(item => {
            if (textSpan) textSpan.textContent = '✓ Added!';
            setTimeout(() => {
              if (submitBtn) submitBtn.classList.remove('is-loading');
              if (textSpan) textSpan.textContent = origText;
            }, 1800);

            // Trigger theme cart drawer / header updates
            document.documentElement.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true }));
            document.dispatchEvent(new CustomEvent('cart:updated', { detail: { item: item }, bubbles: true }));

            // Attempt to open cart drawer if present
            const cartDrawer = document.getElementById('CartDrawer');
            const cartDrawerTrigger = document.querySelector('[aria-controls="CartDrawer"]') || document.querySelector('.hdt-cart-trigger');
            if (cartDrawer && typeof cartDrawer.showModal === 'function') {
              if (cartDrawerTrigger) {
                cartDrawerTrigger.click();
              } else {
                try { cartDrawer.showModal(); } catch (err) {}
              }
            } else if (cartDrawerTrigger) {
              cartDrawerTrigger.click();
            }
          })
          .catch(err => {
            console.warn('Standard AJAX failed, falling back to form submit', err);
            form.submit();
          });
        });
      }
    });
  })();
</script>

