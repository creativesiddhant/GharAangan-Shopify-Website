{%- unless template contains 'product' -%}
{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.65 | round }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.65 | round }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .ga-heritage-section {
    position: relative;
    overflow: hidden;
  }

  .ga-heritage-card {
    background: {{ section.settings.card_bg | default: '#ffffff' }};
    border: 1.5px solid rgba(205, 162, 80, 0.28);
    border-radius: 24px;
    padding: clamp(24px, 4.5vw, 48px);
    box-shadow: 0 16px 40px rgba(26, 51, 44, 0.04);
    position: relative;
    overflow: hidden;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.4s ease;
  }

  .ga-heritage-card:hover {
    box-shadow: 0 22px 50px rgba(26, 51, 44, 0.08);
    border-color: rgba(205, 162, 80, 0.5);
  }

  /* Decorative subtle mountain backdrop */
  .ga-heritage-card::before {
    content: '';
    position: absolute;
    bottom: -60px;
    left: -60px;
    width: 220px;
    height: 220px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(205, 162, 80, 0.08) 0%, transparent 70%);
    pointer-events: none;
    z-index: 0;
  }

  .ga-heritage-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
    align-items: center;
    position: relative;
    z-index: 1;
  }

  @media screen and (min-width: 860px) {
    .ga-heritage-grid {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
      gap: 52px;
    }
  }

  /* Image Column Styling */
  .ga-heritage-image-col {
    position: relative;
    width: 100%;
  }

  @media screen and (min-width: 860px) {
    .ga-heritage-image-col {
      order: 2; /* Image on right for alternating rhythm with founder section */
    }
    .ga-heritage-content-col {
      order: 1;
    }
  }

  .ga-heritage-image-frame {
    position: relative;
    width: 100%;
    border-radius: 18px;
    overflow: hidden;
    border: 2px solid #ecdcb9;
    box-shadow: 0 12px 30px rgba(26, 51, 44, 0.07);
    background-color: #0c1412;
    aspect-ratio: 4 / 3;
  }

  @media screen and (min-width: 860px) {
    .ga-heritage-image-frame {
      aspect-ratio: 4 / 3;
    }
  }

  .ga-heritage-img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 1.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .ga-heritage-card:hover .ga-heritage-img {
    transform: scale(1.04);
  }

  /* Floating Authentic Badge */
  .ga-heritage-floating-badge {
    position: absolute;
    bottom: 16px;
    right: 16px;
    left: auto;
    background: rgba(26, 51, 44, 0.9);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(205, 162, 80, 0.45);
    border-radius: 30px;
    padding: 7px 14px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #ffffff;
    font-family: var(--ga-font-family-sans, 'Outfit', sans-serif);
    font-size: 12px;
    font-weight: 550;
    letter-spacing: 0.03em;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.25);
    z-index: 2;
  }

  .ga-heritage-floating-badge svg {
    width: 14px;
    height: 14px;
    fill: #cda250;
    flex-shrink: 0;
  }

  /* Content Column Styling */
  .ga-heritage-content-col {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .ga-heritage-header-area {
    margin-bottom: 20px;
  }

  .ga-heritage-subtitle-wrap {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 10px;
  }

  .ga-heritage-subtitle {
    font-family: var(--ga-font-family-sans, 'Outfit', sans-serif);
    font-size: 12.5px;
    font-weight: 750;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: #a8792c;
    margin: 0;
    display: inline-block;
  }

  .ga-heritage-subtitle-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background-color: #cda250;
  }

  .ga-heritage-title {
    font-family: var(--ga-font-family-serif, 'Playfair Display', Georgia, serif);
    font-size: clamp(2.4rem, 4vw, 3.8rem);
    color: var(--ga-forest-green, #1a332c);
    line-height: 1.2;
    margin: 0 0 16px 0;
    font-weight: 600;
  }

  .ga-heritage-divider {
    width: 56px;
    height: 3px;
    background: linear-gradient(90deg, #cda250 0%, rgba(205, 162, 80, 0.2) 100%);
    border-radius: 2px;
    margin-bottom: 20px;
  }

  .ga-heritage-quote-box {
    position: relative;
    padding-left: 20px;
    border-left: 3px solid rgba(205, 162, 80, 0.45);
    margin-bottom: 24px;
  }

  .ga-heritage-text {
    font-family: var(--ga-font-family-sans, 'Outfit', sans-serif);
    font-size: clamp(1.45rem, 1.6vw, 1.65rem);
    line-height: 1.8;
    color: #2c3832;
    margin: 0;
    font-weight: 400;
  }

  /* Heritage Values Grid */
  .ga-heritage-values {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 26px;
  }

  .ga-heritage-value-pill {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    background: #ffffff;
    border: 1px solid rgba(205, 162, 80, 0.28);
    border-radius: 30px;
    padding: 7px 14px;
    font-family: var(--ga-font-family-sans, 'Outfit', sans-serif);
    font-size: 12.5px;
    font-weight: 550;
    color: #1a332c;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.02);
  }

  .ga-heritage-value-pill svg {
    width: 14px;
    height: 14px;
    color: #cda250;
    flex-shrink: 0;
  }

  /* Action row */
  .ga-heritage-action-row {
    display: flex;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
  }

  .ga-heritage-cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background: #1a332c;
    color: #ffffff !important;
    text-decoration: none !important;
    padding: 13px 28px;
    border-radius: 8px;
    font-family: var(--ga-font-family-sans, 'Outfit', sans-serif);
    font-size: 13px;
    font-weight: 650;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border: 1.5px solid #1a332c;
    box-shadow: 0 4px 14px rgba(26, 51, 44, 0.16);
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .ga-heritage-cta-btn:hover {
    background: #24493e;
    border-color: #cda250;
    transform: translateY(-2px);
    box-shadow: 0 8px 22px rgba(26, 51, 44, 0.25);
  }

  .ga-heritage-cta-btn svg {
    transition: transform 0.25s ease;
  }

  .ga-heritage-cta-btn:hover svg {
    transform: translateX(4px);
  }

  .ga-heritage-origin-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--ga-font-family-sans, 'Outfit', sans-serif);
    font-size: 12px;
    color: #68756f;
    font-weight: 500;
  }

  .ga-heritage-origin-badge svg {
    width: 15px;
    height: 15px;
    color: #a8792c;
  }

  /* Mobile Tweaks */
  @media screen and (max-width: 859px) {
    .ga-heritage-card {
      border-radius: 20px;
      padding: 0 0 26px 0; /* Full bleed image at top of card */
      overflow: hidden;
    }

    .ga-heritage-grid {
      gap: 0;
    }

    .ga-heritage-image-col {
      width: 100%;
      margin: 0;
    }

    .ga-heritage-image-frame {
      width: 100%;
      aspect-ratio: 4 / 3;
      border-radius: 19px 19px 0 0;
      border-top: none;
      border-left: none;
      border-right: none;
      border-bottom: 2px solid #ecdcb9;
      box-shadow: none;
    }

    .ga-heritage-floating-badge {
      top: 14px;
      right: 14px;
      bottom: auto;
      left: auto;
      font-size: 11.5px;
      padding: 6px 12px;
    }

    .ga-heritage-content-col {
      padding: 24px 20px 0 20px;
    }

    .ga-heritage-header-area {
      margin-bottom: 16px;
    }

    .ga-heritage-title {
      font-size: clamp(2.2rem, 5.5vw, 2.8rem);
      margin-bottom: 12px;
    }

    .ga-heritage-divider {
      margin-bottom: 16px;
    }

    .ga-heritage-quote-box {
      padding-left: 14px;
      margin-bottom: 20px;
    }

    .ga-heritage-text {
      font-size: 1.5rem;
      line-height: 1.75;
    }

    .ga-heritage-values {
      gap: 8px;
      margin-bottom: 22px;
    }

    .ga-heritage-value-pill {
      font-size: 12px;
      padding: 6px 12px;
    }

    .ga-heritage-action-row {
      flex-direction: column;
      align-items: stretch;
      gap: 12px;
    }

    .ga-heritage-cta-btn {
      width: 100%;
      text-align: center;
      padding: 13px 20px;
    }

    .ga-heritage-origin-badge {
      justify-content: center;
    }
  }
{%- endstyle -%}

<div id="ga-heritage-section-{{ section.id }}" class="ga-heritage-section section-{{ section.id }}-padding" style="background-color: {{ section.settings.background_color }};">
  <div class="page-width">
    <div class="ga-heritage-card ga-reveal">
      <div class="ga-heritage-grid">
        <!-- Image Column -->
        <div class="ga-heritage-image-col">
          <div class="ga-heritage-image-frame">
            {%- assign heritage_img = section.settings.image -%}
            <img
              class="ga-heritage-img"
              src="{% if heritage_img != blank %}{{ heritage_img | image_url: width: 900 }}{% else %}{{ 'ghar-aangan-product-ghee.jpg' | asset_url }}{% endif %}"
              alt="{{ section.settings.title | escape }} - Ghar Aangan Himalayan Heritage"
              loading="lazy"
              width="900"
              height="675"
            >
            <!-- Authentic Corner Badge -->
            <div class="ga-heritage-floating-badge">
              <svg viewBox="0 0 24 24"><path d="M14 6l-3.75 5 2.85 3.8-1.6 1.2L7.25 10 2 17h20L14 6z"/></svg>
              <span>High-Altitude 5000+ Ft</span>
            </div>
          </div>
        </div>

        <!-- Content Column -->
        <div class="ga-heritage-content-col">
          <div class="ga-heritage-header-area">
            {%- if section.settings.subtitle != blank -%}
              <div class="ga-heritage-subtitle-wrap">
                <span class="ga-heritage-subtitle-dot"></span>
                <span class="ga-heritage-subtitle">{{ section.settings.subtitle | escape }}</span>
              </div>
            {%- endif -%}
            {%- if section.settings.title != blank -%}
              <h2 class="ga-heritage-title">{{ section.settings.title | escape }}</h2>
            {%- endif -%}
            <div class="ga-heritage-divider"></div>
          </div>

          <div class="ga-heritage-quote-box">
            <p class="ga-heritage-text">{{ section.settings.description | escape }}</p>
          </div>

          <!-- Heritage Values -->
          <div class="ga-heritage-values">
            <div class="ga-heritage-value-pill">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.4 7.4h7.6l-6.2 4.5 2.4 7.4-6.2-4.5-6.2 4.5 2.4-7.4-6.2-4.5h7.6z"/></svg>
              <span>Indigenous Badri Cattle</span>
            </div>
            <div class="ga-heritage-value-pill">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M17 8C8 10 5.9 16.17 3.82 21.34L5.71 22l1-2.3A4.49 4.49 0 0 0 8 20C19 20 22 3 22 3c-1 2-8 2.25-13 3.25S2 11.5 2 13.5s1.75 3.75 1.75 3.75C7 8 17 8 17 8z"/></svg>
              <span>Mountain-Grown Pulses</span>
            </div>
            <div class="ga-heritage-value-pill">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
              <span>Sil-Batta Stone Salts</span>
            </div>
          </div>

          <!-- Call to Action Row -->
          <div class="ga-heritage-action-row">
            <a href="{{ section.settings.cta_link | default: '#ga-specialties-shop' }}" class="ga-heritage-cta-btn">
              <span>{{ section.settings.cta_label | default: 'Shop Pure Specialties' }}</span>
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
            <span class="ga-heritage-origin-badge">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
              Direct Himalayan Farm Gate
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
{%- endunless -%}

{% schema %}
{
  "name": "GA Himalayan Heritage",
  "tag": "section",
  "class": "section hdt-section-ghar-aangan-heritage",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Section Background",
      "default": "#faf8f5"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card Background",
      "default": "#ffffff"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Heritage Image",
      "info": "Upload Himalayan heritage photo. Optimal 4:3 or 1:1 ratio."
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "HIMALAYAN HERITAGE"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Purity from the High Altitudes"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Heritage Narrative",
      "default": "From handcrafted Bilona A2 Ghee sourced from indigenous Badri and local Uttarakhand cattle to mountain-grown grains, heritage pulses, natural jaggery, medicinal fruit squashes, and traditional Himalayan seasonings, every product carries the warmth of home."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA Button Label",
      "default": "Shop Pure Specialties"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA Button Link"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "GA Himalayan Heritage"
    }
  ]
}
{% endschema %}
