{%- liquid
  assign pr_550 = all_products['a2-desi-pahadi-ghee-550ml']
  assign pr_1l = all_products['a2-desi-pahadi-ghee-1l']
  assign pr_2l = all_products['a2-desi-pahadi-ghee-2l']
  assign pr_5l = all_products['a2-desi-pahadi-ghee-5l']
  assign fallback_pr = all_products['a2-desi-pahadi-ghee']

  # Images
  assign img_550 = section.settings.image_550 | default: pr_550.featured_image | default: fallback_pr.featured_image
  assign img_1l = section.settings.image_1l | default: pr_1l.featured_image | default: fallback_pr.featured_image
  assign img_2l = section.settings.image_2l | default: pr_2l.featured_image | default: fallback_pr.featured_image
  assign img_5l = section.settings.image_5l | default: pr_5l.featured_image | default: fallback_pr.featured_image
-%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --section-pt: {{ section.settings.padding_top }}px;
    --section-pb: {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.background_color }};
  }
  .ga-packs-wrapper {
    padding-top: var(--section-pt);
    padding-bottom: var(--section-pb);
  }
  .ga-packs-header {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 32px;
    padding: 0 16px;
  }
  .ga-packs-subtitle {
    font-size: 11.5px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: #8c734b;
    font-weight: 800;
    margin-bottom: 6px;
    display: block;
  }
  .ga-packs-title {
    font-size: clamp(24px, 3vw, 32px);
    font-weight: 800;
    color: #1a332c;
    margin-bottom: 8px;
    line-height: 1.25;
  }
  .ga-packs-desc {
    font-size: 14px;
    color: #555;
    line-height: 1.5;
    margin: 0;
  }
  .ga-packs-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }
  @media (max-width: 1024px) {
    .ga-packs-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 14px;
    }
  }
  @media (max-width: 640px) {
    .ga-packs-grid {
      grid-template-columns: 1fr;
      gap: 14px;
    }
  }
  .ga-pack-card {
    background: #ffffff;
    border: 1.5px solid #e8e2d5;
    border-radius: 14px;
    padding: 20px 14px 16px;
    display: flex;
    flex-direction: column;
    position: relative;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 3px 12px rgba(0, 0, 0, 0.03);
    height: 100%;
  }
  .ga-pack-card:hover {
    border-color: #1a332c;
    transform: translateY(-3px);
    box-shadow: 0 10px 24px rgba(26, 51, 44, 0.1);
  }
  .ga-pack-card.is-featured {
    border: 2px solid #1a332c;
    background: #fdfbf7;
    box-shadow: 0 6px 20px rgba(26, 51, 44, 0.08);
  }
  .ga-pack-badge {
    position: absolute;
    top: -11px;
    left: 50%;
    transform: translateX(-50%);
    background: #c8933b;
    color: #ffffff;
    font-size: 9.5px;
    font-weight: 800;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    padding: 3px 10px;
    border-radius: 20px;
    white-space: nowrap;
    z-index: 2;
    box-shadow: 0 2px 6px rgba(0,0,0,0.15);
  }
  .ga-pack-image-wrap {
    width: 100%;
    height: 145px;
    margin-bottom: 10px;
    border-radius: 10px;
    background: #f9f7f2;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    position: relative;
    padding: 8px;
  }
  .ga-pack-image-wrap img {
    max-height: 130px;
    max-width: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    transition: transform 0.3s ease;
  }
  .ga-pack-card:hover .ga-pack-image-wrap img {
    transform: scale(1.06);
  }
  .ga-pack-placeholder-icon {
    width: 56px;
    height: 56px;
    color: #c4b69d;
  }
  .ga-pack-card-top-tags {
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    gap: 4px !important;
    margin-bottom: 4px !important;
  }
  .ga-pack-size-tag {
    font-size: 11px;
    font-weight: 700;
    color: #8c734b;
    text-transform: uppercase;
    letter-spacing: 0.4px;
  }
  .ga-pack-festive-badge {
    font-size: 9.5px !important;
    font-weight: 800 !important;
    color: #ffffff !important;
    background: linear-gradient(135deg, #dc2626 0%, #b91c1c 100%) !important;
    border: 1px solid #991b1b !important;
    padding: 2px 6px !important;
    border-radius: 10px !important;
    white-space: nowrap !important;
    letter-spacing: 0.3px !important;
    text-transform: uppercase !important;
    box-shadow: 0 1px 4px rgba(220, 38, 38, 0.25) !important;
  }
  .ga-pack-name {
    font-size: 16px;
    font-weight: 800;
    color: #1a332c;
    margin-bottom: 3px;
    line-height: 1.25;
  }
  .ga-pack-highlight {
    font-size: 12px;
    color: #666;
    margin-bottom: 8px;
    line-height: 1.35;
    min-height: 33px;
  }
  .ga-pack-price-box {
    margin-bottom: 6px;
    padding-bottom: 6px;
    border-bottom: 1px dashed #e8e2d5;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 6px;
  }
  .ga-pack-price-row {
    display: flex;
    align-items: baseline;
    gap: 6px;
  }
  .ga-pack-price {
    font-size: 20px;
    font-weight: 800;
    color: #1a332c;
  }
  .ga-pack-compare {
    font-size: 12px;
    color: #888;
    text-decoration: line-through;
  }
  .ga-pack-shipping-pill {
    display: flex;
    flex-direction: column;
    gap: 3px;
    margin-bottom: 10px;
    background: #f8faf9;
    border: 1px solid #e1e9e5;
    border-radius: 8px;
    padding: 5px 8px;
  }
  .ga-pack-ship-prepaid {
    display: inline-flex;
    align-items: center;
    gap: 4.5px;
    font-size: 11px;
    font-weight: 750;
    color: #1a332c;
    line-height: 1.2;
  }
  .ga-pack-ship-prepaid svg {
    color: #16a34a;
    flex-shrink: 0;
  }
  .ga-pack-ship-cod {
    font-size: 10px;
    font-weight: 600;
    color: #b91c1c;
    line-height: 1.2;
    padding-left: 17px;
  }
  .ga-pack-features {
    list-style: none;
    padding: 0;
    margin: 0 0 14px;
    flex-grow: 1;
  }
  .ga-pack-features li {
    font-size: 11.5px;
    color: #444;
    margin-bottom: 5px;
    display: flex;
    align-items: center;
    gap: 6px;
    line-height: 1.3;
  }
  .ga-pack-features svg {
    flex-shrink: 0;
    color: #1a332c;
    width: 13px;
    height: 13px;
  }
  .ga-pack-btn {
    display: block;
    text-align: center;
    background: #1a332c;
    color: #ffffff !important;
    text-decoration: none !important;
    padding: 9px 12px;
    border-radius: 7px;
    font-size: 12.5px;
    font-weight: 700;
    transition: all 0.2s ease;
    margin-top: auto;
  }
  .ga-pack-btn:hover {
    background: #284c42;
    transform: translateY(-1px);
    box-shadow: 0 3px 10px rgba(26, 51, 44, 0.15);
  }
  .ga-pack-btn-outline {
    background: #ffffff;
    color: #1a332c !important;
    border: 1.5px solid #1a332c;
  }
  .ga-pack-btn-outline:hover {
    background: #1a332c;
    color: #ffffff !important;
  }
{%- endstyle -%}

