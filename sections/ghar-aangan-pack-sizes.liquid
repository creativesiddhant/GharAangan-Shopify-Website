{%- style -%}
  #shopify-section-{{ section.id }} {
    --section-pt: {{ section.settings.padding_top }}px;
    --section-pb: {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.background_color }};
  }
  .ga-packs-wrapper {
    padding-top: var(--section-pt);
    padding-bottom: var(--section-pb);
  }
  .ga-packs-header {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 40px;
  }
  .ga-packs-subtitle {
    font-size: 12px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: #8c734b;
    font-weight: 700;
    margin-bottom: 8px;
    display: block;
  }
  .ga-packs-title {
    font-size: clamp(26px, 3.5vw, 36px);
    font-weight: 700;
    color: #1a332c;
    margin-bottom: 12px;
    line-height: 1.25;
  }
  .ga-packs-desc {
    font-size: 15px;
    color: #555;
    line-height: 1.6;
    margin: 0;
  }
  .ga-packs-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }
  @media (max-width: 1024px) {
    .ga-packs-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }
  }
  @media (max-width: 640px) {
    .ga-packs-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }
  }
  .ga-pack-card {
    background: #ffffff;
    border: 1.5px solid #e8e2d5;
    border-radius: 16px;
    padding: 28px 20px 24px;
    display: flex;
    flex-direction: column;
    position: relative;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.03);
  }
  .ga-pack-card:hover {
    border-color: #1a332c;
    transform: translateY(-4px);
    box-shadow: 0 12px 28px rgba(26, 51, 44, 0.1);
  }
  .ga-pack-card.is-featured {
    border: 2px solid #1a332c;
    background: #fdfbf7;
    box-shadow: 0 8px 24px rgba(26, 51, 44, 0.08);
  }
  .ga-pack-badge {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    background: #c8933b;
    color: #ffffff;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    padding: 4px 12px;
    border-radius: 20px;
    white-space: nowrap;
    box-shadow: 0 2px 8px rgba(0,0,0,0.15);
  }
  .ga-pack-badge.badge-red {
    background: #b33b28;
  }
  .ga-pack-badge.badge-green {
    background: #1a332c;
  }
  .ga-pack-size-tag {
    font-size: 13px;
    font-weight: 600;
    color: #8c734b;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 4px;
  }
  .ga-pack-name {
    font-size: 18px;
    font-weight: 700;
    color: #1a332c;
    margin-bottom: 8px;
    line-height: 1.3;
  }
  .ga-pack-highlight {
    font-size: 13px;
    color: #666;
    margin-bottom: 18px;
    line-height: 1.4;
    min-height: 38px;
  }
  .ga-pack-price-box {
    margin-bottom: 20px;
    padding-bottom: 16px;
    border-bottom: 1px dashed #e8e2d5;
    display: flex;
    align-items: baseline;
    gap: 8px;
  }
  .ga-pack-price {
    font-size: 24px;
    font-weight: 800;
    color: #1a332c;
  }
  .ga-pack-compare {
    font-size: 14px;
    color: #888;
    text-decoration: line-through;
  }
  .ga-pack-features {
    list-style: none;
    padding: 0;
    margin: 0 0 24px;
    flex-grow: 1;
  }
  .ga-pack-features li {
    font-size: 13px;
    color: #444;
    margin-bottom: 10px;
    display: flex;
    align-items: center;
    gap: 8px;
    line-height: 1.3;
  }
  .ga-pack-features svg {
    flex-shrink: 0;
    color: #1a332c;
  }
  .ga-pack-btn {
    display: block;
    text-align: center;
    background: #1a332c;
    color: #ffffff !important;
    text-decoration: none !important;
    padding: 12px 16px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 600;
    transition: all 0.2s ease;
  }
  .ga-pack-btn:hover {
    background: #284c42;
    transform: translateY(-1px);
  }
  .ga-pack-btn-outline {
    background: #ffffff;
    color: #1a332c !important;
    border: 1.5px solid #1a332c;
  }
  .ga-pack-btn-outline:hover {
    background: #1a332c;
    color: #ffffff !important;
  }
{%- endstyle -%}

