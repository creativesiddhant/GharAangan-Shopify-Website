{%- liquid
  assign pr_550 = all_products['a2-desi-pahadi-ghee-550ml']
  assign pr_1l = all_products['a2-desi-pahadi-ghee-1l']
  assign pr_2l = all_products['a2-desi-pahadi-ghee-2l']
  assign pr_5l = all_products['a2-desi-pahadi-ghee-5l']
  assign fallback_pr = all_products['a2-desi-pahadi-ghee']

  # Images
  assign img_550 = section.settings.image_550 | default: pr_550.featured_image | default: fallback_pr.featured_image
  assign img_1l = section.settings.image_1l | default: pr_1l.featured_image | default: fallback_pr.featured_image
  assign img_2l = section.settings.image_2l | default: pr_2l.featured_image | default: fallback_pr.featured_image
  assign img_5l = section.settings.image_5l | default: pr_5l.featured_image | default: fallback_pr.featured_image
-%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --section-pt: {{ section.settings.padding_top }}px;
    --section-pb: {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.background_color }};
  }
  .ga-packs-wrapper {
    padding-top: var(--section-pt);
    padding-bottom: var(--section-pb);
  }
  .ga-packs-header {
    text-align: center;
    max-width: 760px;
    margin: 0 auto 36px;
  }
  .ga-rakhi-banner-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: linear-gradient(135deg, #b33b28 0%, #8c2415 100%);
    color: #ffffff;
    padding: 6px 16px;
    border-radius: 24px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    margin-bottom: 12px;
    box-shadow: 0 4px 12px rgba(179, 59, 40, 0.25);
  }
  .ga-packs-title {
    font-size: clamp(26px, 3.5vw, 36px);
    font-weight: 700;
    color: #1a332c;
    margin-bottom: 10px;
    line-height: 1.25;
  }
  .ga-packs-desc {
    font-size: 15px;
    color: #555;
    line-height: 1.6;
    margin: 0;
  }
  .ga-packs-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }
  @media (max-width: 1024px) {
    .ga-packs-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }
  }
  @media (max-width: 640px) {
    .ga-packs-grid {
      grid-template-columns: 1fr;
      gap: 18px;
    }
  }
  .ga-pack-card {
    background: #ffffff;
    border: 1.5px solid #e8e2d5;
    border-radius: 16px;
    padding: 26px 18px 22px;
    display: flex;
    flex-direction: column;
    position: relative;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.03);
  }
  .ga-pack-card:hover {
    border-color: #1a332c;
    transform: translateY(-4px);
    box-shadow: 0 14px 30px rgba(26, 51, 44, 0.12);
  }
  .ga-pack-card.is-featured {
    border: 2px solid #b33b28;
    background: #fffdfa;
    box-shadow: 0 8px 24px rgba(179, 59, 40, 0.1);
  }
  .ga-pack-badge {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    background: #c8933b;
    color: #ffffff;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    padding: 5px 14px;
    border-radius: 20px;
    white-space: nowrap;
    z-index: 2;
    box-shadow: 0 3px 10px rgba(0,0,0,0.18);
  }
  .ga-pack-badge.badge-rakhi-red {
    background: linear-gradient(135deg, #b33b28 0%, #d94832 100%);
  }
  .ga-pack-badge.badge-rakhi-gold {
    background: linear-gradient(135deg, #c8933b 0%, #dfcaa2 100%);
    color: #1a332c;
  }
  .ga-pack-badge.badge-rakhi-green {
    background: #1a332c;
  }
  .ga-pack-image-wrap {
    width: 100%;
    height: 170px;
    margin-bottom: 14px;
    border-radius: 12px;
    background: #f9f7f2;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    position: relative;
    padding: 10px;
  }
  .ga-pack-image-wrap img {
    max-height: 150px;
    max-width: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    transition: transform 0.4s ease;
  }
  .ga-pack-card:hover .ga-pack-image-wrap img {
    transform: scale(1.08);
  }
  .ga-pack-size-tag {
    font-size: 12px;
    font-weight: 600;
    color: #8c734b;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 4px;
  }
  .ga-pack-name {
    font-size: 17px;
    font-weight: 700;
    color: #1a332c;
    margin-bottom: 6px;
    line-height: 1.3;
  }
  .ga-pack-highlight {
    font-size: 12.5px;
    color: #666;
    margin-bottom: 14px;
    line-height: 1.4;
    min-height: 35px;
  }
  .ga-offer-ribbon {
    background: #fdf5f3;
    border: 1px dashed #e89587;
    border-radius: 8px;
    padding: 8px 10px;
    margin-bottom: 14px;
    font-size: 12px;
    color: #8c2415;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 6px;
    line-height: 1.3;
  }
  .ga-offer-ribbon code {
    background: #ffffff;
    border: 1px solid #d94832;
    padding: 2px 6px;
    border-radius: 4px;
    color: #b33b28;
    font-weight: 700;
    font-size: 11.5px;
    letter-spacing: 0.5px;
  }
  .ga-pack-price-box {
    margin-bottom: 16px;
    padding-bottom: 12px;
    border-bottom: 1px dashed #e8e2d5;
    display: flex;
    align-items: baseline;
    gap: 8px;
  }
  .ga-pack-price {
    font-size: 22px;
    font-weight: 800;
    color: #1a332c;
  }
  .ga-pack-compare {
    font-size: 13px;
    color: #888;
    text-decoration: line-through;
  }
  .ga-pack-features {
    list-style: none;
    padding: 0;
    margin: 0 0 20px;
    flex-grow: 1;
  }
  .ga-pack-features li {
    font-size: 12.5px;
    color: #444;
    margin-bottom: 8px;
    display: flex;
    align-items: center;
    gap: 7px;
    line-height: 1.3;
  }
  .ga-pack-features svg {
    flex-shrink: 0;
    color: #1a332c;
  }
  .ga-pack-btn {
    display: block;
    text-align: center;
    background: #1a332c;
    color: #ffffff !important;
    text-decoration: none !important;
    padding: 11px 16px;
    border-radius: 8px;
    font-size: 13.5px;
    font-weight: 600;
    transition: all 0.2s ease;
  }
  .ga-pack-btn:hover {
    background: #284c42;
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(26, 51, 44, 0.2);
  }
  .ga-pack-btn-rakhi {
    background: #b33b28 !important;
  }
  .ga-pack-btn-rakhi:hover {
    background: #8c2415 !important;
    box-shadow: 0 4px 12px rgba(179, 59, 40, 0.3) !important;
  }
  .ga-pack-btn-outline {
    background: #ffffff;
    color: #1a332c !important;
    border: 1.5px solid #1a332c;
  }
  .ga-pack-btn-outline:hover {
    background: #1a332c;
    color: #ffffff !important;
  }
{%- endstyle -%}

