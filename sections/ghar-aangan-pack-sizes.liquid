{% schema %}
{
  "name": "Ghar Aangan Pack Sizes",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "100% PURE BILONA A2 GHEE"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Select Your Ideal Pack Size"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Handcrafted over wood-fires from Himalayan Badri cows. Exclusive Rakhi discounts auto-applied and ready for celebration."
    },
    {
      "type": "image_picker",
      "id": "image_550",
      "label": "550ml Pack Image (Optional Override)"
    },
    {
      "type": "image_picker",
      "id": "image_1l",
      "label": "1 Litre Pack Image (Optional Override)"
    },
    {
      "type": "image_picker",
      "id": "image_2l",
      "label": "2 Litres Pack Image (Optional Override)"
    },
    {
      "type": "image_picker",
      "id": "image_5l",
      "label": "5 Litres Pack Image (Optional Override)"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding Top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Ghar Aangan Pack Sizes"
    }
  ]
}
{% endschema %}
