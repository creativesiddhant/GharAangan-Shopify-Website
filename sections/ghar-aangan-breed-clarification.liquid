{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .ga-clarification-section {
    background-color: {{ section.settings.background_color | default: '#fdfbf7' }};
    position: relative;
    overflow: hidden;
  }

  .ga-clarification-header {
    text-align: center;
    max-width: 820px;
    margin: 0 auto 4.5rem auto;
  }

  .ga-clarification-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }

  @media screen and (min-width: 990px) {
    .ga-clarification-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 3rem;
    }
  }

  .ga-clarification-card {
    background-color: #ffffff;
    border: 1.5px solid rgba(26, 51, 44, 0.12);
    border-radius: 12px;
    padding: 3.5rem 2.8rem;
    display: flex;
    flex-direction: column;
    position: relative;
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
    box-shadow: 0 8px 24px rgba(26, 51, 44, 0.04);
  }

  .ga-clarification-card:hover {
    transform: translateY(-5px);
    border-color: var(--ga-forest-green, #1a332c);
    box-shadow: 0 16px 36px rgba(26, 51, 44, 0.09);
  }

  .ga-clarification-badge {
    display: inline-block;
    align-self: flex-start;
    padding: 0.4rem 1.2rem;
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border-radius: 50px;
    background: #f4efe6;
    color: var(--ga-forest-green, #1a332c);
    margin-bottom: 2rem;
  }

  .ga-clarification-card-title {
    font-family: var(--ga-font-family-serif, Georgia, serif);
    font-size: 2.2rem;
    font-weight: 600;
    color: var(--ga-forest-green, #1a332c);
    line-height: 1.3;
    margin: 0 0 1.5rem 0;
  }

  .ga-clarification-card-body {
    font-size: 1.45rem;
    line-height: 1.7;
    color: #444444;
    margin: 0;
    flex-grow: 1;
  }

  .ga-clarification-quote-box {
    margin-top: 4.5rem;
    background: var(--ga-forest-green, #1a332c);
    color: #ffffff;
    border-radius: 12px;
    padding: 3rem 3.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    align-items: center;
    text-align: center;
  }

  @media screen and (min-width: 750px) {
    .ga-clarification-quote-box {
      flex-direction: row;
      text-align: left;
      justify-content: space-between;
      gap: 3rem;
    }
  }

  .ga-clarification-quote-text {
    font-family: var(--ga-font-family-serif, Georgia, serif);
    font-size: 1.85rem;
    font-style: italic;
    line-height: 1.5;
    margin: 0;
    color: #ffffff;
  }

  .ga-clarification-quote-note {
    font-size: 1.25rem;
    color: #d1dcd5;
    line-height: 1.5;
    margin: 0;
    max-width: 320px;
    border-top: 1px solid rgba(255, 255, 255, 0.2);
    padding-top: 1rem;
  }

  @media screen and (min-width: 750px) {
    .ga-clarification-quote-note {
      border-top: none;
      border-left: 1px solid rgba(255, 255, 255, 0.2);
      padding-top: 0;
      padding-left: 2rem;
      min-width: 260px;
    }
  }
{%- endstyle -%}

<div class="ga-clarification-section section-{{ section.id }}-padding">
  <div class="page-width">
    <div class="ga-clarification-header ga-reveal">
      <span class="ga-subtitle">{{ section.settings.subtitle | default: 'TRANSPARENCY & CATTLE HERITAGE' | escape }}</span>
      <h2 class="ga-title">{{ section.settings.title | default: 'Understanding Breed Identity & A1/A2 Sourcing' | escape }}</h2>
      <p class="ga-body" style="font-size: 1.55rem; color: #555555; margin-top: 1rem;">
        {{ section.settings.description | default: 'At Ghar Aangan, we celebrate Uttarakhand’s native Badri cattle while upholding complete transparency on milk genetics, breed characteristics, and verified beta-casein protein standards.' | escape }}
      </p>
    </div>

    <div class="ga-clarification-grid">
      <!-- Card 1: Badri Cow Heritage -->
      <div class="ga-clarification-card ga-reveal">
        <span class="ga-clarification-badge">Himalayan Heritage</span>
        <h3 class="ga-clarification-card-title">Badri Cow — A Speciality of Uttarakhand</h3>
        <p class="ga-clarification-card-body">
          Badri cattle are an indigenous cattle breed of Uttarakhand, associated with the state's hilly terrain and local livestock heritage. At Ghar Aangan, Badri cattle are an important part of the Pahadi tradition we want to preserve and share.
        </p>
      </div>

      <!-- Card 2: Breed vs A1/A2 Science -->
      <div class="ga-clarification-card ga-reveal">
        <span class="ga-clarification-badge">Milk Protein Genetics</span>
        <h3 class="ga-clarification-card-title">Badri &amp; A1/A2 Are Not the Same Thing</h3>
        <p class="ga-clarification-card-body">
          There is an important distinction: <strong>Badri is a breed identity</strong>, while <strong>A1/A2 describes variants of beta-casein</strong>, a milk protein. Therefore, A1/A2 status alone cannot be used to identify a cow as Badri. Scientific studies have found A2A2 animals within Jersey populations as well as indigenous Indian cattle populations.
        </p>
      </div>

      <!-- Card 3: Our Sourcing Approach -->
      <div class="ga-clarification-card ga-reveal">
        <span class="ga-clarification-badge">Careful Quality Standards</span>
        <h3 class="ga-clarification-card-title">Our Sourcing Approach</h3>
        <p class="ga-clarification-card-body">
          Ghar Aangan works with cattle sourced from Uttarakhand and maintains defined quality and sourcing standards. Our cattle sources may include Badri cattle, local Uttarakhand cattle, and other breeds, including Jersey. We keep breed identity and A1/A2 terminology separate and do not use one as proof of the other.
        </p>
      </div>
    </div>

    <!-- Tone & Compliance Banner -->
    <div class="ga-clarification-quote-box ga-reveal">
      <p class="ga-clarification-quote-text">
        “We respect Badri as a unique Uttarakhand breed, and we are equally transparent that breed identity and A1/A2 are not interchangeable terms.”
      </p>
      <p class="ga-clarification-quote-note">
        All batches verified for A2 beta-casein purity. Handcrafted through authentic Bilona curd-churning in Uttarakhand.
      </p>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "GA Breed Clarification",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Section Subtitle",
      "default": "TRANSPARENCY & CATTLE HERITAGE"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Understanding Breed Identity & A1/A2 Sourcing"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Section Description",
      "default": "At Ghar Aangan, we celebrate Uttarakhand’s native Badri cattle while upholding complete transparency on milk genetics, breed characteristics, and verified beta-casein protein standards."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#fdfbf7"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "GA Breed Clarification"
    }
  ]
}
{% endschema %}
