{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .ga-quality-section {
    background-color: {{ section.settings.background_color | default: '#fdfbf7' }};
    border-top: 1px solid rgba(26, 51, 44, 0.08);
    border-bottom: 1px solid rgba(26, 51, 44, 0.08);
    overflow: hidden;
    max-width: 100%;
    box-sizing: border-box;
  }

  .ga-quality-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    min-width: 0;
    max-width: 100%;
    box-sizing: border-box;
  }

  @media screen and (min-width: 990px) {
    .ga-quality-grid {
      grid-template-columns: 1.15fr 0.85fr;
      gap: 4rem;
      align-items: start;
    }
  }

  .ga-quality-card {
    background: #ffffff;
    border: 1.5px solid rgba(26, 51, 44, 0.12);
    border-radius: 12px;
    padding: 3.5rem 3rem;
    box-shadow: var(--ga-card-shadow);
    min-width: 0;
    max-width: 100%;
    box-sizing: border-box;
    overflow: hidden;
  }

  @media screen and (max-width: 749px) {
    .ga-quality-card {
      padding: 2rem 1.4rem;
    }
  }

  .ga-quality-badge-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.2rem;
    margin-bottom: 2rem;
  }

  .ga-pill-verified {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    background: rgba(45, 92, 78, 0.1);
    color: var(--ga-forest-green);
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.5rem 1.2rem;
    border-radius: 20px;
  }

  .ga-batch-tag {
    font-size: 1.25rem;
    color: #666;
    font-family: monospace;
    background: #f4ece1;
    padding: 0.4rem 1rem;
    border-radius: 4px;
  }

  .ga-table-responsive {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    margin: 1.5rem 0;
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
  }

  .ga-quality-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 1.35rem;
    box-sizing: border-box;
  }

  @media screen and (max-width: 640px) {
    .ga-quality-table th,
    .ga-quality-table td {
      padding: 0.8rem 0.6rem;
      font-size: 1.15rem;
    }
  }

  .ga-quality-table th {
    text-align: left;
    padding: 1rem 1.2rem;
    border-bottom: 2px solid var(--ga-forest-green);
    font-weight: 700;
    color: var(--ga-forest-green);
    font-size: 1.25rem;
    letter-spacing: 0.05em;
  }

  .ga-quality-table td {
    padding: 1.2rem;
    border-bottom: 1px solid rgba(26, 51, 44, 0.08);
    color: var(--ga-dark-text);
  }

  .ga-pass-badge {
    color: #16a34a;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .ga-specs-list {
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
  }

  .ga-spec-item {
    background: #ffffff;
    border: 1px solid rgba(26, 51, 44, 0.1);
    border-radius: 10px;
    padding: 2rem 2.2rem;
    display: flex;
    gap: 1.6rem;
    align-items: flex-start;
  }

  .ga-spec-icon {
    width: 4rem;
    height: 4rem;
    border-radius: 50%;
    background: rgba(205, 162, 80, 0.15);
    color: var(--ga-forest-green);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .ga-spec-title {
    font-family: var(--ga-font-family-serif);
    font-size: 1.65rem;
    font-weight: 600;
    color: var(--ga-forest-green);
    margin: 0 0 0.4rem 0;
  }

  .ga-spec-desc {
    font-size: 1.35rem;
    color: #555;
    line-height: 1.5;
    margin: 0;
  }
{%- endstyle -%}

<div class="ga-quality-section section-{{ section.id }}-padding">
  <div class="page-width">
    <div class="ga-section-header ga-reveal" style="text-align: center; margin-bottom: 4rem;">
      <span class="ga-subtitle">{{ section.settings.subtitle | default: '100% TRANSPARENCY & VERIFIED ORIGIN' | escape }}</span>
      <h2 class="ga-title" style="font-size: clamp(2.4rem, 3.5vw, 3.8rem);">{{ section.settings.title | default: 'Quality You Can Verify' | escape }}</h2>
      <p class="ga-body" style="max-width: 680px; margin: 0 auto; font-size: 1.5rem; color: #555;">
        {{ section.settings.description | default: 'Every jar of Ghar Aangan ghee is pure, unadulterated Himalayan cow milk fat crafted in Uttarakhand, verified for pure A2 beta-casein. Below is our verified testing analysis and production standards.' | escape }}
      </p>
    </div>

    <div class="ga-quality-grid">
      <!-- Left Column: Official Chemical Analysis Table -->
      <div class="ga-quality-card ga-reveal">
        <div class="ga-quality-badge-row">
          <span class="ga-pill-verified">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
            NABL ACCREDITED LAB VERIFIED
          </span>
          <span class="ga-batch-tag">Batch: GA/BG-2026/06</span>
        </div>

        <h3 class="ga-title" style="font-size: 2.2rem; margin: 0 0 0.8rem 0;">Laboratory Certificate of Analysis</h3>
        <p class="ga-body" style="font-size: 1.35rem; color: #666; margin-bottom: 2rem;">
          Conducted under standard food safety methods. Zero trace of adulterants, vegetable fats, starch, or chemical preservatives.
        </p>

        <div class="ga-table-responsive">
          <table class="ga-quality-table">
            <thead>
              <tr>
                <th>TEST PARAMETER</th>
                <th>FSSAI STANDARD</th>
                <th>BATCH VALUE</th>
                <th>RESULT</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><strong>A2 Beta-Casein DNA</strong></td>
                <td>A2A2 Genotype</td>
                <td><strong>A2 Only (Zero A1)</strong></td>
                <td><span class="ga-pass-badge">✓ PASS</span></td>
              </tr>
              <tr style="background: #faf8f5;">
                <td><strong>Moisture Content</strong></td>
                <td>Max 0.3%</td>
                <td><strong>0.12%</strong></td>
                <td><span class="ga-pass-badge">✓ PASS</span></td>
              </tr>
              <tr>
                <td><strong>Free Fatty Acids (FFA)</strong></td>
                <td>Max 3.0%</td>
                <td><strong>0.82%</strong></td>
                <td><span class="ga-pass-badge">✓ PASS</span></td>
              </tr>
              <tr style="background: #faf8f5;">
                <td><strong>BR Reading (Refractometry)</strong></td>
                <td>40.0 – 43.0</td>
                <td><strong>41.2</strong></td>
                <td><span class="ga-pass-badge">✓ PASS</span></td>
              </tr>
              <tr>
                <td><strong>Baudouin Test (Vanaspati)</strong></td>
                <td>Negative</td>
                <td><strong>Negative</strong></td>
                <td><span class="ga-pass-badge">✓ PASS</span></td>
              </tr>
              <tr style="background: #faf8f5;">
                <td><strong>Heavy Metals &amp; Starch</strong></td>
                <td>Absent / Not Detected</td>
                <td><strong>Not Detected</strong></td>
                <td><span class="ga-pass-badge">✓ PASS</span></td>
              </tr>
            </tbody>
          </table>
        </div>

        <div style="font-size: 1.25rem; color: #777; line-height: 1.5; border-top: 1px solid rgba(26,51,44,0.08); padding-top: 1.5rem;">
          * Testing performed by certified third-party analytical laboratory in accordance with FSSAI regulations. 100% single ingredient: Pahadi Cow Milk Fat (Tested A2).
        </div>
      </div>

      <!-- Right Column: Manufacturing, Ingredients & Shelf Life -->
      <div class="ga-specs-list ga-reveal">
        <div class="ga-spec-item">
          <div class="ga-spec-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
          </div>
          <div>
            <h4 class="ga-spec-title">Single Ingredient Purity</h4>
            <p class="ga-spec-desc"><strong>100% Pure Pahadi Cow Milk Fat (Tested A2).</strong> No artificial colors, no preservatives, no added fragrance, and no vegetable/palm fats.</p>
          </div>
        </div>

        <div class="ga-spec-item">
          <div class="ga-spec-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
          </div>
          <div>
            <h4 class="ga-spec-title">12–18 Month Pantry Shelf Life</h4>
            <p class="ga-spec-desc">Low moisture (0.12%) naturally protects the ghee. Store in a dry pantry at room temperature. <strong>No refrigeration needed</strong> (refrigerating ruins its granular danedar texture).</p>
          </div>
        </div>

        <div class="ga-spec-item">
          <div class="ga-spec-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
          </div>
          <div>
            <h4 class="ga-spec-title">Handcrafted in Uttarakhand</h4>
            <p class="ga-spec-desc">Prepared in small, artisanal batches in Uttarakhand following the Ayurvedic 5-step Bilona method over firewood stoves.</p>
          </div>
        </div>

        <div class="ga-spec-item">
          <div class="ga-spec-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
          </div>
          <div>
            <h4 class="ga-spec-title">Direct Support &amp; Assistance</h4>
            <p class="ga-spec-desc">Questions about our batch? Call or WhatsApp our team at <strong>+91 90272 48335</strong> or email <strong>gharaanganmani@gmail.com</strong>.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "GA Quality & Trust",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#fdfbf7"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "100% TRANSPARENCY & VERIFIED ORIGIN"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Quality You Can Verify"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Every jar of Ghar Aangan ghee is pure, unadulterated Himalayan cow milk fat crafted in Uttarakhand, verified for pure A2 beta-casein. Below is our verified testing analysis and production standards."
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "GA Quality & Trust"
    }
  ]
}
{% endschema %}
