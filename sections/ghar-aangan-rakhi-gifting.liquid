{%- comment -%}
  Ghar Aangan - Raksha Bandhan Festive Gifting Showcase
  Can be hidden or removed anytime after the festival from the Theme Customizer.
{%- endcomment -%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --section-pt: {{ section.settings.padding_top | default: 50 }}px;
    --section-pb: {{ section.settings.padding_bottom | default: 50 }}px;
    background: {{ section.settings.bg_color | default: '#fdfbf7' }};
  }
  .ga-rakhi-section {
    padding-top: var(--section-pt);
    padding-bottom: var(--section-pb);
    position: relative;
    overflow: hidden;
  }
  .ga-rakhi-container {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 20px;
  }
  .ga-rakhi-card {
    background: #ffffff;
    border: 1.5px solid #ebd8c8;
    border-radius: 20px;
    padding: 40px;
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: 40px;
    align-items: center;
    box-shadow: 0 10px 30px rgba(179, 59, 40, 0.06);
    position: relative;
  }
  @media (max-width: 991px) {
    .ga-rakhi-card {
      grid-template-columns: 1fr;
      padding: 28px 20px;
      gap: 30px;
    }
  }

  /* Image Visual Collage */
  .ga-rakhi-visual-wrap {
    position: relative;
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 14px;
    align-items: center;
  }
  .ga-rakhi-img-main {
    width: 100%;
    height: 380px;
    border-radius: 16px;
    object-fit: cover;
    box-shadow: 0 8px 24px rgba(0,0,0,0.12);
  }
  .ga-rakhi-img-sub-wrap {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .ga-rakhi-img-sub {
    width: 100%;
    height: 183px;
    border-radius: 14px;
    object-fit: cover;
    box-shadow: 0 6px 18px rgba(0,0,0,0.08);
  }
  @media (max-width: 640px) {
    .ga-rakhi-visual-wrap {
      grid-template-columns: 1fr;
    }
    .ga-rakhi-img-main {
      height: 260px;
    }
    .ga-rakhi-img-sub-wrap {
      display: none;
    }
  }

  /* Content */
  .ga-rakhi-tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: linear-gradient(135deg, #b33b28 0%, #8c2415 100%);
    color: #ffffff;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    padding: 6px 14px;
    border-radius: 20px;
    margin-bottom: 14px;
    box-shadow: 0 3px 10px rgba(179, 59, 40, 0.2);
  }
  .ga-rakhi-heading {
    font-size: clamp(24px, 3.2vw, 34px);
    font-weight: 700;
    color: #1a332c;
    line-height: 1.25;
    margin-bottom: 14px;
  }
  .ga-rakhi-subtext {
    font-size: 15px;
    color: #555;
    line-height: 1.6;
    margin-bottom: 22px;
  }

  /* Perks List */
  .ga-rakhi-perks {
    list-style: none;
    padding: 0;
    margin: 0 0 26px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .ga-rakhi-perk {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    font-size: 13.5px;
    color: #333;
    line-height: 1.4;
  }
  .ga-rakhi-perk-icon {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: #fdf5f3;
    color: #b33b28;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 13px;
    flex-shrink: 0;
    margin-top: 1px;
    border: 1px solid #ebd8c8;
  }
  .ga-rakhi-perk strong {
    color: #1a332c;
  }

  /* Buttons */
  .ga-rakhi-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .ga-rakhi-btn-primary {
    background: #b33b28;
    color: #ffffff !important;
    text-decoration: none !important;
    font-weight: 600;
    font-size: 14px;
    padding: 12px 24px;
    border-radius: 8px;
    transition: all 0.2s ease;
    box-shadow: 0 4px 14px rgba(179, 59, 40, 0.25);
  }
  .ga-rakhi-btn-primary:hover {
    background: #8c2415;
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(179, 59, 40, 0.35);
  }
  .ga-rakhi-btn-secondary {
    background: #ffffff;
    color: #1a332c !important;
    border: 1.5px solid #1a332c;
    text-decoration: none !important;
    font-weight: 600;
    font-size: 14px;
    padding: 12px 22px;
    border-radius: 8px;
    transition: all 0.2s ease;
  }
  .ga-rakhi-btn-secondary:hover {
    background: #1a332c;
    color: #ffffff !important;
  }
{%- endstyle -%}

<div class="ga-rakhi-section">
  <div class="ga-rakhi-container">
    <div class="ga-rakhi-card">
      <!-- Left Visuals -->
      <div class="ga-rakhi-visual-wrap">
        <img
          src="{{ 'rakhi-festive-gift.jpg' | asset_url }}"
          alt="Raksha Bandhan Gifting with Pure Ghee - Ghar Aangan"
          class="ga-rakhi-img-main"
          loading="lazy"
        >
        <div class="ga-rakhi-img-sub-wrap">
          <img
            src="{{ 'rakhi-festive-craft.jpg' | asset_url }}"
            alt="Handcrafted Sacred Rakhi and Tradition"
            class="ga-rakhi-img-sub"
            loading="lazy"
          >
          <img
            src="{{ 'rakhi-festive-tradition.jpg' | asset_url }}"
            alt="Vedic Festive Rituals - Roli Chawal"
            class="ga-rakhi-img-sub"
            loading="lazy"
          >
        </div>
      </div>

      <!-- Right Content -->
      <div class="ga-rakhi-content">
        <div class="ga-rakhi-tag">🪢 Raksha Bandhan Festive Edition</div>
        <h2 class="ga-rakhi-heading">Gift the Purest Himalayan Blessing of Good Health</h2>
        <p class="ga-rakhi-subtext">
          Celebrate the bond of love and protection with something pure and timeless. Replace processed sweets with authentic wood-fired Badri Cow A2 Bilona Ghee, handcrafted high in the Uttarakhand Himalayas.
        </p>

        <ul class="ga-rakhi-perks">
          <li class="ga-rakhi-perk">
            <span class="ga-rakhi-perk-icon">🎁</span>
            <div><strong>1 Litre Jar:</strong> Flat <strong>₹50 Instant Discount</strong> auto-applied in your cart.</div>
          </li>
          <li class="ga-rakhi-perk">
            <span class="ga-rakhi-perk-icon">🪢</span>
            <div><strong>2 Litres Twin Combo:</strong> Save an extra <strong>5% OFF</strong> with festive code <strong>RAKHIWITHGA</strong>.</div>
          </li>
          <li class="ga-rakhi-perk">
            <span class="ga-rakhi-perk-icon">🚚</span>
            <div><strong>5 Litres Family Saver:</strong> Enjoy <strong>Free Express Delivery</strong> right to your sibling’s doorstep.</div>
          </li>
        </ul>

        <div class="ga-rakhi-actions">
          <a href="#shopify-section-template--22055627751717__ghar_aangan_pack_sizes" class="ga-rakhi-btn-primary">Explore Festive Pack Sizes</a>
          <a href="/products/a2-desi-pahadi-ghee-1l" class="ga-rakhi-btn-secondary">Shop 1L Gifting Jar</a>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Raksha Bandhan Gifting",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#fdfbf7"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding Top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Raksha Bandhan Gifting"
    }
  ]
}
{% endschema %}
