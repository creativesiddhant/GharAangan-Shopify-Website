<!-- Customer Photo Lightbox -->
<div class="ga-pr-lightbox" id="ga-photo-lightbox" aria-hidden="true" role="dialog">
  <div class="ga-pr-lightbox-backdrop" id="ga-lightbox-close-bg"></div>
  <div class="ga-pr-lightbox-content">
    <button class="ga-pr-lightbox-close" id="ga-lightbox-close-btn" aria-label="Close photo preview">&times;</button>
    <img id="ga-lightbox-img" src="" alt="Customer unboxing photo">
  </div>
</div>

<script>
  (function() {
    function initGharAanganReviews() {
      // Lightbox Handlers
      var lightbox = document.getElementById('ga-photo-lightbox');
      var lightboxImg = document.getElementById('ga-lightbox-img');
      var lbCloseBtn = document.getElementById('ga-lightbox-close-btn');
      var lbCloseBg = document.getElementById('ga-lightbox-close-bg');

      window.gaOpenLightbox = function(src) {
        if (!lightbox || !lightboxImg) return;
        lightboxImg.src = src;
        lightbox.classList.add('is-open');
        lightbox.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
      };

      function closeLightbox() {
        if (!lightbox) return;
        lightbox.classList.remove('is-open');
        lightbox.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      }

      if (lbCloseBtn) lbCloseBtn.addEventListener('click', closeLightbox);
      if (lbCloseBg) lbCloseBg.addEventListener('click', closeLightbox);

      // Helpful Button Toggling
      var helpfulBtns = document.querySelectorAll('.ga-pr-helpful-btn');
      helpfulBtns.forEach(function(btn) {
        btn.addEventListener('click', function() {
          var voted = btn.getAttribute('data-voted') === 'true';
          var countSpan = btn.querySelector('.ga-count');
          var count = parseInt(countSpan.textContent, 10) || 0;
          if (!voted) {
            btn.setAttribute('data-voted', 'true');
            btn.classList.add('is-voted');
            countSpan.textContent = count + 1;
          } else {
            btn.setAttribute('data-voted', 'false');
            btn.classList.remove('is-voted');
            countSpan.textContent = Math.max(0, count - 1);
          }
        });
      });

      // Filter Pills
      var pills = document.querySelectorAll('.ga-pr-pill');
      var cards = document.querySelectorAll('.ga-pr-card');
      pills.forEach(function(pill) {
        pill.addEventListener('click', function() {
          pills.forEach(function(p) { p.classList.remove('is-active'); });
          pill.classList.add('is-active');
          var filter = pill.getAttribute('data-filter');

          cards.forEach(function(card) {
            var stars = card.getAttribute('data-stars');
            var hasPhoto = card.getAttribute('data-has-photo') === 'true';
            var tags = (card.getAttribute('data-tags') || '').toLowerCase();

            if (filter === 'all') {
              card.style.display = 'flex';
            } else if (filter === 'photo') {
              card.style.display = hasPhoto ? 'flex' : 'none';
            } else if (filter === '5star') {
              card.style.display = (stars === '5') ? 'flex' : 'none';
            } else {
              card.style.display = tags.indexOf(filter) !== -1 ? 'flex' : 'none';
            }
          });
        });
      });

      // Search Filter
      var searchInput = document.getElementById('ga-review-search');
      if (searchInput) {
        searchInput.addEventListener('input', function() {
          var q = searchInput.value.toLowerCase().trim();
          cards.forEach(function(card) {
            var text = card.textContent.toLowerCase();
            card.style.display = text.indexOf(q) !== -1 ? 'flex' : 'none';
          });
        });
      }

      // Modal Triggers
      var openModalBtn = document.getElementById('ga-open-review-modal');
      var modalOverlay = document.getElementById('ga-review-modal-overlay');
      var closeModalBtn = document.getElementById('ga-close-review-modal');
      var successCloseBtn = document.getElementById('ga-btn-success-close');
      var formView = document.getElementById('ga-modal-form-view');
      var successView = document.getElementById('ga-modal-success-view');

      function openModal() {
        if (!modalOverlay) return;
        modalOverlay.classList.add('is-active');
        modalOverlay.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
      }

      function closeModal() {
        if (!modalOverlay) return;
        modalOverlay.classList.remove('is-active');
        modalOverlay.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      }

      if (openModalBtn) openModalBtn.addEventListener('click', openModal);
      if (closeModalBtn) closeModalBtn.addEventListener('click', closeModal);
      if (successCloseBtn) successCloseBtn.addEventListener('click', closeModal);
      if (modalOverlay) {
        modalOverlay.addEventListener('click', function(e) {
          if (e.target === modalOverlay) closeModal();
        });
      }

      // Star Picker
      var starPicker = document.getElementById('ga-modal-star-picker');
      var starHint = document.getElementById('ga-star-rating-hint');
      var stars = starPicker ? starPicker.querySelectorAll('.ga-pr-pick-star') : [];
      var hints = {
        1: '1.0 - Poor',
        2: '2.0 - Fair',
        3: '3.0 - Good',
        4: '4.0 - Very Good',
        5: '5.0 - Excellent'
      };

      stars.forEach(function(star) {
        star.addEventListener('click', function() {
          var val = parseInt(star.getAttribute('data-val'), 10);
          starPicker.setAttribute('data-rating', val);
          starHint.textContent = hints[val];
          updateStars(val);
        });

        star.addEventListener('mouseenter', function() {
          var val = parseInt(star.getAttribute('data-val'), 10);
          updateStars(val);
        });
      });

      if (starPicker) {
        starPicker.addEventListener('mouseleave', function() {
          var current = parseInt(starPicker.getAttribute('data-rating'), 10) || 5;
          updateStars(current);
        });
      }

      function updateStars(val) {
        stars.forEach(function(s) {
          var sVal = parseInt(s.getAttribute('data-val'), 10);
          if (sVal <= val) {
            s.classList.add('is-selected');
          } else {
            s.classList.remove('is-selected');
          }
        });
      }

      // Dropzone & Photo Preview
      var dropzone = document.getElementById('ga-dropzone-box');
      var photoInput = document.getElementById('ga-photo-input');
      var previewStrip = document.getElementById('ga-preview-strip');

      if (dropzone && photoInput) {
        dropzone.addEventListener('click', function(e) {
          if (e.target.tagName !== 'INPUT') {
            photoInput.click();
          }
        });

        photoInput.addEventListener('change', function() {
          if (!previewStrip) return;
          previewStrip.innerHTML = '';
          Array.from(photoInput.files).forEach(function(file) {
            var reader = new FileReader();
            reader.onload = function(e) {
              var img = document.createElement('img');
              img.src = e.target.result;
              img.className = 'ga-pr-preview-thumb';
              previewStrip.appendChild(img);
            };
            reader.readAsDataURL(file);
          });
        });
      }

      // Form Submit
      var reviewForm = document.getElementById('ga-review-form');
      if (reviewForm) {
        reviewForm.addEventListener('submit', function(e) {
          e.preventDefault();
          var name = document.getElementById('ga-input-name').value.trim();
          var location = document.getElementById('ga-input-location').value.trim();
          var headline = document.getElementById('ga-input-headline').value.trim();
          var body = document.getElementById('ga-input-body').value.trim();
          var pack = document.getElementById('ga-select-pack').value;
          var rating = parseInt(starPicker.getAttribute('data-rating'), 10) || 5;

          // Prepend newly submitted review card to UI
          var reviewsList = document.getElementById('ga-reviews-list');
          if (reviewsList) {
            var newCard = document.createElement('div');
            newCard.className = 'ga-pr-card';
            newCard.setAttribute('data-stars', rating);
            newCard.setAttribute('data-has-photo', previewStrip && previewStrip.children.length > 0 ? 'true' : 'false');
            newCard.setAttribute('data-tags', 'all');

            var starsHtml = '';
            for (var i = 0; i < rating; i++) {
              starsHtml += '<svg viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>';
            }

            var photoHtml = '';
            if (previewStrip && previewStrip.children.length > 0) {
              var firstImgSrc = previewStrip.children[0].src;
              photoHtml = '<div class="ga-pr-card-img-wrap"><img class="ga-pr-card-img" src="' + firstImgSrc + '" alt="' + headline + '"></div>';
            }

            newCard.innerHTML = 
              '<div>' +
                '<div class="ga-pr-card-top">' +
                  '<div class="ga-pr-avatar">' + (name ? name.charAt(0).toUpperCase() : 'G') + '</div>' +
                  '<div class="ga-pr-meta">' +
                    '<div class="ga-pr-meta-row">' +
                      '<span class="ga-pr-reviewer-name">' + name + '</span>' +
                      '<span class="ga-pr-verified-badge">' +
                        '<svg viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>' +
                        'Verified' +
                      '</span>' +
                    '</div>' +
                    '<div class="ga-pr-meta-sub">' + location + ' • Just now</div>' +
                  '</div>' +
                '</div>' +
                '<div class="ga-pr-stars-row">' +
                  '<div class="ga-pr-stars">' + starsHtml + '</div>' +
                  '<span class="ga-pr-purchase-tag">' + pack + '</span>' +
                '</div>' +
                '<h3 class="ga-pr-card-headline">' + headline + '</h3>' +
                '<p class="ga-pr-card-text">' + body + '</p>' +
                photoHtml +
              '</div>' +
              '<div class="ga-pr-card-footer">' +
                '<span class="ga-pr-helpful-txt">Was this helpful?</span>' +
                '<button class="ga-pr-helpful-btn" data-voted="false">' +
                  '<svg viewBox="0 0 24 24"><path d="M1 21h4V9H1v12zm22-11c0-1.1-.9-2-2-2h-6.31l.95-4.57.03-.32c0-.41-.17-.79-.44-1.06L14.17 1 7.59 7.59C7.22 7.95 7 8.45 7 9v10c0 1.1.9 2 2 2h9c.83 0 1.54-.5 1.84-1.22l3.02-7.05c.09-.23.14-.47.14-.73v-2z"/></svg>' +
                  '<span>Helpful (<span class="ga-count">1</span>)</span>' +
                '</button>' +
              '</div>';

            reviewsList.insertBefore(newCard, reviewsList.firstChild);
          }

          // Show Success View
          var successName = document.getElementById('ga-success-name');
          if (successName) successName.textContent = name;
          if (formView) formView.style.display = 'none';
          if (successView) successView.style.display = 'block';
        });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initGharAanganReviews);
    } else {
      initGharAanganReviews();
    }
  })();
</script>
{%- endif -%}

