{%- unless template contains 'product' -%}
{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.65 | round }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.65 | round }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .ga-founder-section {
    position: relative;
    overflow: hidden;
  }

  .ga-founder-card {
    background: {{ section.settings.card_bg | default: '#faf8f5' }};
    border: 1.5px solid rgba(205, 162, 80, 0.28);
    border-radius: 24px;
    padding: clamp(24px, 4.5vw, 48px);
    box-shadow: 0 16px 40px rgba(26, 51, 44, 0.04);
    position: relative;
    overflow: hidden;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.4s ease;
  }

  .ga-founder-card:hover {
    box-shadow: 0 22px 50px rgba(26, 51, 44, 0.08);
    border-color: rgba(205, 162, 80, 0.5);
  }

  /* Decorative background accent circle */
  .ga-founder-card::before {
    content: '';
    position: absolute;
    top: -80px;
    right: -80px;
    width: 240px;
    height: 240px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(205, 162, 80, 0.08) 0%, transparent 70%);
    pointer-events: none;
    z-index: 0;
  }

  .ga-founder-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
    align-items: center;
    position: relative;
    z-index: 1;
  }

  /* Tablet & Desktop Grid */
  @media screen and (min-width: 641px) {
    .ga-founder-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
      gap: 32px;
    }
  }

  @media screen and (min-width: 1025px) {
    .ga-founder-grid {
      gap: 52px;
    }
  }

  /* Image Column Styling */
  .ga-founder-image-col {
    position: relative;
    width: 100%;
  }

  .ga-founder-image-frame {
    position: relative;
    width: 100%;
    border-radius: 18px;
    overflow: hidden;
    border: 2px solid #ecdcb9;
    box-shadow: 0 12px 30px rgba(26, 51, 44, 0.07);
    background-color: #0c1412;
    aspect-ratio: 4 / 5;
  }

  .ga-founder-img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
    display: block;
    transition: transform 1.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .ga-founder-card:hover .ga-founder-img {
    transform: scale(1.03);
  }

  /* Floating Authentic Badge: Positioned at top-left over the background trees so founder is never covered */
  .ga-founder-floating-badge {
    position: absolute;
    top: 16px;
    left: 16px;
    bottom: auto;
    right: auto;
    background: rgba(26, 51, 44, 0.9);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(205, 162, 80, 0.45);
    border-radius: 30px;
    padding: 7px 14px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #ffffff;
    font-family: var(--ga-font-family-sans, 'Outfit', sans-serif);
    font-size: 12px;
    font-weight: 550;
    letter-spacing: 0.03em;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.25);
    z-index: 2;
  }

  .ga-founder-floating-badge svg {
    width: 14px;
    height: 14px;
    fill: #cda250;
    flex-shrink: 0;
  }

  /* Content Column Styling */
  .ga-founder-content-col {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .ga-founder-header-area {
    margin-bottom: 20px;
  }

  .ga-founder-subtitle-wrap {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 10px;
  }

  .ga-founder-subtitle {
    font-family: var(--ga-font-family-sans, 'Outfit', sans-serif);
    font-size: 12.5px;
    font-weight: 750;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: #a8792c;
    margin: 0;
    display: inline-block;
  }

  .ga-founder-subtitle-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background-color: #cda250;
  }

  .ga-founder-title {
    font-family: var(--ga-font-family-serif, 'Playfair Display', Georgia, serif);
    font-size: clamp(2.4rem, 4vw, 3.8rem);
    color: var(--ga-forest-green, #1a332c);
    line-height: 1.2;
    margin: 0 0 16px 0;
    font-weight: 600;
  }

  .ga-founder-divider {
    width: 56px;
    height: 3px;
    background: linear-gradient(90deg, #cda250 0%, rgba(205, 162, 80, 0.2) 100%);
    border-radius: 2px;
    margin-bottom: 20px;
  }

  .ga-founder-quote-box {
    position: relative;
    padding-left: 20px;
    border-left: 3px solid rgba(205, 162, 80, 0.45);
    margin-bottom: 24px;
  }

  .ga-founder-text {
    font-family: var(--ga-font-family-sans, 'Outfit', sans-serif);
    font-size: clamp(1.45rem, 1.6vw, 1.65rem);
    line-height: 1.8;
    color: #2c3832;
    margin: 0;
    font-weight: 400;
  }

  /* Trust Value Chips */
  .ga-founder-values {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 26px;
  }

  .ga-founder-value-pill {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    background: #ffffff;
    border: 1px solid rgba(205, 162, 80, 0.28);
    border-radius: 30px;
    padding: 7px 14px;
    font-family: var(--ga-font-family-sans, 'Outfit', sans-serif);
    font-size: 12.5px;
    font-weight: 550;
    color: #1a332c;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.02);
  }

  .ga-founder-value-pill svg {
    width: 14px;
    height: 14px;
    color: #cda250;
    flex-shrink: 0;
  }

  /* Action row */
  .ga-founder-action-row {
    display: flex;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
  }

  .ga-founder-cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background: #1a332c;
    color: #ffffff !important;
    text-decoration: none !important;
    padding: 13px 28px;
    border-radius: 8px;
    font-family: var(--ga-font-family-sans, 'Outfit', sans-serif);
    font-size: 13px;
    font-weight: 650;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border: 1.5px solid #1a332c;
    box-shadow: 0 4px 14px rgba(26, 51, 44, 0.16);
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .ga-founder-cta-btn:hover {
    background: #24493e;
    border-color: #cda250;
    transform: translateY(-2px);
    box-shadow: 0 8px 22px rgba(26, 51, 44, 0.25);
  }

  .ga-founder-cta-btn svg {
    transition: transform 0.25s ease;
  }

  .ga-founder-cta-btn:hover svg {
    transform: translateX(4px);
  }

  .ga-founder-origin-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--ga-font-family-sans, 'Outfit', sans-serif);
    font-size: 12px;
    color: #68756f;
    font-weight: 500;
  }

  .ga-founder-origin-badge svg {
    width: 15px;
    height: 15px;
    color: #a8792c;
  }

  /* Tablet Portrait Specific Tweaks (iPad, Android Tablets 641px - 899px) */
  @media screen and (min-width: 641px) and (max-width: 899px) {
    .ga-founder-card {
      border-radius: 20px;
      padding: 26px 22px;
    }

    .ga-founder-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
      gap: 24px;
    }

    .ga-founder-image-frame {
      aspect-ratio: 4 / 5;
      border-radius: 14px;
    }

    .ga-founder-floating-badge {
      top: 12px;
      left: 12px;
      font-size: 11px;
      padding: 5px 10px;
    }

    .ga-founder-header-area {
      margin-bottom: 14px;
    }

    .ga-founder-title {
      font-size: clamp(2.1rem, 3.2vw, 2.6rem);
      margin-bottom: 10px;
    }

    .ga-founder-divider {
      margin-bottom: 14px;
    }

    .ga-founder-quote-box {
      padding-left: 14px;
      margin-bottom: 16px;
    }

    .ga-founder-text {
      font-size: 1.4rem;
      line-height: 1.68;
    }

    .ga-founder-values {
      gap: 6px;
      margin-bottom: 18px;
    }

    .ga-founder-value-pill {
      font-size: 11px;
      padding: 5px 10px;
    }

    .ga-founder-action-row {
      gap: 12px;
    }

    .ga-founder-cta-btn {
      padding: 11px 20px;
      font-size: 11.5px;
    }

    .ga-founder-origin-badge {
      font-size: 11px;
    }
  }

  /* Tablet Landscape Specific Tweaks (900px - 1080px) */
  @media screen and (min-width: 900px) and (max-width: 1080px) {
    .ga-founder-card {
      padding: 34px 28px;
    }

    .ga-founder-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
      gap: 34px;
    }

    .ga-founder-title {
      font-size: clamp(2.5rem, 3.4vw, 3.2rem);
    }

    .ga-founder-text {
      font-size: 1.5rem;
    }
  }

  /* Mobile Tweaks (max-width: 640px): Full-bleed wide image and complete 3:4 portrait visibility */
  @media screen and (max-width: 640px) {
    .ga-founder-card {
      border-radius: 20px;
      padding: 0 0 26px 0; /* Full bleed image across the top of card on mobile */
      overflow: hidden;
    }

    .ga-founder-grid {
      gap: 0;
    }

    .ga-founder-image-col {
      width: 100%;
      margin: 0;
    }

    .ga-founder-image-frame {
      width: 100%;
      aspect-ratio: 3 / 4; /* Generous 3:4 portrait ratio shows the person, traditional jewelry, hands & ghee completely */
      border-radius: 19px 19px 0 0;
      border-top: none;
      border-left: none;
      border-right: none;
      border-bottom: 2px solid #ecdcb9;
      box-shadow: none;
    }

    .ga-founder-img {
      object-position: center 30%; /* Balanced focus on face, traditional jewelry and ghee bowl */
    }

    .ga-founder-floating-badge {
      top: 14px;
      left: 14px;
      bottom: auto;
      right: auto;
      font-size: 11.5px;
      padding: 6px 12px;
    }

    .ga-founder-content-col {
      padding: 24px 20px 0 20px; /* Clean, spacious padding for text below the full-width image */
    }

    .ga-founder-header-area {
      margin-bottom: 16px;
    }

    .ga-founder-title {
      font-size: clamp(2.2rem, 5.5vw, 2.8rem);
      margin-bottom: 12px;
    }

    .ga-founder-divider {
      margin-bottom: 16px;
    }

    .ga-founder-quote-box {
      padding-left: 14px;
      margin-bottom: 20px;
    }

    .ga-founder-text {
      font-size: 1.5rem;
      line-height: 1.75;
    }

    .ga-founder-values {
      gap: 8px;
      margin-bottom: 22px;
    }

    .ga-founder-value-pill {
      font-size: 12px;
      padding: 6px 12px;
    }

    .ga-founder-action-row {
      flex-direction: column;
      align-items: stretch;
      gap: 12px;
    }

    .ga-founder-cta-btn {
      width: 100%;
      text-align: center;
      padding: 13px 20px;
    }

    .ga-founder-origin-badge {
      justify-content: center;
    }
  }
{%- endstyle -%}

<div id="ga-founder-section-{{ section.id }}" class="ga-founder-section section-{{ section.id }}-padding" style="background-color: {{ section.settings.background_color }};">
  <div class="page-width">
    <div class="ga-founder-card ga-reveal">
      <div class="ga-founder-grid">
        <!-- Image Column -->
        <div class="ga-founder-image-col">
          <div class="ga-founder-image-frame">
            {%- assign founder_img = section.settings.image -%}
            <img
              class="ga-founder-img"
              src="{% if founder_img != blank %}{{ founder_img | image_url: width: 900 }}{% else %}{{ 'ghar-aangan-lifestyle.jpg' | asset_url }}{% endif %}"
              alt="{{ section.settings.title | escape }} - Ghar Aangan Founder Story"
              loading="lazy"
              width="900"
              height="1200"
            >
            <!-- Authentic Corner Badge: Placed top-left in the sky/foliage area so founder is never obscured -->
            <div class="ga-founder-floating-badge">
              <svg viewBox="0 0 24 24"><path d="M14 6l-3.75 5 2.85 3.8-1.6 1.2L7.25 10 2 17h20L14 6z"/></svg>
              <span>Timeless Uttarakhand Kitchens</span>
            </div>
          </div>
        </div>

        <!-- Content Column -->
        <div class="ga-founder-content-col">
          <div class="ga-founder-header-area">
            {%- if section.settings.subtitle != blank -%}
              <div class="ga-founder-subtitle-wrap">
                <span class="ga-founder-subtitle-dot"></span>
                <span class="ga-founder-subtitle">{{ section.settings.subtitle | escape }}</span>
              </div>
            {%- endif -%}
            {%- if section.settings.title != blank -%}
              <h2 class="ga-founder-title">{{ section.settings.title | escape }}</h2>
            {%- endif -%}
            <div class="ga-founder-divider"></div>
          </div>

          <div class="ga-founder-quote-box">
            <p class="ga-founder-text">{{ section.settings.description | escape }}</p>
          </div>

          <!-- Heritage Values -->
          <div class="ga-founder-values">
            <div class="ga-founder-value-pill">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.4 7.4h7.6l-6.2 4.5 2.4 7.4-6.2-4.5-6.2 4.5 2.4-7.4-6.2-4.5h7.6z"/></svg>
              <span>Preserving Parampara</span>
            </div>
            <div class="ga-founder-value-pill">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
              <span>Family & Trust First</span>
            </div>
            <div class="ga-founder-value-pill">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M14 6l-3.75 5 2.85 3.8-1.6 1.2L7.25 10 2 17h20L14 6z"/></svg>
              <span>Direct Uttarakhand Farmers</span>
            </div>
          </div>

          <!-- Call to Action Row -->
          <div class="ga-founder-action-row">
            <a href="{{ section.settings.cta_link | default: '#ga-specialties-shop' }}" class="ga-founder-cta-btn">
              <span>{{ section.settings.cta_label | default: 'Explore Our Products' }}</span>
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
            <span class="ga-founder-origin-badge">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
              Handcrafted in Uttarakhand
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
{%- endunless -%}

{% schema %}
{
  "name": "GA Founder's Journey",
  "tag": "section",
  "class": "section hdt-section-ghar-aangan-founder",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Section Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card Background",
      "default": "#faf8f5"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Founder Image",
      "info": "Upload founder photograph. Optimal 3:4 or 4:5 ratio."
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "THE FOUNDER'S JOURNEY"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Back to the Soil"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Story Narrative",
      "default": "At Ghar Aangan, we believe that food is more than nourishment—it is tradition, heritage, family, and trust. Inspired by the timeless kitchens of Uttarakhand, our mission is to reconnect modern families with authentic Himalayan foods prepared using traditional methods that have been preserved for generations."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA Button Label",
      "default": "Explore Our Products"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA Button Link"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "GA Founder's Journey"
    }
  ]
}
{% endschema %}
