<script>
  (function() {
    function enforceJudgeMeLuxuryStyles() {
      // 1. Hide review timestamps completely across all AJAX renders
      var timestamps = document.querySelectorAll('.jdgm-rev__timestamp, [class*="timestamp"]');
      for (var i = 0; i < timestamps.length; i++) {
        timestamps[i].style.setProperty('display', 'none', 'important');
      }

      // 2. Enforce warm gold stars everywhere
      var stars = document.querySelectorAll('.jdgm-star');
      for (var j = 0; j < stars.length; j++) {
        var s = stars[j];
        if (!s.classList.contains('jdgm--off')) {
          s.style.setProperty('color', '#cda250', 'important');
        } else {
          s.style.setProperty('color', 'rgba(205, 162, 80, 0.28)', 'important');
        }
      }

      // 3. Remove distracting sort arrows completely from DOM and enforce full clean text
      var sortArrows = document.querySelectorAll('.jdgm-sort-dropdown-arrow, [class*="sort-dropdown-arrow"]');
      for (var k = 0; k < sortArrows.length; k++) {
        sortArrows[k].remove();
      }

      var sortDropdowns = document.querySelectorAll('.jdgm-sort-dropdown');
      for (var m = 0; m < sortDropdowns.length; m++) {
        sortDropdowns[m].style.setProperty('min-width', '125px', 'important');
        sortDropdowns[m].style.setProperty('width', 'auto', 'important');
        sortDropdowns[m].style.setProperty('background', 'transparent', 'important');
        sortDropdowns[m].style.setProperty('background-image', 'none', 'important');
        sortDropdowns[m].style.setProperty('-webkit-appearance', 'none', 'important');
        sortDropdowns[m].style.setProperty('appearance', 'none', 'important');
        sortDropdowns[m].style.setProperty('border', 'none', 'important');
        sortDropdowns[m].style.setProperty('outline', 'none', 'important');
      }

      var sortWrappers = document.querySelectorAll('.jdgm-sort-dropdown-wrapper');
      for (var w = 0; w < sortWrappers.length; w++) {
        sortWrappers[w].style.setProperty('min-width', '125px', 'important');
        sortWrappers[w].style.setProperty('width', 'auto', 'important');
        sortWrappers[w].style.setProperty('border', 'none', 'important');
        sortWrappers[w].style.setProperty('background', 'transparent', 'important');
      }
    }

    // Run immediately and on DOM load
    enforceJudgeMeLuxuryStyles();
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', enforceJudgeMeLuxuryStyles);
    }

    // Observe Judge.me dynamic review rendering and pagination clicks
    if (window.MutationObserver) {
      var observer = new MutationObserver(function() {
        enforceJudgeMeLuxuryStyles();
      });
      var target = document.getElementById('ga-product-reviews') || document.body;
      observer.observe(target, { childList: true, subtree: true });
    }

    // Periodic safety check for the first 5 seconds
    var timerCount = 0;
    var safetyTimer = setInterval(function() {
      enforceJudgeMeLuxuryStyles();
      timerCount++;
      if (timerCount > 10) clearInterval(safetyTimer);
    }, 500);
  })();
</script>

