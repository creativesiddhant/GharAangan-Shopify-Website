{%- liquid
  assign is_ghee = false
  if product.handle contains 'ghee' or product.type == 'Ghee'
    assign is_ghee = true
  endif
-%}

<section id="ga-product-reviews" class="ga-pr-section" aria-label="Customer Reviews">
  <div class="ga-pr-container">
    
    <!-- Section Header (Luxury Uttarakhand Aesthetic) -->
    <div class="ga-pr-header">
      <div class="ga-pr-badge-wrap">
        <span class="ga-pr-badge">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
          TESTIMONIALS
        </span>
      </div>
      <h2 class="ga-pr-title">
        {%- if is_ghee -%}
          Loved by Pure Food Connoisseurs
        {%- else -%}
          Verified Customer Reviews
        {%- endif -%}
      </h2>
      <p class="ga-pr-subtitle">
        {%- if is_ghee -%}
          Honest taste, aroma, and wellness reviews from families across India who cook with Ghar Aangan Bilona Ghee daily.
        {%- else -%}
          Honest reviews from families across India who experience Ghar Aangan specialties daily.
        {%- endif -%}
      </p>
    </div>

    <!-- Official Judge.me Review Widget Container -->
    <div class="ga-judgeme-wrap">
      <!-- Start of Judge.me code -->
      {% assign has_legacy = false %}
      {% if product.metafields.judgeme.widget.size > 20 %}
        {% assign has_legacy = true %}
      {% endif %}
      <div style='clear:both'></div>
      <div id='judgeme_product_reviews' class='jdgm-widget jdgm-review-widget' data-product-title='{{ product.title | escape }}' data-id='{{ product.id }}' data-product-id='{{ product.id }}' data-widget='review' data-auto-install='false' data-shop-reviews-count='{{ shop.metafields.judgeme.shop_reviews_count | default: 0 | escape }}' data-entry-point='review_widget.js' data-entry-key='review-widget/main.js'>
        {% if has_legacy %}
          <div class='jdgm-legacy-widget-content' style='display: none;'>{{ product.metafields.judgeme.widget }}</div>
        {% endif %}
      </div>
      {% if product.metafields.judgeme.review_widget_data %}
        <script>jdgm.data ||= {}; jdgm.data.reviewWidget ||= {}; jdgm.data.reviewWidget[{{ product.id }}] = {{ product.metafields.judgeme.review_widget_data }}</script>
      {% endif %}
      <!-- End of Judge.me code -->
    </div>

  </div>
</section>

