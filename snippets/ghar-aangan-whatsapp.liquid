{%- comment -%}
  Ghar Aangan - Premium WhatsApp Floating Chat Button
  GA WhatsApp Icon & Styling
{%- endcomment -%}

{%- liquid
  assign wa_phone = '919027248335'
  assign wa_message = "Hello Ghar Aangan Team, I'm interested in your products. Could you please share the available options and prices?" | url_encode | replace: '+', '%20'
  assign wa_url = 'https://wa.me/' | append: wa_phone | append: '?text=' | append: wa_message
-%}

<style>
  .ga-whatsapp-btn {
    position: fixed !important;
    bottom: 26px !important;
    right: 24px !important;
    height: 48px !important;
    padding: 0 20px 0 14px !important;
    background: #25D366 !important;
    background: linear-gradient(135deg, #25D366 0%, #1ea952 100%) !important;
    color: #ffffff !important;
    border: 1.5px solid rgba(255, 255, 255, 0.35) !important;
    border-radius: 50px !important;
    box-shadow: 0 4px 18px rgba(37, 211, 102, 0.42), 0 2px 6px rgba(0, 0, 0, 0.08) !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 9px !important;
    cursor: pointer !important;
    z-index: 900 !important;
    text-decoration: none !important;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif !important;
    font-size: 14px !important;
    font-weight: 700 !important;
    letter-spacing: 0.2px !important;
    line-height: 1 !important;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1),
                box-shadow 0.25s cubic-bezier(0.16, 1, 0.3, 1),
                bottom 0.3s cubic-bezier(0.16, 1, 0.3, 1),
                opacity 0.25s ease,
                visibility 0.25s ease !important;
    box-sizing: border-box !important;
    -webkit-tap-highlight-color: transparent;
    user-select: none;
  }

  .ga-whatsapp-btn:hover {
    transform: translateY(-3px) scale(1.02) !important;
    box-shadow: 0 8px 26px rgba(37, 211, 102, 0.55), 0 3px 8px rgba(0, 0, 0, 0.12) !important;
    color: #ffffff !important;
  }

  .ga-whatsapp-btn:active {
    transform: translateY(0) scale(0.98) !important;
  }

  .ga-whatsapp-icon {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    flex-shrink: 0 !important;
    width: 26px !important;
    height: 26px !important;
  }

  .ga-whatsapp-icon svg {
    width: 26px !important;
    height: 26px !important;
    min-width: 26px !important;
    min-height: 26px !important;
    display: block !important;
    fill: #ffffff !important;
    stroke: none !important;
    visibility: visible !important;
    opacity: 1 !important;
    flex-shrink: 0 !important;
  }

  .ga-whatsapp-icon svg path {
    fill: #ffffff !important;
    stroke: none !important;
    visibility: visible !important;
    opacity: 1 !important;
  }

  .ga-whatsapp-text {
    color: #ffffff !important;
    white-space: nowrap !important;
    font-weight: 700 !important;
    line-height: 1 !important;
    font-size: 14px !important;
  }

  /* Desktop Product Pages: Safely position above Sticky Buy Now Bar if present */
  body.template-product .ga-whatsapp-btn,
  body[class*="product"] .ga-whatsapp-btn {
    bottom: 82px !important;
  }

  /* Auto-hide when review modal, photo lightbox, cart drawer, or navigation menu is open */
  body.jm-mfp-open .ga-whatsapp-btn,
  html.jm-mfp-open .ga-whatsapp-btn,
  body.mfp-open .ga-whatsapp-btn,
  body.jdgm-modal-open .ga-whatsapp-btn,
  body.hdt-drawer-open .ga-whatsapp-btn,
  html.hdt-drawer-open .ga-whatsapp-btn {
    display: none !important;
    opacity: 0 !important;
    visibility: hidden !important;
    pointer-events: none !important;
  }

  /* Mobile & Tablet Devices (<= 768px) */
  @media (max-width: 768px) {
    .ga-whatsapp-btn {
      bottom: 78px !important;
      right: 14px !important;
      height: 44px !important;
      padding: 0 16px 0 11px !important;
      font-size: 13.5px !important;
      gap: 8px !important;
    }
    .ga-whatsapp-icon {
      width: 23px !important;
      height: 23px !important;
    }
    .ga-whatsapp-icon svg {
      width: 23px !important;
      height: 23px !important;
      min-width: 23px !important;
      min-height: 23px !important;
    }
    .ga-whatsapp-text {
      font-size: 13.5px !important;
    }
  }
</style>

<a
  href="{{ wa_url }}"
  class="ga-whatsapp-btn"
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Chat with Ghar Aangan team on WhatsApp"
  title="Chat with us on WhatsApp"
>
  <span class="ga-whatsapp-icon" aria-hidden="true">
    <svg viewBox="0 0 32 32" width="26" height="26" fill="#ffffff" style="fill: #ffffff !important; stroke: none !important; width: 26px !important; height: 26px !important;" aria-hidden="true" focusable="false">
      <path d="M16.04 3.2c-7.1 0-12.87 5.77-12.87 12.87 0 2.27.6 4.49 1.73 6.44L3.1 29.3l6.96-1.77a12.83 12.83 0 0 0 5.98 1.49h.01c7.1 0 12.87-5.77 12.87-12.87 0-3.44-1.34-6.67-3.77-9.1a12.78 12.78 0 0 0-9.1-3.85Zm0 23.03h-.01a10.7 10.7 0 0 1-5.44-1.49l-.39-.23-4.13 1.05 1.1-4.03-.25-.41a10.66 10.66 0 0 1-1.64-5.7c0-5.9 4.8-10.7 10.71-10.7 2.86 0 5.55 1.11 7.57 3.14a10.63 10.63 0 0 1 3.13 7.57c0 5.9-4.8 10.8-10.65 10.8Zm5.87-8.02c-.32-.16-1.9-.94-2.2-1.05-.29-.1-.5-.16-.72.16-.21.32-.82 1.05-1.01 1.26-.19.22-.37.24-.69.08-.32-.16-1.36-.5-2.58-1.6-.96-.85-1.6-1.9-1.79-2.22-.19-.32-.02-.5.14-.66.14-.14.32-.37.48-.56.16-.19.21-.32.32-.53.1-.22.05-.4-.03-.56-.08-.16-.72-1.74-.99-2.38-.26-.62-.52-.54-.72-.55l-.61-.01c-.21 0-.56.08-.85.4-.29.32-1.11 1.09-1.11 2.65s1.14 3.08 1.3 3.29c.16.21 2.24 3.42 5.42 4.8.76.32 1.35.52 1.81.67.76.24 1.45.2 2 .12.61-.09 1.9-.78 2.16-1.53.27-.75.27-1.4.19-1.53-.08-.13-.29-.21-.61-.37Z" fill="#ffffff" style="fill: #ffffff !important; stroke: none !important; opacity: 1 !important; visibility: visible !important;"/>
    </svg>
  </span>
  <span class="ga-whatsapp-text">Chat with us</span>
</a>
