{%- comment -%}
  Ghar Aangan - Subtle Festive Raksha Bandhan Decoration & Announcement
  To remove after Raksha Bandhan: Set 'enable_rakhi_decor' below to false or remove {% render 'festive-rakhi-decor' %} from theme.liquid.
{%- endcomment -%}

{%- assign enable_rakhi_decor = true -%}

{%- if enable_rakhi_decor -%}
<style>
  /* 🪢 Top Festive Rakhi Announcement Bar */
  .ga-rakhi-topbar {
    background: linear-gradient(90deg, #8c2415 0%, #b33b28 35%, #9b2817 70%, #8c2415 100%);
    color: #ffffff;
    font-size: 12.5px;
    font-weight: 600;
    text-align: center;
    padding: 8px 16px;
    position: relative;
    z-index: 101;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    letter-spacing: 0.3px;
  }
  .ga-rakhi-topbar a {
    color: #ffd992 !important;
    text-decoration: underline !important;
    font-weight: 700;
    margin-left: 6px;
    transition: opacity 0.2s;
  }
  .ga-rakhi-topbar a:hover {
    opacity: 0.85;
  }
  .ga-rakhi-code-chip {
    background: rgba(255, 255, 255, 0.2);
    border: 1px dashed #ffd992;
    color: #ffffff;
    padding: 2px 7px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.5px;
  }
  @media (max-width: 768px) {
    .ga-rakhi-topbar {
      font-size: 11.5px;
      padding: 7px 10px;
      line-height: 1.35;
    }
  }

  /* Subtle Festive Accent Borders & Highlights */
  .ga-festive-shimmer {
    position: relative;
  }
  .ga-festive-shimmer::after {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    border-radius: inherit;
    pointer-events: none;
    box-shadow: inset 0 0 0 1px rgba(179, 59, 40, 0.15);
  }
</style>

<div class="ga-rakhi-topbar" id="gaRakhiTopBanner">
  <span>🪢 <strong>Raksha Bandhan Special:</strong> Gift pure Himalayan health • <strong>₹50 OFF</strong> 1L in cart • Extra <strong>5% OFF</strong> 2L with <span class="ga-rakhi-code-chip">RAKHIWITHGA</span></span>
  <a href="/products/a2-desi-pahadi-ghee-1l">Order Festive Pack →</a>
</div>
{%- endif -%}
