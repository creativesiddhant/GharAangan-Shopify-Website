<!-- snippets/ghar-aangan-product-reviews-content.liquid -->
{%- liquid
  assign is_ghee = false
  if product.handle contains 'ghee' or product.type == 'Ghee'
    assign is_ghee = true
  elsif request.design_mode
    assign is_ghee = true
  endif
-%}
{%- style -%}
  html {
    scroll-behavior: smooth;
  }

  #ga-product-reviews {
    scroll-margin-top: 85px;
  }

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | default: 60 | times: 0.75 | round }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 60 | times: 0.75 | round }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | default: 60 }}px;
      padding-bottom: {{ section.settings.padding_bottom | default: 60 }}px;
    }
  }

  .ga-pr-section {
    background-color: {{ section.settings.background_color | default: '#faf8f5' }};
    border-top: 1px solid rgba(26, 51, 44, 0.08);
    position: relative;
    overflow: hidden;
  }

  .ga-pr-container {
    max-width: 1320px;
    margin: 0 auto;
    padding: 0 1.6rem;
    box-sizing: border-box;
  }

  @media screen and (min-width: 750px) {
    .ga-pr-container {
      padding: 0 3.2rem;
    }
  }

  /* Header */
  .ga-pr-header {
    text-align: center;
    max-width: 78rem;
    margin: 0 auto clamp(2.5rem, 4vw, 4rem) auto;
    padding: 0 1rem;
  }

  .ga-pr-subtitle {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    font-family: var(--ga-font-family-sans, 'Outfit', sans-serif);
    font-size: 1.25rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--ga-gold-cream, #cda250);
    font-weight: 600;
    margin-bottom: 0.8rem;
  }

  .ga-pr-subtitle svg {
    width: 1.5rem;
    height: 1.5rem;
    fill: currentColor;
  }

  .ga-pr-title {
    font-family: var(--ga-font-family-serif, 'Playfair Display', serif);
    font-size: clamp(2.5rem, 3.6vw, 3.8rem);
    color: var(--ga-forest-green, #1a332c);
    letter-spacing: -0.01em;
    font-weight: 600;
    line-height: 1.25;
    margin: 0 0 1.2rem 0;
  }

  .ga-pr-description {
    font-family: var(--ga-font-family-sans, 'Outfit', sans-serif);
    font-size: 1.55rem;
    line-height: 1.65;
    color: #4a5550;
    font-weight: 300;
    margin: 0 auto;
    max-width: 62rem;
  }

  /* Summary Dashboard */
  .ga-pr-summary-card {
    background: #ffffff;
    border: 1.5px solid rgba(205, 162, 80, 0.28);
    border-radius: 18px;
    padding: 2.8rem 2.2rem;
    box-shadow: 0 12px 32px rgba(26, 51, 44, 0.06);
    margin-bottom: 3.5rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
  }

  @media screen and (min-width: 768px) and (max-width: 1024px) {
    .ga-pr-summary-card {
      grid-template-columns: 1fr 1.3fr;
      padding: 3rem 2.6rem;
      gap: 3rem;
    }
  }

  @media screen and (min-width: 1025px) {
    .ga-pr-summary-card {
      grid-template-columns: 1fr 1.4fr 1fr;
      padding: 3.5rem 3.2rem;
      gap: 3.5rem;
    }
  }

  /* Score Box */
  .ga-pr-score-box {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    border-bottom: 1px solid rgba(26, 51, 44, 0.08);
    padding-bottom: 2rem;
  }

  @media screen and (min-width: 768px) {
    .ga-pr-score-box {
      border-bottom: none;
      border-right: 1px solid rgba(26, 51, 44, 0.08);
      padding-bottom: 0;
      padding-right: 2.5rem;
    }
  }

  .ga-pr-score-num {
    font-family: var(--ga-font-family-serif, 'Playfair Display', serif);
    font-size: 5.4rem;
    font-weight: 700;
    color: var(--ga-forest-green, #1a332c);
    line-height: 1;
    margin-bottom: 0.6rem;
  }

  .ga-pr-score-num span {
    font-size: 2.2rem;
    font-weight: 400;
    color: #6a7a74;
  }

  .ga-pr-stars-gold {
    display: flex;
    gap: 4px;
    margin-bottom: 0.8rem;
  }

  .ga-pr-stars-gold svg {
    width: 22px;
    height: 22px;
    fill: var(--ga-gold-cream, #cda250);
  }

  .ga-pr-score-label {
    font-family: var(--ga-font-family-sans, 'Outfit', sans-serif);
    font-size: 1.4rem;
    color: #4a5550;
    font-weight: 500;
    margin-bottom: 1rem;
  }

  .ga-pr-recommend-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(34, 197, 94, 0.1);
    border: 1px solid rgba(34, 197, 94, 0.3);
    color: #15803d;
    font-family: var(--ga-font-family-sans, 'Outfit', sans-serif);
    font-size: 1.25rem;
    font-weight: 600;
    padding: 4px 12px;
    border-radius: 20px;
  }

  .ga-pr-recommend-pill svg {
    width: 14px;
    height: 14px;
    fill: currentColor;
  }

  /* Breakdown Bars */
  .ga-pr-bars-box {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .ga-pr-bar-row {
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: var(--ga-font-family-sans, 'Outfit', sans-serif);
    font-size: 1.3rem;
    color: #4a5550;
    cursor: pointer;
    padding: 2px 0;
    transition: color 0.2s ease;
  }

  .ga-pr-bar-row:hover {
    color: var(--ga-forest-green, #1a332c);
  }

  .ga-pr-bar-label {
    width: 50px;
    display: flex;
    align-items: center;
    gap: 4px;
    font-weight: 600;
  }

  .ga-pr-bar-label svg {
    width: 13px;
    height: 13px;
    fill: var(--ga-gold-cream, #cda250);
  }

  .ga-pr-bar-track {
    flex: 1;
    height: 9px;
    background: #f0ede6;
    border-radius: 6px;
    overflow: hidden;
    position: relative;
  }

  .ga-pr-bar-fill {
    height: 100%;
    background: linear-gradient(90deg, #cda250 0%, #d4af37 100%);
    border-radius: 6px;
    transition: width 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .ga-pr-bar-count {
    width: 45px;
    text-align: right;
    font-weight: 600;
    color: #6a7a74;
  }

  /* Action & Purity Highlights */
  .ga-pr-action-box {
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
    align-items: stretch;
  }

  @media screen and (min-width: 1025px) {
    .ga-pr-action-box {
      border-left: 1px solid rgba(26, 51, 44, 0.08);
      padding-left: 2.5rem;
    }
  }

  .ga-pr-trust-bullets {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }

  .ga-pr-trust-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--ga-font-family-sans, 'Outfit', sans-serif);
    font-size: 1.3rem;
    color: var(--ga-forest-green, #1a332c);
    font-weight: 500;
  }

  .ga-pr-trust-item svg {
    width: 16px;
    height: 16px;
    fill: var(--ga-gold-cream, #cda250);
    flex-shrink: 0;
  }

  .ga-pr-btn-write {
    background: var(--ga-forest-green, #1a332c);
    color: #ffffff;
    border: 1.5px solid var(--ga-forest-green, #1a332c);
    border-radius: 30px;
    padding: 1.3rem 2.4rem;
    font-family: var(--ga-font-family-sans, 'Outfit', sans-serif);
    font-size: 1.4rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 4px 16px rgba(26, 51, 44, 0.18);
  }

  .ga-pr-btn-write:hover {
    background: var(--ga-gold-cream, #cda250);
    border-color: var(--ga-gold-cream, #cda250);
    color: #1a332c;
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(205, 162, 80, 0.3);
  }

  .ga-pr-btn-write svg {
    width: 18px;
    height: 18px;
    fill: currentColor;
  }

  /* Filter Pills & Search */
  .ga-pr-filter-bar {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-bottom: 2.8rem;
    align-items: stretch;
  }

  @media screen and (min-width: 768px) {
    .ga-pr-filter-bar {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  .ga-pr-filter-pills {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    align-items: center;
  }

  .ga-pr-pill {
    background: #ffffff;
    border: 1px solid rgba(26, 51, 44, 0.15);
    border-radius: 20px;
    padding: 7px 16px;
    font-family: var(--ga-font-family-sans, 'Outfit', sans-serif);
    font-size: 1.25rem;
    font-weight: 500;
    color: #4a5550;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .ga-pr-pill:hover,
  .ga-pr-pill.is-active {
    background: var(--ga-forest-green, #1a332c);
    border-color: var(--ga-forest-green, #1a332c);
    color: #ffffff;
  }

  .ga-pr-search-box {
    position: relative;
    max-width: 280px;
    width: 100%;
  }

  .ga-pr-search-input {
    width: 100%;
    padding: 8px 12px 8px 36px;
    border-radius: 20px;
    border: 1px solid rgba(26, 51, 44, 0.15);
    font-family: var(--ga-font-family-sans, 'Outfit', sans-serif);
    font-size: 1.3rem;
    color: #1a332c;
    background: #ffffff;
    outline: none;
    box-sizing: border-box;
    transition: border-color 0.2s ease;
  }

  .ga-pr-search-input:focus {
    border-color: var(--ga-gold-cream, #cda250);
  }

  .ga-pr-search-box svg {
    position: absolute;
    left: 12px;
    top: 50%;
    transform: translateY(-50%);
    width: 15px;
    height: 15px;
    fill: #7a8a84;
  }

  /* Review Cards Grid */
  .ga-pr-reviews-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media screen and (min-width: 641px) and (max-width: 1024px) {
    .ga-pr-reviews-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 2.2rem;
    }
  }

  @media screen and (min-width: 1025px) {
    .ga-pr-reviews-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 2.6rem;
    }
  }

  .ga-pr-card {
    background: #ffffff;
    border: 1px solid rgba(26, 51, 44, 0.08);
    border-radius: 14px;
    padding: 2.4rem 2rem;
    box-shadow: 0 4px 16px rgba(26, 51, 44, 0.04);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
  }

  .ga-pr-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 28px rgba(26, 51, 44, 0.08);
    border-color: rgba(205, 162, 80, 0.35);
  }

  .ga-pr-card-top {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 1.2rem;
  }

  .ga-pr-avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: linear-gradient(135deg, #1a332c 0%, #2d5c4e 100%);
    color: var(--ga-gold-cream, #cda250);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--ga-font-family-serif, 'Playfair Display', serif);
    font-size: 1.7rem;
    font-weight: 700;
    flex-shrink: 0;
    border: 1.5px solid rgba(205, 162, 80, 0.4);
  }

  .ga-pr-meta {
    flex: 1;
    min-width: 0;
  }

  .ga-pr-meta-row {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
  }

  .ga-pr-reviewer-name {
    font-family: var(--ga-font-family-sans, 'Outfit', sans-serif);
    font-size: 1.45rem;
    font-weight: 600;
    color: var(--ga-forest-green, #1a332c);
  }

  .ga-pr-verified-badge {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    background: rgba(34, 197, 94, 0.12);
    color: #15803d;
    font-family: var(--ga-font-family-sans, 'Outfit', sans-serif);
    font-size: 1.1rem;
    font-weight: 600;
    padding: 2px 7px;
    border-radius: 12px;
  }

  .ga-pr-verified-badge svg {
    width: 11px;
    height: 11px;
    fill: currentColor;
  }

  .ga-pr-meta-sub {
    font-family: var(--ga-font-family-sans, 'Outfit', sans-serif);
    font-size: 1.2rem;
    color: #7a8a84;
    margin-top: 2px;
  }

  .ga-pr-stars-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
  }

  .ga-pr-stars {
    display: flex;
    gap: 3px;
  }

  .ga-pr-stars svg {
    width: 16px;
    height: 16px;
    fill: var(--ga-gold-cream, #cda250);
  }

  .ga-pr-purchase-tag {
    font-family: var(--ga-font-family-sans, 'Outfit', sans-serif);
    font-size: 1.15rem;
    color: #6a7a74;
    background: #f4ede1;
    padding: 3px 8px;
    border-radius: 6px;
    font-weight: 500;
  }

  .ga-pr-card-headline {
    font-family: var(--ga-font-family-serif, 'Playfair Display', serif);
    font-size: 1.7rem;
    font-weight: 600;
    color: var(--ga-forest-green, #1a332c);
    line-height: 1.35;
    margin: 0 0 1rem 0;
  }

  .ga-pr-card-text {
    font-family: var(--ga-font-family-sans, 'Outfit', sans-serif);
    font-size: 1.45rem;
    line-height: 1.68;
    color: #3b4944;
    font-weight: 300;
    margin: 0 0 1.6rem 0;
  }

  .ga-pr-card-img-wrap {
    margin-bottom: 1.6rem;
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid rgba(205, 162, 80, 0.25);
    background: #f8f6f0;
    cursor: pointer;
  }

  .ga-pr-card-img {
    width: 100%;
    height: 190px;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .ga-pr-card:hover .ga-pr-card-img {
    transform: scale(1.04);
  }

  .ga-pr-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 1.4rem;
    border-top: 1px solid rgba(26, 51, 44, 0.08);
  }

  .ga-pr-helpful-txt {
    font-family: var(--ga-font-family-sans, 'Outfit', sans-serif);
    font-size: 1.2rem;
    color: #7a8a84;
  }

  .ga-pr-helpful-btn {
    background: transparent;
    border: 1px solid rgba(26, 51, 44, 0.15);
    border-radius: 16px;
    padding: 4px 12px;
    font-family: var(--ga-font-family-sans, 'Outfit', sans-serif);
    font-size: 1.2rem;
    color: #4a5550;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    transition: all 0.2s ease;
  }

  .ga-pr-helpful-btn:hover {
    background: rgba(205, 162, 80, 0.15);
    border-color: var(--ga-gold-cream, #cda250);
    color: #1a332c;
  }

  .ga-pr-helpful-btn.is-voted {
    background: rgba(34, 197, 94, 0.12);
    border-color: #15803d;
    color: #15803d;
    font-weight: 600;
  }

  .ga-pr-helpful-btn svg {
    width: 13px;
    height: 13px;
    fill: currentColor;
  }

  /* Modal */
  .ga-pr-modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(13, 23, 20, 0.7);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    z-index: 99999;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    box-sizing: border-box;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .ga-pr-modal-overlay.is-active {
    display: flex;
    opacity: 1;
  }

  .ga-pr-modal {
    background: #ffffff;
    border-radius: 20px;
    max-width: 620px;
    width: 100%;
    max-height: 90vh;
    overflow-y: auto;
    border: 1.5px solid rgba(205, 162, 80, 0.35);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.35);
    padding: 3rem 2.5rem;
    position: relative;
    box-sizing: border-box;
    transform: translateY(20px);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .ga-pr-modal-overlay.is-active .ga-pr-modal {
    transform: translateY(0);
  }

  .ga-pr-modal-close {
    position: absolute;
    top: 1.8rem;
    right: 1.8rem;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 5px;
    color: #4a5550;
    transition: color 0.2s ease;
  }

  .ga-pr-modal-close:hover {
    color: #1a332c;
  }

  .ga-pr-modal-close svg {
    width: 22px;
    height: 22px;
    stroke: currentColor;
  }

  .ga-pr-modal-title {
    font-family: var(--ga-font-family-serif, 'Playfair Display', serif);
    font-size: 2.6rem;
    color: var(--ga-forest-green, #1a332c);
    margin: 0 0 0.6rem 0;
  }

  .ga-pr-modal-subtitle {
    font-family: var(--ga-font-family-sans, 'Outfit', sans-serif);
    font-size: 1.4rem;
    color: #6a7a74;
    margin: 0 0 2.2rem 0;
  }

  .ga-pr-form-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.4rem;
  }

  @media screen and (min-width: 600px) {
    .ga-pr-form-row {
      grid-template-columns: 1fr 1fr;
    }
  }

  .ga-pr-form-group {
    margin-bottom: 1.6rem;
  }

  .ga-pr-label {
    display: block;
    font-family: var(--ga-font-family-sans, 'Outfit', sans-serif);
    font-size: 1.3rem;
    font-weight: 600;
    color: #1a332c;
    margin-bottom: 0.6rem;
  }

  .ga-pr-input,
  .ga-pr-textarea,
  .ga-pr-select {
    width: 100%;
    padding: 1.1rem 1.4rem;
    border: 1px solid rgba(26, 51, 44, 0.2);
    border-radius: 10px;
    font-family: var(--ga-font-family-sans, 'Outfit', sans-serif);
    font-size: 1.35rem;
    color: #1a332c;
    background: #fafaf8;
    box-sizing: border-box;
    outline: none;
    transition: border-color 0.2s ease;
  }

  .ga-pr-input:focus,
  .ga-pr-textarea:focus,
  .ga-pr-select:focus {
    border-color: var(--ga-gold-cream, #cda250);
    background: #ffffff;
  }

  .ga-pr-star-picker {
    display: inline-flex;
    gap: 6px;
    cursor: pointer;
  }

  .ga-pr-pick-star {
    font-size: 2.8rem;
    color: #d1d5db;
    transition: color 0.2s ease, transform 0.2s ease;
  }

  .ga-pr-pick-star.is-selected,
  .ga-pr-pick-star:hover {
    color: var(--ga-gold-cream, #cda250);
    transform: scale(1.1);
  }

  .ga-pr-dropzone {
    border: 2px dashed rgba(205, 162, 80, 0.5);
    border-radius: 12px;
    padding: 2rem 1.5rem;
    text-align: center;
    background: #faf8f5;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .ga-pr-dropzone:hover {
    border-color: var(--ga-gold-cream, #cda250);
    background: #faf6ec;
  }

  .ga-pr-dropzone svg {
    width: 28px;
    height: 28px;
    fill: var(--ga-gold-cream, #cda250);
    margin-bottom: 6px;
  }

  .ga-pr-dropzone-txt {
    font-family: var(--ga-font-family-sans, 'Outfit', sans-serif);
    font-size: 1.35rem;
    color: #4a5550;
    font-weight: 500;
  }

  .ga-pr-dropzone-sub {
    font-size: 1.15rem;
    color: #7a8a84;
    margin-top: 3px;
  }

  .ga-pr-preview-strip {
    display: flex;
    gap: 8px;
    margin-top: 10px;
    flex-wrap: wrap;
  }

  .ga-pr-preview-thumb {
    width: 60px;
    height: 60px;
    object-fit: cover;
    border-radius: 8px;
    border: 1.5px solid var(--ga-gold-cream, #cda250);
  }

  .ga-pr-btn-submit {
    width: 100%;
    padding: 1.4rem;
    border-radius: 30px;
    background: var(--ga-forest-green, #1a332c);
    color: #ffffff;
    font-family: var(--ga-font-family-sans, 'Outfit', sans-serif);
    font-size: 1.55rem;
    font-weight: 600;
    border: none;
    cursor: pointer;
    margin-top: 1rem;
