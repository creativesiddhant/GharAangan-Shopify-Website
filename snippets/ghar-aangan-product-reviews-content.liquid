    border: 2px solid rgba(205, 162, 80, 0.4);
    object-fit: contain;
  }

  .ga-pr-lightbox-close {
    position: absolute;
    top: -16px;
    right: -16px;
    width: 36px;
    height: 36px;
    background: #cda250;
    color: #1a332c;
    border-radius: 50%;
    border: none;
    font-size: 24px;
    line-height: 1;
