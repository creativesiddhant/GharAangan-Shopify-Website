  /* Image Lightbox */
  .ga-pr-lightbox {
    position: fixed;
    inset: 0;
    z-index: 100000;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    box-sizing: border-box;
  }

  .ga-pr-lightbox.is-open {
    display: flex;
  }

  .ga-pr-lightbox-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(13, 23, 20, 0.88);
    backdrop-filter: blur(6px);
  }

  .ga-pr-lightbox-content {
    position: relative;
    max-width: 90vw;
    max-height: 85vh;
    z-index: 1;
    display: flex;
    justify-content: center;
  }

  .ga-pr-lightbox-content img {
