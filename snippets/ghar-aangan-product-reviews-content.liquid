  }

  .ga-pr-page-btn svg {
    width: 18px;
    height: 18px;
    fill: currentColor;
  }

  .ga-pr-page-btn:hover:not(:disabled) {
    border-color: #cda250;
    background: #faf6ee;
    color: #1a332c;
