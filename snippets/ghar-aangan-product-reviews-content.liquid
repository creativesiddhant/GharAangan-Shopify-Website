<!-- Write a Review Modal -->
<div class="ga-pr-modal-overlay" id="ga-review-modal-overlay" aria-hidden="true" role="dialog" aria-modal="true">
  <div class="ga-pr-modal">
    <button class="ga-pr-modal-close" id="ga-close-review-modal" aria-label="Close modal">
      <svg viewBox="0 0 24 24" fill="none" stroke-width="2.5" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
    </button>

    <div id="ga-modal-form-view">
      <h3 class="ga-pr-modal-title">
        {%- if is_ghee -%}
          Write an Honest Review
        {%- else -%}
          Review {{ product.title | escape }}
        {%- endif -%}
      </h3>
      <p class="ga-pr-modal-subtitle">
        {%- if is_ghee -%}
          Share your aroma, taste, and cooking experience with our Ghar Aangan family.
        {%- else -%}
          Share your culinary pairings, taste, and experience with fellow food lovers.
        {%- endif -%}
      </p>

      <form id="ga-review-form">
        <div class="ga-pr-form-group">
          <label class="ga-pr-label">Your Overall Rating *</label>
          <div class="ga-pr-star-picker" id="ga-modal-star-picker" data-rating="5">
            <span class="ga-pr-pick-star is-selected" data-val="1">★</span>
            <span class="ga-pr-pick-star is-selected" data-val="2">★</span>
            <span class="ga-pr-pick-star is-selected" data-val="3">★</span>
            <span class="ga-pr-pick-star is-selected" data-val="4">★</span>
            <span class="ga-pr-pick-star is-selected" data-val="5">★</span>
            <span id="ga-star-rating-hint" style="font-size: 1.3rem; font-weight: 600; color: #1a332c; margin-left: 8px;">5.0 - Excellent</span>
          </div>
        </div>

        <div class="ga-pr-form-row">
          <div class="ga-pr-form-group">
            <label class="ga-pr-label" for="ga-input-name">Your Full Name *</label>
            <input type="text" id="ga-input-name" class="ga-pr-input" placeholder="e.g. Ananya Sharma" required>
          </div>
          <div class="ga-pr-form-group">
            <label class="ga-pr-label" for="ga-input-location">City / State *</label>
            <input type="text" id="ga-input-location" class="ga-pr-input" placeholder="e.g. Dehradun, Uttarakhand" required>
          </div>
        </div>

        <div class="ga-pr-form-row">
          <div class="ga-pr-form-group">
            <label class="ga-pr-label" for="ga-input-email">Email Address * (Kept 100% Private)</label>
            <input type="email" id="ga-input-email" class="ga-pr-input" placeholder="you@gmail.com" required>
          </div>
          <div class="ga-pr-form-group">
            <label class="ga-pr-label" for="ga-select-pack">Pack / Variant Purchased</label>
            <select id="ga-select-pack" class="ga-pr-select">
              {%- if is_ghee -%}
                <option value="1 Litre Glass Jar">1 Litre Glass Jar</option>
                <option value="550ml Glass Jar">550ml Glass Jar</option>
                <option value="2 Litres (Glass Jars Combo)">2 Litres (Glass Jars Combo)</option>
                <option value="5 Litre Steel Dolchi">5 Litre Steel Dolchi</option>
              {%- elsif product.variants.size > 0 -%}
                {%- for variant in product.variants -%}
                  <option value="{{ variant.title | escape }}">{{ variant.title | escape }}</option>
                {%- endfor -%}
              {%- else -%}
                <option value="{{ product.title | escape }}">{{ product.title | escape }}</option>
              {%- endif -%}
            </select>
          </div>
        </div>

        <div class="ga-pr-form-group">
          <label class="ga-pr-label" for="ga-input-headline">Review Headline *</label>
          <input type="text" id="ga-input-headline" class="ga-pr-input" placeholder="{% if is_ghee %}e.g. The authentic granular texture we were searching for!{% else %}e.g. Pure mountain flavour and unbeatable freshness!{% endif %}" required>
        </div>

        <div class="ga-pr-form-group">
          <label class="ga-pr-label" for="ga-input-body">Detailed Review *</label>
          <textarea id="ga-input-body" class="ga-pr-textarea" rows="4" placeholder="{% if is_ghee %}Tell us about the aroma, taste on hot rotis, digestion, packaging, or how your family enjoyed it...{% else %}Tell us about the aroma, taste, recipe pairings, packaging, or how your family enjoyed it...{% endif %}" required></textarea>
        </div>

        <div class="ga-pr-form-group">
          <label class="ga-pr-label">Attach Photos (Optional)</label>
          <div class="ga-pr-dropzone" id="ga-dropzone-box">
            <input type="file" id="ga-photo-input" accept="image/*" multiple style="display: none;">
            <svg viewBox="0 0 24 24"><path d="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z"/></svg>
            <div class="ga-pr-dropzone-txt">Drag & drop your photos here, or <span style="color: #cda250; text-decoration: underline;">browse files</span></div>
            <div class="ga-pr-dropzone-sub">PNG, JPG, or WEBP up to 10MB</div>
            <div class="ga-pr-preview-strip" id="ga-preview-strip"></div>
          </div>
        </div>

        <button type="submit" class="ga-pr-btn-submit">Submit Verified Review</button>
      </form>
    </div>

    <!-- Success View -->
    <div class="ga-pr-success-box" id="ga-modal-success-view">
      <svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
      <h3 class="ga-pr-success-title">Thank You, <span id="ga-success-name">Customer</span>!</h3>
      <p class="ga-pr-success-desc">
        Your review has been submitted successfully. Our team will verify your purchase and it will appear on this page shortly.
      </p>
      <button class="ga-pr-btn-submit" id="ga-btn-success-close" style="max-width: 200px; margin: 1.5rem auto 0 auto; display: block;">Close</button>
    </div>
  </div>
</div>

<!-- Customer Photo Lightbox -->
<div class="ga-pr-lightbox" id="ga-photo-lightbox" aria-hidden="true" role="dialog">
  <div class="ga-pr-lightbox-backdrop" id="ga-lightbox-close-bg"></div>
  <div class="ga-pr-lightbox-content">
    <button class="ga-pr-lightbox-close" id="ga-lightbox-close-btn" aria-label="Close photo preview">&times;</button>
    <img id="ga-lightbox-img" src="" alt="Customer unboxing photo">
  </div>
</div>

<script>
  (function() {
    function initGharAanganReviews() {
      var isGhee = {{ is_ghee | json }};
      var productHandle = {{ product.handle | json }};
      // Master ghee key so any review submitted on ANY ghee pack size (550ml, 1L, 2L, 5L) stays visible on all ghee pages!
      var storageKey = isGhee ? 'ga_reviews_ghee_master' : ('ga_reviews_' + (productHandle || 'product'));

      var PAGE_SIZE = 10;
      var currentPage = 1;
      var visibleCards = [];

      var reviewsList = document.getElementById('ga-reviews-list');
      var paginationContainer = document.getElementById('ga-pr-pagination');
      var prevBtn = document.getElementById('ga-pr-page-prev');
      var nextBtn = document.getElementById('ga-pr-page-next');
      var pageNumbersContainer = document.getElementById('ga-pr-page-numbers');

      // Lightbox Handlers
      var lightbox = document.getElementById('ga-photo-lightbox');
      var lightboxImg = document.getElementById('ga-lightbox-img');
      var lbCloseBtn = document.getElementById('ga-lightbox-close-btn');
      var lbCloseBg = document.getElementById('ga-lightbox-close-bg');

      window.gaOpenLightbox = function(src) {
        if (!lightbox || !lightboxImg) return;
        lightboxImg.src = src;
        lightbox.classList.add('is-open');
        lightbox.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
      };

      function closeLightbox() {
        if (!lightbox) return;
        lightbox.classList.remove('is-open');
        lightbox.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      }

      if (lbCloseBtn) lbCloseBtn.addEventListener('click', closeLightbox);
      if (lbCloseBg) lbCloseBg.addEventListener('click', closeLightbox);

      // Helpful Button Toggling
      function attachHelpfulListener(btn) {
        if (!btn) return;
        btn.addEventListener('click', function() {
          var voted = btn.getAttribute('data-voted') === 'true';
          var countSpan = btn.querySelector('.ga-count');
          var count = parseInt(countSpan.textContent, 10) || 0;
          if (!voted) {
            btn.setAttribute('data-voted', 'true');
            btn.classList.add('is-voted');
            countSpan.textContent = count + 1;
          } else {
            btn.setAttribute('data-voted', 'false');
            btn.classList.remove('is-voted');
            countSpan.textContent = Math.max(0, count - 1);
          }
        });
      }

      var helpfulBtns = document.querySelectorAll('.ga-pr-helpful-btn');
      helpfulBtns.forEach(attachHelpfulListener);

      // Scroll smoothly to reviews list top
      function scrollToReviewsTop() {
        var target = document.getElementById('ga-product-reviews');
        if (target) {
          var rect = target.getBoundingClientRect();
          var offset = window.pageYOffset + rect.top - 70;
          window.scrollTo({ top: offset, behavior: 'smooth' });
        }
      }

      // Pagination Controller
      function applyPagination() {
        if (!reviewsList) return;
        var totalCards = visibleCards.length;
        var totalPages = Math.ceil(totalCards / PAGE_SIZE) || 1;

        if (currentPage > totalPages) currentPage = totalPages;
        if (currentPage < 1) currentPage = 1;

        var startIndex = (currentPage - 1) * PAGE_SIZE;
        var endIndex = startIndex + PAGE_SIZE;

        var allCards = reviewsList.querySelectorAll('.ga-pr-card');
        allCards.forEach(function(card) {
          card.style.display = 'none';
        });

        for (var i = startIndex; i < endIndex && i < totalCards; i++) {
          visibleCards[i].style.display = 'flex';
        }

        renderPaginationControls(totalPages);
      }

      function renderPaginationControls(totalPages) {
        if (!paginationContainer) return;

        if (totalPages <= 1) {
          paginationContainer.style.display = 'none';
          return;
        }
        paginationContainer.style.display = 'flex';

        if (prevBtn) prevBtn.disabled = (currentPage === 1);
        if (nextBtn) nextBtn.disabled = (currentPage === totalPages);

        if (pageNumbersContainer) {
          pageNumbersContainer.innerHTML = '';
          for (var p = 1; p <= totalPages; p++) {
            var btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'ga-pr-page-btn' + (p === currentPage ? ' is-active' : '');
            btn.textContent = p;
            btn.setAttribute('data-page', p);
            btn.setAttribute('aria-label', 'Go to page ' + p);
            (function(pageNum) {
              btn.addEventListener('click', function() {
                currentPage = pageNum;
                applyPagination();
                scrollToReviewsTop();
              });
            })(p);
            pageNumbersContainer.appendChild(btn);
          }
        }
      }

      if (prevBtn) {
        prevBtn.addEventListener('click', function() {
          if (currentPage > 1) {
            currentPage--;
            applyPagination();
            scrollToReviewsTop();
          }
        });
      }

      if (nextBtn) {
        nextBtn.addEventListener('click', function() {
          var totalPages = Math.ceil(visibleCards.length / PAGE_SIZE) || 1;
          if (currentPage < totalPages) {
            currentPage++;
            applyPagination();
            scrollToReviewsTop();
          }
        });
      }

      // Filter & Search Logic
      function updateFilterAndPagination() {
        if (!reviewsList) return;
        var activePill = document.querySelector('.ga-pr-pill.is-active');
        var filter = activePill ? activePill.getAttribute('data-filter') : 'all';
        var searchInput = document.getElementById('ga-review-search');
        var q = searchInput ? searchInput.value.toLowerCase().trim() : '';

        var allCards = reviewsList.querySelectorAll('.ga-pr-card');
        visibleCards = [];

        allCards.forEach(function(card) {
          var stars = card.getAttribute('data-stars');
          var hasPhoto = card.getAttribute('data-has-photo') === 'true';
          var tags = (card.getAttribute('data-tags') || '').toLowerCase();
          var text = card.textContent.toLowerCase();

          var matchesFilter = false;
          if (filter === 'all') {
            matchesFilter = true;
          } else if (filter === 'photo') {
            matchesFilter = hasPhoto;
          } else if (filter === '5star') {
            matchesFilter = (stars === '5');
          } else {
            matchesFilter = (tags.indexOf(filter) !== -1);
          }

          var matchesSearch = (!q || text.indexOf(q) !== -1);

          if (matchesFilter && matchesSearch) {
            visibleCards.push(card);
          }
        });

        currentPage = 1;
        applyPagination();
      }

      // Filter Pills Listener
      var pills = document.querySelectorAll('.ga-pr-pill');
      pills.forEach(function(pill) {
        pill.addEventListener('click', function() {
          pills.forEach(function(p) { p.classList.remove('is-active'); });
          pill.classList.add('is-active');
          updateFilterAndPagination();
        });
      });

      // Search Listener
      var searchInput = document.getElementById('ga-review-search');
      if (searchInput) {
        searchInput.addEventListener('input', function() {
          updateFilterAndPagination();
        });
      }

      // Modal Triggers
      var openModalBtn = document.getElementById('ga-open-review-modal');
      var openModalNonGheeBtn = document.getElementById('ga-open-review-modal-nonghee');
      var modalOverlay = document.getElementById('ga-review-modal-overlay');
      var closeModalBtn = document.getElementById('ga-close-review-modal');
      var successCloseBtn = document.getElementById('ga-btn-success-close');
      var formView = document.getElementById('ga-modal-form-view');
      var successView = document.getElementById('ga-modal-success-view');

      window.gaOpenReviewModal = function() {
        if (!modalOverlay) return;
        if (formView) formView.style.display = 'block';
        if (successView) successView.style.display = 'none';
        modalOverlay.classList.add('is-active');
        modalOverlay.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
      };

      function closeModal() {
        if (!modalOverlay) return;
        modalOverlay.classList.remove('is-active');
        modalOverlay.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      }

      if (openModalBtn) openModalBtn.addEventListener('click', window.gaOpenReviewModal);
      if (openModalNonGheeBtn) openModalNonGheeBtn.addEventListener('click', window.gaOpenReviewModal);
      if (closeModalBtn) closeModalBtn.addEventListener('click', closeModal);
      if (successCloseBtn) successCloseBtn.addEventListener('click', closeModal);
      if (modalOverlay) {
        modalOverlay.addEventListener('click', function(e) {
          if (e.target === modalOverlay) closeModal();
        });
      }

      // Star Picker
      var starPicker = document.getElementById('ga-modal-star-picker');
      var starHint = document.getElementById('ga-star-rating-hint');
      var stars = starPicker ? starPicker.querySelectorAll('.ga-pr-pick-star') : [];
      var hints = {
        1: '1.0 - Poor',
        2: '2.0 - Fair',
        3: '3.0 - Good',
        4: '4.0 - Very Good',
        5: '5.0 - Excellent'
      };

      stars.forEach(function(star) {
        star.addEventListener('click', function() {
          var val = parseInt(star.getAttribute('data-val'), 10);
          starPicker.setAttribute('data-rating', val);
          if (starHint) starHint.textContent = hints[val];
          updateStars(val);
        });

        star.addEventListener('mouseenter', function() {
          var val = parseInt(star.getAttribute('data-val'), 10);
          updateStars(val);
        });
      });

      if (starPicker) {
        starPicker.addEventListener('mouseleave', function() {
          var current = parseInt(starPicker.getAttribute('data-rating'), 10) || 5;
          updateStars(current);
        });
      }

      function updateStars(val) {
        stars.forEach(function(s) {
          var sVal = parseInt(s.getAttribute('data-val'), 10);
          if (sVal <= val) {
            s.classList.add('is-selected');
          } else {
            s.classList.remove('is-selected');
          }
        });
      }

      // Dropzone & Photo Preview with Auto-Compression
      var dropzone = document.getElementById('ga-dropzone-box');
      var photoInput = document.getElementById('ga-photo-input');
      var previewStrip = document.getElementById('ga-preview-strip');
      var compressedPhotoDataUrl = null;

      function compressImage(file, maxDim, callback) {
        var reader = new FileReader();
        reader.onload = function(e) {
          var img = new Image();
          img.onload = function() {
            var w = img.width;
            var h = img.height;
            if (w > h) {
              if (w > maxDim) { h = Math.round(h * maxDim / w); w = maxDim; }
            } else {
              if (h > maxDim) { w = Math.round(h * maxDim / h); h = maxDim; }
            }
            var canvas = document.createElement('canvas');
            canvas.width = w;
            canvas.height = h;
            var ctx = canvas.getContext('2d');
            ctx.drawImage(img, 0, 0, w, h);
            callback(canvas.toDataURL('image/jpeg', 0.8));
          };
          img.onerror = function() { callback(null); };
          img.src = e.target.result;
        };
        reader.onerror = function() { callback(null); };
        reader.readAsDataURL(file);
      }

      if (dropzone && photoInput) {
        dropzone.addEventListener('click', function(e) {
          if (e.target.tagName !== 'INPUT') {
            photoInput.click();
          }
        });

        photoInput.addEventListener('change', function() {
          if (!previewStrip) return;
          previewStrip.innerHTML = '';
          compressedPhotoDataUrl = null;
          var files = Array.from(photoInput.files);
          if (files.length > 0) {
            compressImage(files[0], 600, function(dataUrl) {
              if (dataUrl) {
                compressedPhotoDataUrl = dataUrl;
                var img = document.createElement('img');
                img.src = dataUrl;
                img.className = 'ga-pr-preview-thumb';
                previewStrip.appendChild(img);
              }
            });
          }
        });
      }

      // Render Review Card
      function renderReviewCard(rev, container, prepend) {
        var card = document.createElement('div');
        card.className = 'ga-pr-card ga-pr-card--user-submitted';
        card.setAttribute('data-stars', rev.rating || 5);
        card.setAttribute('data-has-photo', rev.photo ? 'true' : 'false');
        card.setAttribute('data-tags', 'all' + (rev.photo ? ', photo' : ''));

        var starsHtml = '';
        for (var i = 0; i < (rev.rating || 5); i++) {
          starsHtml += '<svg viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>';
        }

        var photoHtml = '';
        if (rev.photo) {
          photoHtml = '<div class="ga-pr-card-img-wrap" onclick="gaOpenLightbox(this.querySelector(\'img\').src)"><img class="ga-pr-card-img" src="' + rev.photo + '" alt="' + (rev.headline || '') + '"></div>';
        }

        var initial = (rev.name && rev.name.charAt(0).toUpperCase()) || 'G';

        card.innerHTML = 
          '<div>' +
            '<div class="ga-pr-card-top">' +
              '<div class="ga-pr-avatar" style="background:#1a332c;color:#cda250;">' + initial + '</div>' +
              '<div class="ga-pr-meta">' +
                '<div class="ga-pr-meta-row">' +
                  '<span class="ga-pr-reviewer-name">' + rev.name + '</span>' +
                  '<span class="ga-pr-verified-badge">' +
                    '<svg viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>' +
                    'Verified Buyer' +
                  '</span>' +
                '</div>' +
                '<div class="ga-pr-meta-sub">' + (rev.location || 'Verified Buyer • India') + ' • ' + (rev.date || 'Recent') + '</div>' +
              '</div>' +
            '</div>' +
            '<div class="ga-pr-stars-row">' +
              '<div class="ga-pr-stars">' + starsHtml + '</div>' +
              (rev.pack ? '<span class="ga-pr-purchase-tag">' + rev.pack + '</span>' : '') +
            '</div>' +
            '<h3 class="ga-pr-card-headline">' + rev.headline + '</h3>' +
            '<p class="ga-pr-card-text">' + rev.body + '</p>' +
            photoHtml +
          '</div>' +
          '<div class="ga-pr-card-footer">' +
            '<span class="ga-pr-helpful-txt">Was this helpful?</span>' +
            '<button class="ga-pr-helpful-btn" data-voted="false">' +
              '<svg viewBox="0 0 24 24"><path d="M1 21h4V9H1v12zm22-11c0-1.1-.9-2-2-2h-6.31l.95-4.57.03-.32c0-.41-.17-.79-.44-1.06L14.17 1 7.59 7.59C7.22 7.95 7 8.45 7 9v10c0 1.1.9 2 2 2h9c.83 0 1.54-.5 1.84-1.22l3.02-7.05c.09-.23.14-.47.14-.73v-2z"/></svg>' +
              '<span>Helpful (<span class="ga-count">1</span>)</span>' +
            '</button>' +
          '</div>';

        attachHelpfulListener(card.querySelector('.ga-pr-helpful-btn'));

        if (prepend && container.firstChild) {
          container.insertBefore(card, container.firstChild);
        } else {
          container.appendChild(card);
        }
      }

      // Storage helper with fallback across localStorage & sessionStorage
      function readStorage() {
        var list = [];
        var keysToCheck = [storageKey];
        if (isGhee) {
          keysToCheck.push('ga_reviews_ghee');
          keysToCheck.push('ga_reviews_ghee_all');
          keysToCheck.push('ga_reviews_a2-desi-pahadi-ghee-550ml');
          keysToCheck.push('ga_reviews_a2-desi-pahadi-ghee-1l');
          keysToCheck.push('ga_reviews_a2-desi-pahadi-ghee-2l');
          keysToCheck.push('ga_reviews_a2-desi-pahadi-ghee-5l');
        } else {
          keysToCheck.push('ga_reviews_' + (productHandle || 'product'));
        }

        keysToCheck.forEach(function(k) {
          try {
            var raw = localStorage.getItem(k) || sessionStorage.getItem(k);
            if (raw) {
              var parsed = JSON.parse(raw);
              if (Array.isArray(parsed)) {
                parsed.forEach(function(item) {
                  var exists = list.some(function(existing) {
                    return existing.name === item.name && existing.headline === item.headline;
                  });
                  if (!exists) list.push(item);
                });
              }
            }
          } catch(e) {}
        });

        return list;
      }

      function writeStorage(list) {
        var jsonStr = JSON.stringify(list);
        try {
          localStorage.setItem(storageKey, jsonStr);
        } catch(e) {
          try {
            var noPhotos = list.map(function(item) {
              return Object.assign({}, item, { photo: null });
            });
            localStorage.setItem(storageKey, JSON.stringify(noPhotos));
          } catch(err2) {
            console.warn('LocalStorage unavailable, falling back to sessionStorage');
          }
        }
        try {
          sessionStorage.setItem(storageKey, jsonStr);
        } catch(e) {}
      }

      // Update All Review Counters across the page
      function updateAllCounters() {
        var baseCount = isGhee ? 48 : 0;
        var totalCount = baseCount + savedReviews.length;

        // 1. Header Rating Badge Count (blocks/_product-title.liquid)
        var heroCount = document.getElementById('ga-header-review-count') || document.querySelector('.ga-hero-count');
        if (heroCount) {
          if (isGhee) {
            heroCount.textContent = '(' + totalCount + ' Verified Reviews)';
          } else {
            if (totalCount > 0) {
              heroCount.textContent = '(' + totalCount + ' ' + (totalCount === 1 ? 'Review' : 'Reviews') + ')';
              heroCount.classList.remove('ga-hero-count--first');
            } else {
              heroCount.textContent = 'Be the first to review';
              heroCount.classList.add('ga-hero-count--first');
            }
          }
        }

        // 2. Summary Rating Score Label
        var scoreLabel = document.getElementById('ga-summary-rating-count') || document.querySelector('.ga-pr-score-label');
        if (scoreLabel && isGhee) {
          scoreLabel.textContent = 'Based on ' + totalCount + ' Verified Ratings';
        }

        // 3. Filter Pill "All Reviews"
        var allFilterPill = document.getElementById('ga-filter-all-btn') || document.querySelector('.ga-pr-pill[data-filter="all"]');
        if (allFilterPill && isGhee) {
          allFilterPill.textContent = 'All Reviews (' + totalCount + ')';
        }
      }

      // Load Saved Reviews on Page Load
      var savedReviews = readStorage();

      if (reviewsList && savedReviews.length > 0) {
        // ALWAYS PREPEND saved reviews so they appear at the top of Page 1!
        savedReviews.slice().reverse().forEach(function(rev) {
          renderReviewCard(rev, reviewsList, true);
        });

        if (!isGhee) {
          var introTitle = document.querySelector('.ga-pr-empty-title');
          var introDesc = document.querySelector('.ga-pr-empty-desc');
          if (introTitle) {
            introTitle.textContent = 'Customer Reviews for {{ product.title | escape }}';
          }
          if (introDesc) {
            introDesc.textContent = 'Showing verified customer reviews from buyers across India.';
          }
        }
      }

      // Sync counters with current review total
      updateAllCounters();

      // Initialize filter & pagination on start
      updateFilterAndPagination();

      // Form Submit
      var reviewForm = document.getElementById('ga-review-form');
      if (reviewForm) {
        reviewForm.addEventListener('submit', function(e) {
          e.preventDefault();
          var name = document.getElementById('ga-input-name').value.trim();
          var location = document.getElementById('ga-input-location').value.trim();
          var headline = document.getElementById('ga-input-headline').value.trim();
          var body = document.getElementById('ga-input-body').value.trim();
          var packSelect = document.getElementById('ga-select-pack');
          var pack = packSelect ? packSelect.value : '';
          var rating = parseInt(starPicker.getAttribute('data-rating'), 10) || 5;

          var photoSrc = compressedPhotoDataUrl;

          var reviewObj = {
            name: name,
            location: location,
            headline: headline,
            body: body,
            pack: pack,
            rating: rating,
            photo: photoSrc,
            date: 'Just now'
          };

          if (reviewsList) {
            // Render at the very top of page 1
            renderReviewCard(reviewObj, reviewsList, true);
            updateFilterAndPagination();
            scrollToReviewsTop();
          }

          // Persist to storage
          savedReviews.unshift(reviewObj);
          writeStorage(savedReviews);

          // Update counters everywhere immediately (e.g. 48 -> 49)
          updateAllCounters();

          var successName = document.getElementById('ga-success-name');
          if (successName) successName.textContent = name;
          if (formView) formView.style.display = 'none';
          if (successView) successView.style.display = 'block';

          reviewForm.reset();
          compressedPhotoDataUrl = null;
          if (previewStrip) previewStrip.innerHTML = '';
        });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initGharAanganReviews);
    } else {
      initGharAanganReviews();
    }
  })();
</script>