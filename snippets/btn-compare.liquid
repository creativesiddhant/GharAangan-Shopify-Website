{%- comment -%}
  Renders a btn compare

  Accepts:
  - product_id: {Number} The ID of the product. (required)
  - class: {String} a list class. (optional)
  - disable_sr_only: {Boolean} remove class sr_only (optional)
  - placement: {String} position tooltip (optional)

  Usage:
  {%- render 'btn-compare', product_id: product.id, class: 'xxx' -%}
{%- endcomment -%}
 {% liquid
  if section.id contains 'quick-add' or section.id contains 'quick-view' or section.id contains 'search' or section.id contains 'cart-drawer' or section.id contains 'header'
    assign inner_tooltip = true
  endif 
  %}

{%- if settings.compare_mode == "1" -%}
<hdt-compare class="{{ class }}" role="button" data-id="{{ product_id }}" data-handle="{{ product_handle }}" action="add" placement="{{ placement | default: 'none' }}"{% if inner_tooltip %} inner{%endif %}>
  <svg width="16" height="16" viewBox="0 0 32 32" aria-hidden="true" focusable="false" class="hdt-svg-cp"><path d="M13.224 10.428l-10.198-10.178-2.776 2.776 10.178 10.178 2.796-2.776zM20.922 0.25l4.016 4.016-24.688 24.708 2.776 2.776 24.708-24.688 4.016 4.016v-10.828h-10.828zM21.572 18.776l-2.776 2.776 6.162 6.162-4.036 4.036h10.828v-10.828l-4.016 4.016-6.162-6.162z" fill="currentColor"></path></svg>
  <span {% unless disable_sr_only %}class="sr-only"{% endunless %}>{{ 'general.compare.add_to_compare' | t }}</span>
</hdt-compare>
{%- elsif settings.compare_mode == "2" and shop.customer_accounts_enabled -%}
  {%- if customer -%}
    <hdt-compare class="{{ class }}" role="button" data-id="{{ product_id }}" data-handle="{{ product_handle }}" action="add" placement="{{ placement | default: 'none' }}"{% if inner_tooltip %} inner{%endif %}>
      <svg width="16" height="16" viewBox="0 0 32 32" aria-hidden="true" focusable="false" class="hdt-svg-cp"><path d="M13.224 10.428l-10.198-10.178-2.776 2.776 10.178 10.178 2.796-2.776zM20.922 0.25l4.016 4.016-24.688 24.708 2.776 2.776 24.708-24.688 4.016 4.016v-10.828h-10.828zM21.572 18.776l-2.776 2.776 6.162 6.162-4.036 4.036h10.828v-10.828l-4.016 4.016-6.162-6.162z" fill="currentColor"></path></svg>
      <span {% unless disable_sr_only %}class="sr-only"{% endunless %}>{{ 'general.compare.add_to_compare' | t }}</span>
    </hdt-compare>
  {%- else -%}
    <hdt-tooltip class="{{ class }} hdt-card-product__btn-compare-er" placement="{{ placement | default: 'none' }}"{% if inner_tooltip %} inner{%endif %}>
      {% comment %} {%- if settings.customer_popup != 'new' -%}
        <a type="button" href="{{ routes.account_login_url }}" {% unless customer or request.page_type contains 'customers' or settings.customer_popup != "default" %} aria-controls="login-form-popup" {% endunless %} aria-expanded="false" placement="{{ placement | default: 'none' }}">
          <svg width="16" height="16" viewBox="0 0 32 32" aria-hidden="true" focusable="false"><path d="M13.224 10.428l-10.198-10.178-2.776 2.776 10.178 10.178 2.796-2.776zM20.922 0.25l4.016 4.016-24.688 24.708 2.776 2.776 24.708-24.688 4.016 4.016v-10.828h-10.828zM21.572 18.776l-2.776 2.776 6.162 6.162-4.036 4.036h10.828v-10.828l-4.016 4.016-6.162-6.162z" fill="currentColor"></path></svg>
          <span {% unless disable_sr_only %}class="sr-only"{% endunless %}>{{ 'general.compare.login_to_use_compare' | t }}</span>
        </a>
      {%- else -%} {% endcomment %}
        <div>
          <shopify-account class="hdt-svg-cp" {% if settings.customer_account_menu != blank %} menu="{{ settings.customer_account_menu }}" {% endif %}>
            <div slot="signed-out-avatar">
              <svg height="16" viewBox="0 0 32 32" aria-hidden="true" focusable="false"><path d="M13.224 10.428l-10.198-10.178-2.776 2.776 10.178 10.178 2.796-2.776zM20.922 0.25l4.016 4.016-24.688 24.708 2.776 2.776 24.708-24.688 4.016 4.016v-10.828h-10.828zM21.572 18.776l-2.776 2.776 6.162 6.162-4.036 4.036h10.828v-10.828l-4.016 4.016-6.162-6.162z" fill="currentColor"></path></svg>
            </div>
          </shopify-account>
          <span {% unless disable_sr_only %}class="sr-only"{% endunless %}>{{ 'general.compare.login_to_use_compare' | t }}</span>
        </div>
      {% comment %} {%- endif -%} {% endcomment %}
    </hdt-tooltip>
  {%- endif -%}
{%- endif -%}