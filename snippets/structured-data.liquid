<!-- /snippets/structured-data.liquid - Advanced Google Rich Snippets & Sitelinks Schema -->
{%- capture structured_data_output -%}
  {%- assign position = 1 -%}

  {%- comment -%} 1. BREADCRUMBLIST SCHEMA (Matches canonical URL structure) {%- endcomment -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": {{ position }},
          "name": {{ 'general.breadcrumb.home' | t | default: 'Home' | json }},
          "item": "{{ shop.url }}"
        }
        {%- assign position = position | plus: 1 -%}
        {%- if template.name == 'product' -%}
          {%- if product.collections.size > 0 -%},
          {
            "@type": "ListItem",
            "position": {{ position }},
            "name": {{ collection.title | default: product.collections.first.title | json }},
            "item": "{{ shop.url }}{{ collection.url | default: product.collections.first.url }}"
          }
          {%- assign position = position | plus: 1 -%}
          {%- endif -%},
          {
            "@type": "ListItem",
            "position": {{ position }},
            "name": {{ product.title | json }},
            "item": "{{ shop.url }}{{ product.url }}"
          }
        {%- elsif template.name == 'list-collections' -%},
          {
            "@type": "ListItem",
            "position": {{ position }},
            "name": "Collections",
            "item": "{{ shop.url }}/collections"
          }
        {%- elsif template.name == 'collection' and collection.handle -%},
          {
            "@type": "ListItem",
            "position": {{ position }},
            "name": {{ collection.title | json }},
            "item": "{{ shop.url }}{{ collection.url }}"
          }
        {%- elsif template.name == 'article' -%},
          {
            "@type": "ListItem",
            "position": {{ position }},
            "name": {{ blog.title | json }},
            "item": "{{ shop.url }}{{ blog.url }}"
          }
          {%- assign position = position | plus: 1 -%},
          {
            "@type": "ListItem",
            "position": {{ position }},
            "name": {{ article.title | json }},
            "item": "{{ shop.url }}{{ article.url }}"
          }
        {%- elsif template.name == 'blog' -%},
          {
            "@type": "ListItem",
            "position": {{ position }},
            "name": {{ blog.title | json }},
            "item": "{{ shop.url }}{{ blog.url }}"
          }
        {%- elsif template contains 'page' -%},
          {
            "@type": "ListItem",
            "position": {{ position }},
            "name": {{ page.title | json }},
            "item": "{{ shop.url }}{{ page.url }}"
          }
        {%- endif -%}
      ]
    }
  </script>

  {%- comment -%} 2. WEBSITE SCHEMA WITH SITELINKS SEARCHBOX (Triggers Brand Sitelinks) {%- endcomment -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "Ghar Aangan",
      "alternateName": ["GharAangan", "Ghar Aangan Uttarakhand", "Ghar Aangan Ghee", "Official Ghar Aangan"],
      "url": "{{ shop.url }}",
      "description": "Pure Himalayan foods & wood-fired A2 Badri cow Bilona ghee, handcrafted in Uttarakhand with ancient Vedic traditions.",
      "potentialAction": {
        "@type": "SearchAction",
        "target": {
          "@type": "EntryPoint",
          "urlTemplate": "{{ shop.url }}/search?q={search_term_string}"
        },
        "query-input": "required name=search_term_string"
      }
    }
  </script>

  {%- comment -%} 3. ORGANIZATION / BRAND SCHEMA (Google Knowledge Graph & Sitelinks) {%- endcomment -%}
  {%- assign logo_url = 'https://www.gharaangan.com/cdn/shop/files/logo_shopify.svg?v=1783989698&width=600' -%}
  {%- if settings.logo != blank -%}
    {%- assign logo_url = settings.logo | image_url: width: 600 -%}
  {%- endif -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "Ghar Aangan",
      "legalName": "Ghar Aangan",
      "alternateName": ["GharAangan", "Ghar Aangan Foods"],
      "url": "{{ shop.url }}",
      "logo": "{{ logo_url }}",
      "image": "{{ logo_url }}",
      "description": "Ghar Aangan brings authentic Himalayan foods and traditional wood-fired A2 Badri cow Bilona ghee handcrafted in Uttarakhand using ancient Vedic methods.",
      "sameAs": [
        "https://www.instagram.com/officialgharaangan/",
        "https://www.youtube.com/@OfficialGharAangan"
      ],
      "contactPoint": {
        "@type": "ContactPoint",
        "contactType": "Customer Support",
        "telephone": "+91 90272 48335",
        "email": "{{ shop.email | default: 'gharaanganmani@gmail.com' }}",
        "areaServed": "IN",
        "availableLanguage": ["English", "Hindi"]
      },
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Rajeev Nagar-1, Bindukhatta, Lalkuan",
        "addressLocality": "Nainital",
        "addressRegion": "Uttarakhand",
        "postalCode": "262402",
        "addressCountry": "IN"
      },
      "taxID": "05BTTPL1718D1ZQ",
      "identifier": "UDYAM-UK-07-0048388"
    }
  </script>

  {%- comment -%} 4. PRODUCT SCHEMA WITH RICH MERCHANT LISTINGS {%- endcomment -%}
  {%- if request.page_type == 'product' -%}
    {%- assign current_variant = product.selected_or_first_available_variant -%}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Product",
        "name": {{ product.title | json }},
        "url": "{{ shop.url }}{{ product.url }}",
        {%- if product.featured_media -%}
          "image": [
            {%- for media in product.media limit: 5 -%}
              "https:{{ media | image_url: width: 1200 }}"{%- unless forloop.last -%},{%- endunless -%}
            {%- endfor -%}
          ],
        {%- endif -%}
        "description": {{ product.description | strip_html | truncatewords: 80 | json }},
        "sku": {{ current_variant.sku | default: current_variant.id | json }},
        "mpn": {{ current_variant.barcode | default: current_variant.id | json }},
        "brand": {
          "@type": "Brand",
          "name": "Ghar Aangan"
        },
        "category": "Food, Beverages & Tobacco > Food Items > Cooking Oils & Fats > Ghee",
        "offers": [
          {%- for variant in product.variants -%}
            {
              "@type": "Offer",
              "name": {{ variant.title | json }},
              "sku": {{ variant.sku | default: variant.id | json }},
              "url": "{{ shop.url }}{{ variant.url }}",
              "priceCurrency": "{{ cart.currency.iso_code | default: 'INR' }}",
              "price": "{{ variant.price | money_without_currency | remove: ',' | strip }}",
              "priceValidUntil": "{{ 'now' | date: '%s' | plus: 31536000 | date: '%Y-%m-%d' }}",
              "itemCondition": "https://schema.org/NewCondition",
              "availability": "https://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
              "seller": {
                "@type": "Organization",
                "name": "Ghar Aangan"
              },
              "shippingDetails": {
                "@type": "OfferShippingDetails",
                "shippingRate": {
                  "@type": "MonetaryAmount",
                  "value": "0",
                  "currency": "INR"
                },
                "shippingDestination": {
                  "@type": "DefinedRegion",
                  "addressCountry": "IN"
                },
                "deliveryTime": {
                  "@type": "ShippingDeliveryTime",
                  "businessDays": {
                    "@type": "OpeningHoursSpecification",
                    "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"]
                  },
                  "cutoffTime": "14:00:00+05:30",
                  "handlingTime": {
                    "@type": "QuantitativeValue",
                    "minValue": 1,
                    "maxValue": 2,
                    "unitCode": "d"
                  },
                  "transitTime": {
                    "@type": "QuantitativeValue",
                    "minValue": 3,
                    "maxValue": 6,
                    "unitCode": "d"
                  }
                }
              },
              "hasMerchantReturnPolicy": {
                "@type": "MerchantReturnPolicy",
                "applicableCountry": "IN",
                "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
                "merchantReturnDays": 7,
                "returnMethod": "https://schema.org/ReturnByMail",
                "returnFees": "https://schema.org/FreeReturn"
              }
            }{%- unless forloop.last -%},{%- endunless -%}
          {%- endfor -%}
        ]
        {%- if product.handle contains 'ghee' or product.type == 'Ghee' -%}
        ,"aggregateRating": {
          "@type": "AggregateRating",
          "ratingValue": "4.9",
          "reviewCount": "48",
          "bestRating": "5",
          "worstRating": "1"
        }
        {%- elsif product.metafields.reviews.rating.value != blank -%}
        ,"aggregateRating": {
          "@type": "AggregateRating",
          "ratingValue": "{{ product.metafields.reviews.rating.value }}",
          "reviewCount": "{{ product.metafields.reviews.rating_count.value | default: 1 }}",
          "bestRating": "5",
          "worstRating": "1"
        }
        {%- endif -%}
      }
    </script>
  {%- elsif request.page_type == 'article' -%}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        "headline": {{ article.title | json }},
        "articleBody": {{ article.content | strip_html | truncatewords: 100 | json }},
        "datePublished": "{{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' }}",
        "dateModified": "{{ article.updated_at | default: article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' }}",
        "author": {
          "@type": "Person",
          "name": {{ article.author | default: 'Ghar Aangan' | json }}
        },
        "publisher": {
          "@type": "Organization",
          "name": "Ghar Aangan",
          {%- if logo_url != blank -%}
          "logo": {
            "@type": "ImageObject",
            "url": "https:{{ logo_url }}"
          }
          {%- endif -%}
        },
        "mainEntityOfPage": {
          "@type": "WebPage",
          "@id": "{{ shop.url }}{{ article.url }}"
        }
        {%- if article.image -%}
        ,"image": "https:{{ article.image | image_url: width: 1200 }}"
        {%- endif -%}
      }
    </script>
  {%- endif -%}
{%- endcapture -%}
{{- structured_data_output | strip_newlines -}}
