  <!-- Main Content Container -->
  <div class="ga-shipping-content-block" style="max-width: 820px; margin: 0 auto 5rem auto; padding: 0 1.5rem;">
    
    <!-- ================= PART 1: DOMESTIC INDIA SHIPPING ================= -->
    <div id="domestic-shipping" style="margin-bottom: 5rem; padding-bottom: 3.5rem; border-bottom: 1.5px dashed var(--ga-border-color, #e5e0d8);">
      <div style="display: flex; align-items: center; gap: 1rem; margin-bottom: 1.5rem;">
        <span style="font-size: 2.2rem;">🇮🇳</span>
        <h2 class="ga-title" style="font-size: 2.4rem; font-family: var(--ga-font-family-serif, 'Playfair Display', serif); color: var(--ga-forest-green, #1a332c); margin: 0;">
          Part 1: Domestic India Shipping &amp; Delivery
        </h2>
      </div>

      <!-- Section 1 -->
      <div style="margin-bottom: 3rem;">
        <h3 class="ga-title" style="font-size: 2rem; margin-bottom: 1rem; font-family: var(--ga-font-family-serif); color: var(--ga-forest-green);">1. Domestic Logistics Partners</h3>
        <p class="ga-body" style="font-size: 1.5rem; line-height: 1.7; color: var(--ga-dark-text); font-weight: 300;">
          Within India, we primarily use leading national carriers including <strong>Delhivery, Blue Dart, DTDC, Ecom Express &amp; XpressBees</strong>. <strong>Ekart</strong> and <strong>Amazon Shipping Surface</strong> may be used for select locations based on serviceability. The carrier selected for each shipment depends on destination pin code, package characteristics, and live operational conditions.
        </p>
      </div>

      <!-- Section 2 -->
      <div style="margin-bottom: 3rem;">
        <h3 class="ga-title" style="font-size: 2rem; margin-bottom: 1rem; font-family: var(--ga-font-family-serif); color: var(--ga-forest-green);">2. Domestic Dispatch &amp; Pickup</h3>
        <p class="ga-body" style="font-size: 1.5rem; line-height: 1.7; color: var(--ga-dark-text); font-weight: 300;">
          Orders are typically prepared and dispatched within <strong>24 hours</strong> of placement from our facility in Uttarakhand. Because Ghar Aangan operates from Nainital district in Uttarakhand, mountain weather or transport connections can occasionally require additional pickup time.
        </p>
      </div>

      <!-- Section 3 -->
      <div style="margin-bottom: 3rem;">
        <h3 class="ga-title" style="font-size: 2rem; margin-bottom: 1rem; font-family: var(--ga-font-family-serif); color: var(--ga-forest-green);">3. Domestic Delivery Timelines &amp; Charges</h3>
        <ul style="list-style-type: none; padding-left: 0; margin-top: 1rem; font-size: 1.5rem; line-height: 1.8; color: var(--ga-dark-text);">
          <li style="margin-bottom: 0.8rem; padding-left: 2rem; position: relative;">
            <span style="position: absolute; left: 0; color: var(--ga-forest-green);">⚡</span>
            <strong>Prepaid Orders (Cards, UPI, Netbanking):</strong> Delivered in <strong>5 to 6 business days</strong> across India with <strong>100% FREE Express Shipping</strong>.
          </li>
          <li style="margin-bottom: 0.8rem; padding-left: 2rem; position: relative;">
            <span style="position: absolute; left: 0; color: var(--ga-forest-green);">📦</span>
            <strong>Cash on Delivery (COD):</strong> Delivered in <strong>7 to 10 business days</strong> across serviceable pin codes (standard ₹100 handling fee applies). COD is available on 550ml and 1L packs; bulk 2L and 5L packs are strictly Prepaid Only to protect heavy shipments from transit rejection.
          </li>
        </ul>
      </div>

      <!-- Section 4 -->
      <div style="margin-bottom: 1rem;">
        <h3 class="ga-title" style="font-size: 2rem; margin-bottom: 1rem; font-family: var(--ga-font-family-serif); color: var(--ga-forest-green);">4. Domestic Packaging Safeguards</h3>
