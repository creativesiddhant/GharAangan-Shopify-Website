    <h1 class="ga-title" style="font-size: clamp(2.8rem, 4.5vw, 4.2rem); font-family: var(--ga-font-family-serif, 'Playfair Display', serif); margin-top: 1rem; margin-bottom: 1.4rem; color: var(--ga-forest-green, #1a332c); line-height: 1.2;">
