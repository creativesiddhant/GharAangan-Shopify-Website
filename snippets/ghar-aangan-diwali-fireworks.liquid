{% comment %}
  Ghar Aangan - Luxury Festive Diwali Fireworks Engine
  Inspired by Namo Narayana's ambient skyrocket celebrations.
  - Dual-layer zero-blur particle renderer: 60-120 FPS butter-smooth touch scrolling
  - Physics-driven: delta-time, realistic air drag, gravity drift, and sparkling embers
  - Balanced cadence: 1 elegant rocket every 2-3s (not too much, not too less)
  - 100% non-intrusive: pointer-events: none, zero obstruction to taps, swipes, cart & checkout
  - Vibrant heritage palette: Royal Imperial Gold, Warm Saffron, Himalayan Emerald, Ruby Rose, Champagne Spark
  - Visible & stunning on both light/cream backgrounds and dark theme sections
  - Full mobile & desktop support with battery-saving auto-pause
{% endcomment %}

<style>
  .ga-diwali-canvas {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    pointer-events: none !important;
    z-index: 99999;
    display: block;
  }

  @media (prefers-reduced-motion: reduce) {
    .ga-diwali-canvas {
      display: none !important;
    }
  }
</style>

<script>
(function() {
  'use strict';

  if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    return;
  }

  // Prevent duplicate instances
  if (document.querySelector('.ga-diwali-canvas')) {
    return;
  }

  const canvas = document.createElement('canvas');
  canvas.className = 'ga-diwali-canvas';
  canvas.setAttribute('aria-hidden', 'true');
  document.body.appendChild(canvas);

  const ctx = canvas.getContext('2d', { alpha: true });
  if (!ctx) {
    canvas.remove();
    return;
  }

  // Ghar Aangan Heritage Festive Palette (Vivid, rich tones visible on both white & dark backgrounds)
  const PALETTES = [
    {
      name: 'Imperial Gold & Amber',
      primary: '#f59e0b',
      accent: '#fbbf24',
      spark: '#fef3c7',
      colors: ['#f59e0b', '#d97706', '#fbbf24', '#fcd34d', '#fffbeb']
    },
    {
      name: 'Royal Saffron & Gold',
      primary: '#ea580c',
      accent: '#f97316',
      spark: '#ffedd5',
      colors: ['#ea580c', '#f97316', '#fb923c', '#fbbf24', '#ffffff']
    },
    {
      name: 'Himalayan Emerald & Gold',
      primary: '#059669',
      accent: '#10b981',
      spark: '#d1fae5',
      colors: ['#059669', '#10b981', '#34d399', '#f59e0b', '#ffffff']
    },
    {
      name: 'Festive Ruby & Rose Gold',
      primary: '#e11d48',
      accent: '#f43f5e',
      spark: '#ffe4e6',
      colors: ['#e11d48', '#f43f5e', '#fb7185', '#f59e0b', '#ffffff']
    },
    {
      name: 'Ghar Aangan Champagne Gold',
      primary: '#d4af37',
      accent: '#e6c875',
      spark: '#ffffff',
      colors: ['#d4af37', '#e6c875', '#f3e5ab', '#f59e0b', '#ffffff']
    }
  ];

  let width = 0;
  let height = 0;
  let dpr = 1;
  let animationId = 0;
  let lastTime = 0;
  let nextLaunchTime = 0;

  const rockets = [];
  const sparks = [];
  const trails = [];

  function resize() {
    dpr = Math.min(window.devicePixelRatio || 1, 1.5);
    width = window.innerWidth;
    height = window.innerHeight;
    canvas.width = Math.round(width * dpr);
    canvas.height = Math.round(height * dpr);
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  }

  function launchRocket() {
    // Keep total active particles capped to protect 60-120 FPS
    if (sparks.length > 70 || rockets.length >= 2) {
      return;
    }

    const isMobile = width < 768;
    let launchX;
    let targetY;

    if (isMobile) {
      // Mobile: launch nicely within middle 70% width, burst in upper 18% to 42%
      launchX = width * (0.15 + Math.random() * 0.70);
      targetY = height * (0.18 + Math.random() * 0.24);
    } else {
      // Desktop: launch in ambient sides or upper framing area so content is not blocked
      const side = Math.random();
      if (side < 0.42) {
        launchX = width * (0.08 + Math.random() * 0.28);
      } else if (side < 0.84) {
        launchX = width * (0.64 + Math.random() * 0.28);
      } else {
        launchX = width * (0.36 + Math.random() * 0.28);
      }
      targetY = height * (0.12 + Math.random() * 0.28);
    }

    const palette = PALETTES[Math.floor(Math.random() * PALETTES.length)];
    const startY = height + 10;
    const distance = startY - targetY;
    const duration = 0.85 + Math.random() * 0.35; // 0.85s to 1.2s ascent

    rockets.push({
      x: launchX,
      y: startY,
      startY: startY,
      targetY: targetY,
      distance: distance,
      duration: duration,
      elapsed: 0,
      palette: palette,
      trailTimer: 0
    });
  }

  function createExplosion(rocket) {
    const palette = rocket.palette;
    const isMobile = width < 768;
    // Mobile: 32-38 sparks | Desktop: 38-46 sparks (Feather-light budget, zero scroll lag)
    const count = isMobile ? (32 + Math.floor(Math.random() * 7)) : (38 + Math.floor(Math.random() * 9));
    const burstStyle = Math.random();

    for (let i = 0; i < count; i++) {
      const angle = (Math.PI * 2 * i) / count + (Math.random() - 0.5) * 0.2;
      let speed;
      let duration;
      let gravity;

      if (burstStyle < 0.45) {
        // Style A: Golden Willow / Shimmering Rain (gentle cascade downward)
        speed = 45 + Math.random() * 65;
        duration = 1.3 + Math.random() * 0.6;
        gravity = 38 + Math.random() * 20;
      } else {
        // Style B: Blooming Chrysanthemum (spherical flower with air friction)
        speed = 60 + Math.random() * 75;
        duration = 1.0 + Math.random() * 0.5;
        gravity = 30 + Math.random() * 18;
      }

      const color = palette.colors[Math.floor(Math.random() * palette.colors.length)];
      const size = 1.6 + Math.random() * 1.4;

      sparks.push({
        x: rocket.x,
        y: rocket.y,
        vx: Math.cos(angle) * speed,
        vy: Math.sin(angle) * speed,
        gravity: gravity,
        drag: 0.965,
        color: color,
        size: size,
        life: 0,
        duration: duration,
        twinklePhase: Math.random() * Math.PI * 2,
        twinkleSpeed: 8 + Math.random() * 10
      });
    }
  }

  function update(now) {
    if (document.hidden) {
      animationId = 0;
      return;
    }

    if (!lastTime) lastTime = now;
    const dt = Math.min((now - lastTime) / 1000, 0.04);
    lastTime = now;

    // Clear canvas
    ctx.clearRect(0, 0, width, height);

    // Launch cadence: 1 rocket every ~1.8s to 3.0s ("not too much not too less")
    if (now >= nextLaunchTime) {
      launchRocket();
      nextLaunchTime = now + 1800 + Math.random() * 1200;
    }

    // 1. UPDATE & DRAW TRAILS
    for (let i = trails.length - 1; i >= 0; i--) {
      const tr = trails[i];
      tr.life += dt;
      if (tr.life >= tr.duration) {
        trails.splice(i, 1);
        continue;
      }
      tr.y += tr.vy * dt;
      const alpha = (1 - (tr.life / tr.duration)) * 0.7;

      ctx.globalAlpha = alpha;
      ctx.fillStyle = tr.color;
      ctx.beginPath();
      ctx.arc(tr.x, tr.y, tr.size, 0, Math.PI * 2);
      ctx.fill();
    }

    // 2. UPDATE & DRAW ROCKETS
    for (let i = rockets.length - 1; i >= 0; i--) {
      const r = rockets[i];
      r.elapsed += dt;
      const progress = Math.min(r.elapsed / r.duration, 1);

      // Ease-out curve (slows naturally near peak)
      const ease = 1 - Math.pow(1 - progress, 2);
      r.y = r.startY - (r.distance * ease);

      // Rocket ascent sparkling trail
      r.trailTimer += dt;
      if (r.trailTimer >= 0.04) {
        r.trailTimer = 0;
        trails.push({
          x: r.x + (Math.random() - 0.5) * 3,
          y: r.y + 4,
          vy: 20 + Math.random() * 15,
          color: r.palette.accent,
          size: 1.2 + Math.random() * 1.0,
          life: 0,
          duration: 0.28 + Math.random() * 0.15
        });
      }

      // Draw rocket head (glowing bright head)
      ctx.globalAlpha = 0.35;
      ctx.fillStyle = r.palette.primary;
      ctx.beginPath();
      ctx.arc(r.x, r.y, 4, 0, Math.PI * 2);
      ctx.fill();

      ctx.globalAlpha = 0.95;
      ctx.fillStyle = '#fffbeb';
      ctx.beginPath();
      ctx.arc(r.x, r.y, 2, 0, Math.PI * 2);
      ctx.fill();

      if (progress >= 1) {
        createExplosion(r);
        rockets.splice(i, 1);
      }
    }

    // 3. UPDATE & DRAW SPARKS (Zero-blur dual-pass glow for 120 FPS buttery scrolling)
    for (let i = sparks.length - 1; i >= 0; i--) {
      const s = sparks[i];
      s.life += dt;

      if (s.life >= s.duration) {
        sparks.splice(i, 1);
        continue;
      }

      // Physics: drag + gravity
      s.vx *= Math.pow(s.drag, dt * 60);
      s.vy *= Math.pow(s.drag, dt * 60);
      s.vy += s.gravity * dt;
      s.x += s.vx * dt;
      s.y += s.vy * dt;

      const progress = s.life / s.duration;
      // Authentic Diwali ember twinkle
      const twinkle = 0.8 + 0.2 * Math.sin(s.twinklePhase + s.life * s.twinkleSpeed);
      const alpha = Math.max(0, (1 - progress) * twinkle);
      const currentSize = s.size * (1 - progress * 0.25);

      // Layer 1: Soft outer light aura
      ctx.globalAlpha = alpha * 0.30;
      ctx.fillStyle = s.color;
      ctx.beginPath();
      ctx.arc(s.x, s.y, currentSize * 2.2, 0, Math.PI * 2);
      ctx.fill();

      // Layer 2: Rich festive color body (vibrant on light & dark backgrounds)
      ctx.globalAlpha = alpha * 0.85;
      ctx.fillStyle = s.color;
      ctx.beginPath();
      ctx.arc(s.x, s.y, currentSize, 0, Math.PI * 2);
      ctx.fill();

      // Layer 3: Hot diamond sparkling core
      ctx.globalAlpha = alpha;
      ctx.fillStyle = '#fffdf0';
      ctx.beginPath();
      ctx.arc(s.x, s.y, currentSize * 0.4, 0, Math.PI * 2);
      ctx.fill();
    }

    ctx.globalAlpha = 1;
    animationId = window.requestAnimationFrame(update);
  }

  function start() {
    if (!animationId) {
      lastTime = 0;
      animationId = window.requestAnimationFrame(update);
    }
  }

  function stop() {
    if (animationId) {
      window.cancelAnimationFrame(animationId);
      animationId = 0;
      lastTime = 0;
      ctx.clearRect(0, 0, width, height);
    }
  }

  // Handle screen resize
  resize();
  window.addEventListener('resize', resize, { passive: true });

  // Conserve 100% battery when tab is hidden or backgrounded
  document.addEventListener('visibilitychange', function() {
    if (document.hidden) {
      stop();
    } else {
      start();
    }
  });

  // Start initial rocket gracefully after page preloader settles (700ms)
  setTimeout(function() {
    nextLaunchTime = performance.now() + 200;
    start();
  }, 700);

})();
</script>
