{% comment %}
  Ghar Aangan - Elegant Festive Diwali Fireworks & Sparkles
  Engineered for high conversion, zero lag, and luxury aesthetics.
  - Colors: Royal Gold, Amber, Saffron, Forest Emerald, and Sparkling White
  - Physics-based particle simulation with gravity, friction, and twinkling trails
  - Non-intrusive: 100% pointer-events: none (zero obstruction to checkout or clicks)
  - Auto-quiescence: Plays celebratory bursts on entry, then rests to conserve battery
  - Interactive: Subtle festive sparkles on user click / tap
{% endcomment %}

<div id="ga-diwali-fireworks-container" aria-hidden="true" style="position: fixed; inset: 0; pointer-events: none; z-index: 999999; overflow: hidden;">
  <canvas id="ga-diwali-canvas" style="display: block; width: 100vw; height: 100vh; pointer-events: none;"></canvas>

  <!-- Elegant Floating Festive Badge (Subtle Himalayan Luxury Style) -->
  <div id="ga-diwali-badge" style="
    position: fixed;
    bottom: 24px;
    left: 20px;
    pointer-events: auto;
    z-index: 999999;
    display: flex;
    align-items: center;
    gap: 8px;
    background: rgba(26, 51, 44, 0.92);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(205, 162, 80, 0.45);
    border-radius: 30px;
    padding: 7px 14px 7px 11px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15), 0 0 15px rgba(205, 162, 80, 0.2);
    color: #fff;
    font-family: var(--font-body-family, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.03em;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    user-select: none;
    -webkit-user-select: none;
  ">
    <span style="font-size: 15px; line-height: 1; filter: drop-shadow(0 0 4px #ffd700);">🪔</span>
    <span style="color: #ebd9b5; font-weight: 500;">Happy Diwali!</span>
    <span id="ga-diwali-btn-sparkle" style="
      background: linear-gradient(135deg, #cda250, #f59e0b);
      color: #1a332c;
      font-size: 10px;
      font-weight: 700;
      text-transform: uppercase;
      padding: 2px 7px;
      border-radius: 12px;
      margin-left: 2px;
      letter-spacing: 0.05em;
    ">Sparkle ✨</span>
    <button id="ga-diwali-close-btn" type="button" aria-label="Close Diwali Greeting" style="
      background: none;
      border: none;
      color: rgba(235, 217, 181, 0.6);
      font-size: 14px;
      cursor: pointer;
      padding: 0 2px 0 6px;
      line-height: 1;
      display: flex;
      align-items: center;
      transition: color 0.2s;
    " onmouseover="this.style.color='#fff'" onmouseout="this.style.color='rgba(235, 217, 181, 0.6)'">&times;</button>
  </div>
</div>

<script>
(function() {
  // Respect user preference for reduced motion
  if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    return;
  }

  const canvas = document.getElementById('ga-diwali-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  if (!ctx) return;

  let width = (canvas.width = window.innerWidth);
  let height = (canvas.height = window.innerHeight);

  window.addEventListener('resize', function() {
    width = canvas.width = window.innerWidth;
    height = canvas.height = window.innerHeight;
  });

  // Festive Himalayan Royal Color Palette
  const festiveColors = [
    '#ffd700', // Imperial Gold
    '#cda250', // Ghar Aangan Antique Gold
    '#f59e0b', // Deep Amber Marigold
    '#ea580c', // Himalayan Saffron
    '#10b981', // Pure Forest Emerald
    '#f43f5e', // Festive Rose
    '#ffffff', // Diamond White Spark
    '#fed7aa'  // Warm Glow
  ];

  const particles = [];
  let isRunning = true;
  let autoBurstCount = 0;
  const MAX_AUTO_BURSTS = 7; // Gentle festive greeting on arrival

  class Particle {
    constructor(x, y, color) {
      this.x = x;
      this.y = y;
      this.color = color || festiveColors[Math.floor(Math.random() * festiveColors.length)];
      
      const angle = Math.random() * Math.PI * 2;
      const speed = Math.random() * 5.5 + 1.5;
      
      this.vx = Math.cos(angle) * speed;
      this.vy = Math.sin(angle) * speed;
      
      this.friction = 0.955;
      this.gravity = 0.085;
      this.alpha = 1;
      this.decay = Math.random() * 0.016 + 0.012;
      this.radius = Math.random() * 2.2 + 1.2;
      this.sparkle = Math.random() > 0.4;
    }

    update() {
      this.vx *= this.friction;
      this.vy *= this.friction;
      this.vy += this.gravity;
      this.x += this.vx;
      this.y += this.vy;
      this.alpha -= this.decay;
    }

    draw(ctx) {
      if (this.alpha <= 0) return;
      ctx.save();
      ctx.globalAlpha = Math.max(0, this.alpha);
      ctx.beginPath();
      ctx.arc(this.x, this.y, this.radius, 0, Math.PI * 2);
      ctx.fillStyle = this.color;
      ctx.shadowBlur = this.sparkle ? 7 : 3;
      ctx.shadowColor = this.color;
      ctx.fill();
      ctx.restore();
    }
  }

  function createFirework(x, y, count) {
    const particleCount = count || Math.floor(Math.random() * 20 + 35);
    const chosenColor = festiveColors[Math.floor(Math.random() * festiveColors.length)];
    const secondaryColor = festiveColors[Math.floor(Math.random() * festiveColors.length)];

    for (let i = 0; i < particleCount; i++) {
      const color = Math.random() > 0.35 ? chosenColor : secondaryColor;
      particles.push(new Particle(x, y, color));
    }
  }

  function triggerRandomBurst() {
    // Burst in the upper-to-mid section of viewport for best visual aesthetics
    const x = width * (0.15 + Math.random() * 0.7);
    const y = height * (0.15 + Math.random() * 0.45);
    createFirework(x, y);
  }

  // Animation Loop with clearRect for crisp 60fps performance
  function loop() {
    if (!isRunning) return;

    ctx.clearRect(0, 0, width, height);

    for (let i = particles.length - 1; i >= 0; i--) {
      const p = particles[i];
      p.update();
      p.draw(ctx);
      if (p.alpha <= 0) {
        particles.splice(i, 1);
      }
    }

    requestAnimationFrame(loop);
  }

  requestAnimationFrame(loop);

  // Initial Orchestrated Celebratory Bursts (Timed elegantly)
  function scheduleInitialCelebration() {
    const burstTimers = [400, 1100, 1800, 2600, 3500, 4400];
    burstTimers.forEach(delay => {
      setTimeout(() => {
        if (!document.hidden && autoBurstCount < MAX_AUTO_BURSTS) {
          triggerRandomBurst();
          autoBurstCount++;
        }
      }, delay);
    });
  }

  // Run on page load
  if (document.readyState === 'complete') {
    scheduleInitialCelebration();
  } else {
    window.addEventListener('load', scheduleInitialCelebration);
  }

  // Interactive Touch & Click Sparkles (Clean & Responsive)
  document.addEventListener('click', function(e) {
    // Avoid triggering when user clicks functional inputs, buttons or cart controls
    const target = e.target;
    if (target.closest('button, a, input, select, textarea, form, [role="button"]')) {
      return;
    }
    // Launch a gentle cluster of festive sparkles at click location
    createFirework(e.clientX, e.clientY, 25);
  });

  // Badge Click Handler -> launches celebratory shower
  const badge = document.getElementById('ga-diwali-badge');
  const closeBtn = document.getElementById('ga-diwali-close-btn');

  if (badge) {
    badge.addEventListener('click', function(e) {
      if (e.target === closeBtn || e.target.closest('#ga-diwali-close-btn')) return;
      // Launch 3 festive bursts across the screen
      triggerRandomBurst();
      setTimeout(triggerRandomBurst, 200);
      setTimeout(triggerRandomBurst, 450);
    });
  }

  if (closeBtn) {
    closeBtn.addEventListener('click', function(e) {
      e.stopPropagation();
      if (badge) {
        badge.style.opacity = '0';
        badge.style.transform = 'translateY(15px)';
        setTimeout(() => badge.remove(), 300);
      }
    });
  }

  // Battery & CPU optimization: pause when tab is inactive
  document.addEventListener('visibilitychange', function() {
    if (document.hidden) {
      isRunning = false;
    } else {
      isRunning = true;
      requestAnimationFrame(loop);
    }
  });
})();
</script>
