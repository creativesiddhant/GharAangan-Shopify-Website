{% comment %}
  Ghar Aangan - Ultra-Lightweight Festive Diwali Celebration
  - 60-120 FPS butter-smooth performance on all Mobile and Desktop devices
  - Zero scroll lag: Zero shadowBlur, strict particle budgeting (<65 particles)
  - 100% pointer-events: none (zero obstruction to touches, scrolling, or checkout)
  - 2 graceful, luxury golden willow bursts that bloom once on entry, then vanish
{% endcomment %}

<canvas id="ga-diwali-canvas" style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; pointer-events: none; z-index: 9999998; display: block; will-change: transform; transform: translateZ(0);"></canvas>

<script>
(function() {
  if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    return;
  }

  const canvas = document.getElementById('ga-diwali-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d', { alpha: true });
  if (!ctx) return;

  // Use 1:1 pixel ratio for max mobile performance (eliminates lag & scroll stutter)
  let w = (canvas.width = window.innerWidth);
  let h = (canvas.height = window.innerHeight);

  window.addEventListener('resize', function() {
    w = canvas.width = window.innerWidth;
    h = canvas.height = window.innerHeight;
  }, { passive: true });

  // Luxury Festive Golden Palette (Ghar Aangan Heritage Gold & Warm Amber)
  const GOLD_PALETTE = ['#ffd700', '#f59e0b', '#cda250', '#ffffff', '#fed7aa'];

  const rockets = [];
  const sparks = [];
  let animId = null;

  class Rocket {
    constructor(startX, targetX, targetY, delay) {
      this.x = startX;
      this.y = h + 10;
      this.targetX = targetX;
      this.targetY = targetY;
      this.delay = delay;
      this.speed = 11;
      const angle = Math.atan2(targetY - this.y, targetX - this.x);
      this.vx = Math.cos(angle) * this.speed;
      this.vy = Math.sin(angle) * this.speed;
      this.alive = true;
      this.startTime = performance.now() + delay;
    }

    update(now) {
      if (now < this.startTime) return;
      this.x += this.vx;
      this.y += this.vy;
      if (this.y <= this.targetY) {
        this.explode();
      }
    }

    draw(ctx) {
      if (!this.alive) return;
      // Slender rising golden spark
      ctx.beginPath();
      ctx.arc(this.x, this.y, 2, 0, Math.PI * 2);
      ctx.fillStyle = '#ffffff';
      ctx.fill();

      ctx.beginPath();
      ctx.moveTo(this.x, this.y);
      ctx.lineTo(this.x - this.vx * 1.5, this.y - this.vy * 1.5);
      ctx.strokeStyle = 'rgba(255, 215, 0, 0.7)';
      ctx.lineWidth = 1.5;
      ctx.stroke();
    }

    explode() {
      this.alive = false;
      // Strict particle cap (30-35 sparks per burst = ~60 total across screen)
      const count = 32;
      for (let i = 0; i < count; i++) {
        const color = GOLD_PALETTE[i % GOLD_PALETTE.length];
        sparks.push(new Spark(this.x, this.y, color));
      }
    }
  }

  class Spark {
    constructor(x, y, color) {
      this.x = x;
      this.y = y;
      this.color = color;
      const angle = Math.random() * Math.PI * 2;
      const speed = Math.random() * 4.2 + 0.8;
      this.vx = Math.cos(angle) * speed;
      this.vy = Math.sin(angle) * speed;
      this.friction = 0.96;
      this.gravity = 0.07;
      this.alpha = 1;
      this.decay = Math.random() * 0.016 + 0.014; // ~1.8s life
      this.size = Math.random() * 1.6 + 1.1;
    }

    update() {
      this.vx *= this.friction;
      this.vy *= this.friction;
      this.vy += this.gravity;
      this.x += this.vx;
      this.y += this.vy;
      this.alpha -= this.decay;
    }

    draw(ctx) {
      if (this.alpha <= 0) return;
      ctx.globalAlpha = this.alpha;
      ctx.fillStyle = this.color;
      ctx.beginPath();
      ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
      ctx.fill();
    }
  }

  function startCelebration() {
    // 2 graceful, synchronized golden bursts across the upper sky
    // Burst 1: High Center Willow
    rockets.push(new Rocket(w * 0.45, w * 0.48, h * 0.22, 0));
    // Burst 2: Elegant Companion Burst on the right
    rockets.push(new Rocket(w * 0.65, w * 0.62, h * 0.27, 260));

    animId = requestAnimationFrame(render);
  }

  function render(timestamp) {
    ctx.clearRect(0, 0, w, h);

    // Update & draw rockets
    for (let i = 0; i < rockets.length; i++) {
      const r = rockets[i];
      if (r.alive) {
        r.update(timestamp);
        r.draw(ctx);
      }
    }

    // Update & draw sparks
    for (let i = sparks.length - 1; i >= 0; i--) {
      const s = sparks[i];
      s.update();
      s.draw(ctx);
      if (s.alpha <= 0) {
        sparks.splice(i, 1);
      }
    }

    // Done? Clean up completely
    const allRocketsDone = rockets.every(r => !r.alive);
    if (allRocketsDone && sparks.length === 0) {
      cleanup();
      return;
    }

    animId = requestAnimationFrame(render);
  }

  function cleanup() {
    if (animId) cancelAnimationFrame(animId);
    ctx.clearRect(0, 0, w, h);
    if (canvas && canvas.parentNode) {
      canvas.parentNode.removeChild(canvas);
    }
  }

  // Launch right after page preloader is complete (600ms)
  setTimeout(startCelebration, 600);
})();
</script>
