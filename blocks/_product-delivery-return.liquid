{%- liquid
  assign delivery_title = block.settings.page_delivery.title
  if delivery_title == blank
    assign delivery_title = 'Shipping, Delivery & Returns'
  endif
-%}
<button class="hdt-pr-popup__delivery hdt-s-text hdt-text-base hdt-font-semibold" aria-controls="modal-{{ block.id }}">
  <span class="hdt-product__extra-icon"><svg class="hdt-inline-block" xmlns="http://www.w3.org/2000/svg" width="22" height="18" viewBox="0 0 22 18" fill="currentColor"><path d="M21.7872 10.4724C21.7872 9.73685 21.5432 9.00864 21.1002 8.4217L18.7221 5.27043C18.2421 4.63481 17.4804 4.25532 16.684 4.25532H14.9787V2.54885C14.9787 1.14111 13.8334 0 12.4255 0H9.95745V1.69779H12.4255C12.8948 1.69779 13.2766 2.07962 13.2766 2.54885V14.5957H8.15145C7.80021 13.6052 6.85421 12.8936 5.74468 12.8936C4.63515 12.8936 3.68915 13.6052 3.33792 14.5957H2.55319C2.08396 14.5957 1.70213 14.2139 1.70213 13.7447V2.54885C1.70213 2.07962 2.08396 1.69779 2.55319 1.69779H9.95745V0H2.55319C1.14528 0 0 1.14111 0 2.54885V13.7447C0 15.1526 1.14528 16.2979 2.55319 16.2979H3.33792C3.68915 17.2884 4.63515 18 5.74468 18C6.85421 18 7.80021 17.2884 8.15145 16.2979H13.423C13.7742 17.2884 14.7202 18 15.8297 18C16.9393 18 17.8853 17.2884 18.2365 16.2979H21.7872V10.4724ZM16.684 5.95745C16.9494 5.95745 17.2034 6.08396 17.3634 6.29574L19.5166 9.14894H14.9787V5.95745H16.684ZM5.74468 16.2979C5.27545 16.2979 4.89362 15.916 4.89362 15.4468C4.89362 14.9776 5.27545 14.5957 5.74468 14.5957C6.21392 14.5957 6.59575 14.9776 6.59575 15.4468C6.59575 15.916 6.21392 16.2979 5.74468 16.2979ZM15.8298 16.2979C15.3606 16.2979 14.9787 15.916 14.9787 15.4468C14.9787 14.9776 15.3606 14.5957 15.8298 14.5957C16.299 14.5957 16.6809 14.9776 16.6809 15.4468C16.6809 15.916 16.299 16.2979 15.8298 16.2979ZM18.2366 14.5957C17.8853 13.6052 16.9393 12.8936 15.8298 12.8936C15.5398 12.8935 15.252 12.943 14.9787 13.04V10.8511H20.0851V14.5957H18.2366Z"></path></svg></span>
  {{ 'products.product.delivery_return' | t }}</button>
<hdt-modal effect="slide" color-scheme="{{ settings.color_scheme_dialog }}">
  <dialog id="modal-{{ block.id }}" class="hdt-dialog hdt-dialog-modal hdt-product__modal hdt-modal__size-chart" scroll-lock>
  <div class="hdt-dialog-modal__header"><h3 class="hdt-product__modal-title">{{ delivery_title }}</h3><button class="hdt-s-text" aria-controls="modal-{{ block.id }}" aria-label="{{ 'accessibility.close' | t | escape }}">{%- render 'icon' with 'close' -%}</button></div>
  <div class="hdt-dialog-modal__inner hdt-current-scrollbar hdt-rte">
    {%- if block.settings.page_delivery != blank and block.settings.page_delivery.content != blank -%}
      {{ block.settings.page_delivery.content }}
    {%- else -%}
      <div class="ga-delivery-modal-content" style="font-family: var(--ga-font-family-sans, 'Outfit', sans-serif); color: var(--ga-dark-text, #2d2d2d); line-height: 1.7; font-size: 1.45rem;">
        
        <div style="margin-bottom: 2.2rem; padding-bottom: 1.8rem; border-bottom: 1px solid rgba(26, 51, 44, 0.08);">
          <h4 style="font-family: var(--ga-font-family-serif, 'Playfair Display', serif); color: var(--ga-forest-green, #1a332c); font-size: 1.85rem; margin-top: 0; margin-bottom: 1rem; font-weight: 700;">🚚 Shipping, Dispatch &amp; Timelines</h4>
          <ul style="padding-left: 1.8rem; margin: 0;">
            <li style="margin-bottom: 0.7rem;"><strong>Order Processing:</strong> Shipment/pickup is generally initiated within <strong>24 hours</strong> of a successful order from our facilities in Uttarakhand.</li>
            <li style="margin-bottom: 0.7rem;"><strong>Delivery Timelines:</strong> Domestic deliveries are completed within <strong>3 to 7 days</strong> after pickup. Express priority delivery options may be available for selected metro &amp; Delhi/NCR prepaid orders.</li>
            <li style="margin-bottom: 0.7rem;"><strong>Cash on Delivery (COD):</strong> Yes, Cash on Delivery is available across India (₹100 fee applies for COD; prepaid orders enjoy FREE Express Shipping under active offers).</li>
            <li style="margin-bottom: 0.7rem;"><strong>Trusted Logistics:</strong> Dispatched via top carriers including <strong>Delhivery, Blue Dart, Ekart &amp; Amazon Shipping Surface</strong>.</li>
            <li><strong>Shipping Rates:</strong> Approx ₹100 per domestic delivery (free shipping available on selected promotions and order values).</li>
          </ul>
        </div>

        <div style="margin-bottom: 2.2rem; padding-bottom: 1.8rem; border-bottom: 1px solid rgba(26, 51, 44, 0.08);">
          <h4 style="font-family: var(--ga-font-family-serif, 'Playfair Display', serif); color: var(--ga-forest-green, #1a332c); font-size: 1.85rem; margin-top: 0; margin-bottom: 1rem; font-weight: 700;">📦 Glass &amp; Steel Protective Packaging</h4>
          <p style="margin: 0;">
            Our <strong>550 ml, 1 Litre, and 2 Litres</strong> ghee are packed in pure food-grade glass jars to retain authentic aroma and granularity. Our <strong>5 Litres</strong> family pack is packed in a traditional <strong>steel Dolchi</strong>. All shipments are secured with shock-absorbent protective packaging.
          </p>
        </div>

        <div style="margin-bottom: 2rem;">
          <h4 style="font-family: var(--ga-font-family-serif, 'Playfair Display', serif); color: var(--ga-forest-green, #1a332c); font-size: 1.85rem; margin-top: 0; margin-bottom: 1rem; font-weight: 700;">🔄 Transit Damage &amp; Refund Assurance</h4>
          <ul style="padding-left: 1.8rem; margin: 0;">
            <li style="margin-bottom: 0.7rem;"><strong>Pure Food Safety:</strong> As our products are edible pure food items, we cannot accept physical returns of opened or tasted jars.</li>
            <li style="margin-bottom: 0.7rem;"><strong>100% Transit Damage Guarantee:</strong> If a glass jar arrives cracked or damaged in transit, do not consume it. Share clear unboxing photos/videos of the jar, outer box, and shipping label immediately upon delivery for a free replacement.</li>
            <li><strong>Customer Support:</strong> Call/WhatsApp <strong>+91 90272 48335</strong> / <strong>+91 72920 02260</strong> or email <a href="mailto:gharaanganmani@gmail.com" style="color: var(--ga-forest-green, #1a332c); font-weight: 700; text-decoration: underline;">gharaanganmani@gmail.com</a>.</li>
          </ul>
        </div>

      </div>
    {%- endif -%}
  </div>
  </dialog>
</hdt-modal>
{% schema %}
{
  "name": "Delivery & Return",
  "tag": null,
  "settings": [
    {
      "type": "page",
      "id": "page_delivery",
      "label": "t:sections.main-product.blocks.extra_link.settings.page_delivery.label",
      "info": "t:sections.main-product.blocks.extra_link.settings.page_delivery.info"
    }
  ],
  "presets": [
    { "name": "Delivery & Return" 
    }
  ]
}
{% endschema %}
