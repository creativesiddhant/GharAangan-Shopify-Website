{%-liquid
  unless product
    assign product = section.settings.product
  endunless
  if product == null
    assign product = null | default: title: "Example product title", price: 1999, compare_at_price: 2500, available: true, vendor: "Ecomus"
  endif
  assign product_form_id = 'product-form-' | append: section.id | append: product.id 
  assign effect = ''
  if section.id contains 'slideshow'
    assign effect = 'reval'
  endif  

  assign un_no_pick = true
  if settings.pick_mode == 'no' and product.variants.size > 1
    assign selected_variant = product.selected_variant
    unless selected_variant
      assign un_no_pick = false
    endunless
  endif
-%}
<div {{ effect }} class="hdt-product-info__item hdt-product__price" data-type="{{ block.type }}" {{ block.shopify_attributes }}>
  {%- render 'price', product: product, use_variant: true, form_id: product_form_id, show_badges: true, only_show_sale: true, show_volume_note: false, un_no_pick: un_no_pick -%}
  
  {%- liquid
    assign is_ghee_product = false
    if product.handle contains 'a2-desi-pahadi-ghee' or product.handle == 'a2-desi-pahadi-ghee-1l' or product.handle == 'a2-desi-pahadi-ghee-2l' or product.handle == 'a2-desi-pahadi-ghee-550ml' or product.handle == 'a2-desi-pahadi-ghee-5l' or product.tags contains 'free-shipping' or product.tags contains 'Janmashtami'
      assign is_ghee_product = true
    endif
    assign is_bulk_prepaid_only = false
    if product.handle contains '2l' or product.handle contains '5l'
      assign is_bulk_prepaid_only = true
    endif
  -%}
  {%- if is_ghee_product -%}
    <div class="ga-janmashtami-banner">
      <div class="ga-janmashtami-banner__inner">
        <div class="ga-janmashtami-banner__badge">
          <span class="ga-janmashtami-banner__diya">🪔</span>
          <span class="ga-janmashtami-banner__tag">JANMASHTAMI MAHOTSAV OFFER</span>
        </div>
        <div class="ga-janmashtami-banner__headline">
          <span class="ga-janmashtami-main-msg"><strong>FREE Express Shipping</strong> on Prepaid Orders</span>
          {%- if is_bulk_prepaid_only -%}
            <span class="ga-cod-note ga-prepaid-note" style="color:#15803d !important; background:#f0fdf4 !important; border-color:#bbf7d0 !important;">Prepaid Only</span>
          {%- else -%}
            <span class="ga-cod-note">₹100 for COD Orders</span>
          {%- endif -%}
        </div>
        <div class="ga-janmashtami-banner__perks">
          <span class="ga-janmashtami-perk-item">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
            FREE Express Delivery on Prepaid Orders
          </span>
          {%- if is_bulk_prepaid_only -%}
            <span class="ga-janmashtami-perk-item" style="color: #15803d !important;">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              Strictly Prepaid Only (No COD for Bulk Packs)
            </span>
          {%- else -%}
            <span class="ga-janmashtami-perk-item">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              ₹100 Applied on COD Orders
            </span>
          {%- endif -%}
          <span class="ga-janmashtami-perk-item">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
            100% Pure Himalayan Bilona Ghee | Tested A2
          </span>
        </div>
      </div>
    </div>
  {%- endif -%}
</div>
{% schema %}
{
  "name": "t:sections.main-product.blocks.price.name",
  "tag": null,
  "settings": [
  ],
  "presets": [
    { 
      "name": "t:sections.main-product.blocks.price.name" ,
    }
  ]
}
{% endschema %}