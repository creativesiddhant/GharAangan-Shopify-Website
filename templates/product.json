    "ghar_aangan_faq": {
      "type": "ghar-aangan-faq",
      "blocks": {
        "faq_1": {
          "type": "faq",
          "settings": {
            "question": "What is Bilona ghee?",
            "answer": "<p>Traditional Bilona ghee is prepared by culturing boiled whole milk into curd, churning the curd back-and-forth using a wooden whisk in earthen vessels to extract cultured butter (makhan), and simmering that butter slowly over firewood to yield pure golden danedar ghee.</p>"
          }
        },
        "faq_2": {
          "type": "faq",
          "settings": {
            "question": "How is Ghar Aangan ghee prepared?",
            "answer": "<p>We adhere strictly to the Vedic 5-step Bilona method: fresh A2 milk from free-grazing Badri cows is boiled over firewood Chulhas, cultured into curd in clay pots, churned with wooden bilonas, and clarified slowly over gentle flame. We never use industrial cream separators or machine heating.</p>"
          }
        },
        "faq_3": {
          "type": "faq",
          "settings": {
            "question": "Where is it made?",
            "answer": "<p>Ghar Aangan ghee is handcrafted and packed directly in Uttarakhand, India, working in close collaboration with small local mountain farming communities and women's self-help collectives.</p>"
          }
        },
        "faq_4": {
          "type": "faq",
          "settings": {
            "question": "What are the ingredients?",
            "answer": "<p>100% Pure Badri Cow Milk Fat. There are absolutely no additives, preservatives, colors, artificial fragrances, or vegetable oils.</p>"
          }
        },
        "faq_5": {
          "type": "faq",
          "settings": {
            "question": "How should it be stored?",
            "answer": "<p>Store it in its original glass jar at normal room temperature in a dry, dark kitchen pantry. Always use a clean, dry spoon. Do not refrigerate, as cold temperatures harden the ghee and diminish its natural danedar grain.</p>"
          }
        },
        "faq_6": {
          "type": "faq",
          "settings": {
            "question": "What is the shelf life?",
            "answer": "<p>Pure wood-fired Bilona ghee with low moisture (0.12%) naturally stays fresh for 12 to 18 months from manufacturing date when stored at room temperature away from direct moisture.</p>"
          }
        },
        "faq_7": {
          "type": "faq",
          "settings": {
            "question": "Is COD (Cash on Delivery) available?",
            "answer": "<p>Yes, Cash on Delivery is available across most serviceable pin codes across India.</p>"
          }
        },
        "faq_8": {
          "type": "faq",
          "settings": {
            "question": "What is the COD charge?",
            "answer": "<p>A flat fee of ₹100 is applied on Cash on Delivery orders to cover courier cash-handling costs. Prepaid orders (UPI, Cards, Netbanking) enjoy 100% FREE Express Delivery.</p>"
          }
        },
        "faq_9": {
          "type": "faq",
          "settings": {
            "question": "Is delivery available to my pincode?",
            "answer": "<p>We ship Pan-India via Delhivery, Blue Dart, DTDC, and XpressBees. You can verify your exact 6-digit pin code right above on this page using our instant Pincode Checker.</p>"
          }
        },
        "faq_10": {
          "type": "faq",
          "settings": {
            "question": "What happens if the parcel arrives damaged?",
            "answer": "<p>We pack every glass jar securely with multi-layer protective packaging. In the rare event of transit damage, we offer a 100% free immediate replacement when you share an unboxing photo/video within 48 hours to our support team at +91 90272 48335 or gharaanganmani@gmail.com.</p>"
          }
        }
      },
