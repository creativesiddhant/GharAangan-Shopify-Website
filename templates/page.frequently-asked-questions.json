        "faq-gud": {
          "type": "accordion_item",
          "settings": {
            "title": "How is your Pahadi Gud (Jaggery) prepared?",
            "content": "Our traditional Pahadi Gud is prepared by slow wood-fired boiling of fresh sugarcane juice. It is unrefined, completely chemical-free, and blended with native mountain herbs, seeds, and premium dry fruits like Kaju, Badam, Kismis, and Saunf to create nutrient-rich varieties.",
            "content_richtext": ""
          }
        },
        "faq-salts": {
          "type": "accordion_item",
          "settings": {
            "title": "What is Pisyu Loon and how is it made?",
            "content": "Pisyu Loon refers to traditional Himalayan flavored salts. We hand-crust rock salt on traditional stone slabs (Sil-Batta) along with native mountain herbs, seeds, and spices like hemp (Bhaang) and red chilis to add a smoky, tangy flavor to your foods.",
            "content_richtext": ""
          }
        },
        "faq-flour": {
          "type": "accordion_item",
          "settings": {
            "title": "Is Mandua Ka Aata (Ragi) gluten-free?",
            "content": "Yes, our Pahadi Mandua Ka Aata (Ragi / Finger Millet Flour) is naturally gluten-free. It is slowly stone-ground to keep its vital nutrients intact, making it exceptionally high in calcium, iron, and dietary fiber.",
            "content_richtext": ""
          }
        },
        "faq-dals": {
          "type": "accordion_item",
          "settings": {
            "title": "Are your dals and pulses polished?",
            "content": "No, all our pulses (including Premium Rajma, Bhatt Ki Dal/Black Soyabean, Gauhat/Kulthi, and Lobia) are mountain-grown, completely unpolished, and cultivated in chemical-free soil, preserving their plant-based proteins and natural dietary fibers.",
            "content_richtext": ""
          }
        },
